// Test: Direct recursion with zero-page parameter
// Expected: ERROR - unsafe recursion detected

#[zeropage(0x20)]
static mut N: u8;

#[mode(m8, x8)]
fn factorial(n @ N: u8) -> u8 {
    if n <= 1 {
        return 1;
    }
    let result: u8 = factorial(n - 1);  // ERROR: Recursive call with zero-page param
    return mul(n, result);
}

#[entry]
#[mode(m8, x8)]
fn main() -> ! {
    let result @ A = factorial(5);
    loop {}
}
