// Basic pattern matching test

enum State {
    Idle = 0,
    Running = 1,
    Jumping = 2,
}

#[mode(m8, x8)]
fn get_speed(state @ A: u8) -> u8 {
    let result @ A = match state {
        0 => 0,        // Idle: no movement
        1 => 5,        // Running: speed 5
        2 => 3,        // Jumping: speed 3
        _ => 0,        // Default: no movement
    };
    return result;
}

#[entry]
#[mode(m8, x8)]
fn main() -> ! {
    let speed @ A = get_speed(1);  // Should return 5
    loop {}
}
