// Test: Explicit scratch register allocation
// Programmer defines scratch registers explicitly

// Scratch registers for compiler use
#[zeropage(0x10, register)]
static mut SCRATCH0: u8;

#[zeropage(0x11, register)]
static mut SCRATCH1: u8;

#[zeropage(0x12, register)]
static mut SCRATCH2: u16;  // 2-byte scratch

// Regular user variable (not a scratch register)
#[zeropage(0x20)]
static mut TEMP: u8;

#[mode(m8, x8)]
fn complex_calculation(a: u8, b: u8) -> u8 {
    let x: u8 = a + b;
    let y: u8 = x + x;  // Avoid * operator
    let z: u8 = y + 1;
    return z;
}

#[entry]
#[mode(m8, x8)]
fn main() -> ! {
    TEMP = complex_calculation(5, 10);
    loop {}
}
