// Test default stack region ($0100-$01FF)
// No explicit #[stack] attribute - should use default

// Lowram variable should be allocated AFTER stack region
#[lowram]
static mut BUFFER: [u8; 128];

#[zeropage]
static mut COUNTER: u8;

#[mode(m8, x8)]
#[entry]
fn main() -> ! {
    COUNTER = 0;
    BUFFER[0] = 1;
    loop {}
}
