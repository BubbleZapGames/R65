// Jump table optimization test - large dense match

#[mode(m8, x8)]
fn map_value(input @ A: u8) -> u8 {
    let result @ A = match input {
        0 => 10,
        1 => 20,
        2 => 30,
        3 => 40,
        4 => 50,
        5 => 60,
        6 => 70,
        7 => 80,
        _ => 0,
    };
    return result;
}

#[entry]
#[mode(m8, x8)]
fn main() -> ! {
    let val @ A = map_value(3);  // Should return 40
    loop {}
}
