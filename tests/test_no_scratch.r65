// Test: No scratch registers defined
// Should still compile but use only stack

#[zeropage(0x20)]
static mut TEMP: u8;

#[mode(m8, x8)]
fn add_numbers(a: u8, b: u8) -> u8 {
    let x: u8 = a + b;
    return x;
}

#[entry]
#[mode(m8, x8)]
fn main() -> ! {
    TEMP = add_numbers(5, 10);
    loop {}
}
