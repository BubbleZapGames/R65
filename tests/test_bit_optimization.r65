// BIT instruction optimization test

#[hw(0x4212)]
static mut HVBJOY: u8;  // SNES hardware register

#[zeropage]
static mut FLAGS: u8 = 0;

// Test 1: Bit 7 testing (sign bit)
#[mode(m8, x8)]
fn test_bit7(value @ A: u8) -> u8 {
    // This should use BIT + BMI instead of LDA + AND + BEQ
    if value & 0x80 != 0 {
        return 1;
    }
    return 0;
}

// Test 2: Bit 6 testing (overflow bit)
#[mode(m8, x8)]
fn test_bit6(value @ A: u8) -> u8 {
    // This should use BIT + BVS instead of LDA + AND + BEQ
    if value & 0x40 != 0 {
        return 1;
    }
    return 0;
}

// Test 3: Hardware register polling (most common use case)
#[mode(m8, x8)]
fn wait_vblank() {
    // This should use BIT + BPL loop instead of LDA + AND + BEQ loop
    // Huge performance improvement for tight polling loops!
    while HVBJOY & 0x80 == 0 {
        // Wait for V-blank (bit 7 set)
    }
}

// Test 4: Inverted test (bit clear)
#[mode(m8, x8)]
fn test_bit7_clear(value @ A: u8) -> u8 {
    // This should use BIT + BPL instead of LDA + AND + BNE
    if value & 0x80 == 0 {
        return 1;
    }
    return 0;
}

// Test 5: Flag testing
#[mode(m8, x8)]
fn check_flag() -> u8 {
    if FLAGS & 0x80 != 0 {
        return 100;
    }
    return 0;
}

#[entry]
#[mode(m8, x8)]
fn main() -> ! {
    let result @ A = test_bit7(0xFF);
    wait_vblank();
    loop {}
}
