// Test pointer functionality (near/far pointers)

// Test variables
#[zeropage(0x20)]
static mut VALUE: u8 = 0x42;

#[zeropage(0x22)]
static mut PTR: near<u8>;

#[mode(m8, x8)]
fn test_addressof() {
    // Test address-of operator
    PTR = &VALUE;
}

#[mode(m8, x8)]
fn test_dereference_load() {
    // Test dereferencing a pointer to load value
    let result @ A = *PTR;
}

#[mode(m8, x8)]
fn test_dereference_store() {
    // Test dereferencing a pointer to store value
    *PTR = 0x99;
}

#[entry]
#[mode(m8, x8)]
fn main() -> ! {
    test_addressof();
    test_dereference_load();
    test_dereference_store();

    loop {
        // Infinite loop
    }
}
