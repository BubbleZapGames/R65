// Test arrays of function pointers

#[mode(m8, x8)]
fn add_ten(value @ A: u8) -> u8 {
    A = A + 10;
    return A;
}

#[mode(m8, x8)]
fn add_twenty(value @ A: u8) -> u8 {
    A = A + 20;
    return A;
}

#[mode(m8, x8)]
fn add_thirty(value @ A: u8) -> u8 {
    A = A + 30;
    return A;
}

// Array of function pointers
type MathFunc = fn(u8) -> u8;

#[ram]
static mut HANDLERS: [MathFunc; 3];

#[mode(m8, x8)]
fn test_array_of_function_pointers() {
    // Initialize array with function pointers
    HANDLERS[0] = add_ten;
    HANDLERS[1] = add_twenty;
    HANDLERS[2] = add_thirty;

    // Call through array element
    let func: MathFunc = HANDLERS[1];
    let result @ A = func(5);  // Should call add_twenty, return 25
}

#[entry]
#[mode(m8, x8)]
fn main() -> ! {
    test_array_of_function_pointers();

    loop {
        // Infinite loop
    }
}
