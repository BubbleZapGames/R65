// Test: Direct recursion with register parameter
// Expected: ERROR - unsafe recursion detected

#[mode(m8, x8)]
fn factorial(n @ A: u8) -> u8 {
    if n <= 1 {
        return 1;
    }
    let result: u8 = factorial(n - 1);  // ERROR: Recursive call with register param
    return mul(n, result);
}

#[entry]
#[mode(m8, x8)]
fn main() -> ! {
    let result @ A = factorial(5);
    loop {}
}
