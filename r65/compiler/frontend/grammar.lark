// R65 Grammar for Lark Parser
// Complete grammar for both lexing and parsing

// ============================================================================
// Parser Rules (lowercase names)
// ============================================================================

// Starting rule - a source file is a list of items
start: item*

// Top-level items
?item: function_decl
     | static_decl
     | const_decl
     | struct_decl
     | enum_decl
     | impl_decl
     | trait_decl
     | type_alias
     | include_stmt
     | stack_directive
     | bank_directive
     | snesrom_directive
     | macro_decl
     | macro_invocation_stmt
     | _reserved_keyword  // Dummy rule to make reserved keywords valid tokens

// Stack directive - global attribute for stack region
// Uses STACK_KEYWORD to distinguish from regular attributes
stack_directive: "#" "[" STACK_KEYWORD "(" INTEGER "," INTEGER ")" "]"
STACK_KEYWORD.20: /stack(?=\()/

// Bank directive - sets current ROM bank for following declarations
// #[bank(0)] for explicit bank, #[bank(auto)] for automatic placement
// Uses BANK_KEYWORD to distinguish from regular attributes
bank_directive: "#" "[" BANK_KEYWORD "(" (INTEGER | AUTO_KEYWORD) ")" "]"
BANK_KEYWORD.20: /bank(?=\()/
AUTO_KEYWORD.20: /auto(?=\))/

// SNES ROM header directive - configures .SNESHEADER output
// #[snesrom(name="ROM NAME", id="SNES", lorom, fastrom, ...)]
// Uses SNESROM_KEYWORD to distinguish from regular attributes
snesrom_directive: "#" "[" SNESROM_KEYWORD "(" snesrom_arg ("," snesrom_arg)* ","? ")" "]"
SNESROM_KEYWORD.20: /snesrom(?=\()/
snesrom_arg: IDENT "=" (STRING | INTEGER)  -> snesrom_named_arg
           | IDENT                          -> snesrom_flag_arg

// Dummy rule to tell Lark that these terminals are valid (never actually matched in valid code)
_reserved_keyword: KEYWORD

// Function declaration (function_body allows trailing expression for implicit returns)
function_decl: attribute* CONST? FAR? FN IDENT "(" param_list? ")" return_type? function_body

// Function body: block with optional trailing expression (Rust-style implicit returns)
function_body: "{" statement* "}"
             | "{" statement* expr "}"  -> function_body_trailing

param_list: param ("," param)* ","?
// Supports pointer parameters: [far|near] *name: type
param: (FAR | NEAR)? STAR? IDENT ("@" binding)? ":" type_expr
     | (FAR | NEAR)? AMPER IDENT ("@" binding)? ":" type_expr  -> param_safe_ptr_error

binding: REGISTER | IDENT

return_type: "->" (type_tuple | type_expr | "!")

// Static variable declaration
// Uses initializer_expr to allow struct literals after =
// Supports pointer declarations and far modifier: [far|near] static mut *name: type
// Note: var_name allows REGISTER tokens as variable names (e.g., static mut X: u8)
static_decl: attribute* (FAR | NEAR)? STATIC MUT? STAR? var_name ":" type_expr ("=" initializer_expr)? ";"
           | attribute* (FAR | NEAR)? STATIC MUT? AMPER var_name ":" type_expr ("=" initializer_expr)? ";"  -> static_decl_safe_ptr_error

// Variable name - can be IDENT or REGISTER (allows naming variables X, Y, A, etc.)
var_name: IDENT | REGISTER

// Const declaration
const_decl: CONST IDENT ":" type_expr "=" initializer_expr ";"

// Struct declaration
struct_decl: STRUCT IDENT "{" struct_field* "}"
// Supports pointer fields: [far|near] *name: type
struct_field: (FAR | NEAR)? STAR? IDENT ":" type_expr ","?
            | (FAR | NEAR)? AMPER IDENT ":" type_expr ","?  -> struct_field_safe_ptr_error

// Enum declaration
enum_decl: ENUM IDENT "{" enum_variant ("," enum_variant)* ","? "}"
enum_variant: var_name ("=" expr)?

// Trait declaration
trait_decl: TRAIT IDENT "{" trait_item* "}"
?trait_item: trait_method | trait_const
trait_method: FAR? FN IDENT "(" trait_param_list ")" return_type? ";"
trait_param_list: self_param ("," param)* ","?
trait_const: CONST IDENT ":" type_expr ";"

// Impl block declaration
// impl StructName { ... } for near *self
// impl far StructName { ... } for far *self
// impl TraitName for StructName { ... } for trait implementation
impl_decl: IMPL FAR? IDENT "{" impl_item* "}"
          | IMPL IDENT FOR IDENT "{" impl_item* "}"  -> impl_trait_decl

?impl_item: impl_method
          | impl_const

// Method declaration in impl block
// fn name(*self, ...) or fn name(far *self, ...) for explicit far self
impl_method: attribute* CONST? FAR? FN IDENT "(" impl_param_list? ")" return_type? function_body

// Parameters for impl methods - self parameter comes first
impl_param_list: self_param ("," param)* ","?
               | param_list

// Self parameter: *self, far *self, or near *self
self_param: (FAR | NEAR)? STAR SELF

// Associated constant in impl block
impl_const: CONST IDENT ":" type_expr "=" expr ";"

// Type alias
type_alias: TYPE IDENT "=" type_expr ";"

// Include statement
include_stmt: INCLUDE "!" "(" STRING ")"

// Macro definition
// macro_rules! name($param:fragment, ...) { body }
macro_decl: MACRO_RULES "!" IDENT "(" macro_params? ")" macro_body

macro_params: macro_param ("," macro_param)* ","?

// Simple parameter: $name:fragment
// Repeated parameter: $($name:fragment),*
macro_param: MACRO_VAR ":" FRAGMENT_TYPE                              -> macro_param_simple
           | DOLLAR "(" MACRO_VAR ":" FRAGMENT_TYPE ")" "," "*"       -> macro_param_repeated

// Macro body is captured as raw tokens between braces
// We use a special rule to capture everything including nested braces
macro_body: "{" macro_body_content* "}"

// Content inside macro body - can be any token or nested braces
?macro_body_content: macro_body              // Nested braces
                   | MACRO_VAR               // $param references
                   | macro_repetition        // $(...)*
                   | macro_token             // Any other token

// Repetition in macro body: $( content ),*
macro_repetition: DOLLAR "(" macro_body_content+ ")" "," "*"    -> macro_rep_comma
                | DOLLAR "(" macro_body_content+ ")" "*"         -> macro_rep_no_sep

// Any token that can appear in a macro body (excluding special macro syntax)
macro_token: IDENT | REGISTER | TYPE_NAME | INTEGER | STRING | BOOLEAN
           | KEYWORD | INCLUDE | INCLUDE_BYTES | CONST | STATIC | LET | MUT | MACRO_RULES
           | FN | FAR | NEAR | IF | ELSE | LOOP | WHILE | MATCH | RETURN
           | BREAK | CONTINUE | ASM | STRUCT | ENUM | TYPE | AS | TRAIT | IMPL | SELF | FOR | IN | DYN
           | CFG | CFG_NOT
           | "(" | ")" | "[" | "]" | ";" | ":" | "," | "." | "#"
           | "+" | "-" | "*" | "/" | "&" | "|" | "^" | "~" | "!"
           | "=" | "<" | ">" | "@" | "->" | "==" | "!=" | "<=" | ">="
           | "&&" | "||" | "<<" | ">>" | "++" | "--"
           | "+=" | "-=" | "*=" | "/=" | "&=" | "|=" | "^=" | "<<=" | ">>="
           | "::"

// Top-level macro invocation: name!(args);
macro_invocation_stmt: IDENT "!" "(" macro_args? ")" ";"

// Statement-level macro invocation (inside function bodies)
macro_invocation_stmt_inner: IDENT "!" "(" macro_args? ")" ";"

// Macro arguments - comma-separated token trees
macro_args: macro_arg ("," macro_arg)* ","?

// A single macro argument - balanced tokens
macro_arg: macro_arg_token+

macro_arg_token: IDENT | REGISTER | TYPE_NAME | INTEGER | STRING | BOOLEAN
               | KEYWORD | MACRO_VAR | INCLUDE | INCLUDE_BYTES | CONST | STATIC | LET | MUT | MACRO_RULES
               | FN | FAR | NEAR | IF | ELSE | LOOP | WHILE | MATCH | RETURN
               | BREAK | CONTINUE | ASM | STRUCT | ENUM | TYPE | AS | TRAIT | IMPL | SELF | FOR | IN | DYN
               | CFG | CFG_NOT
               | "(" macro_arg_token* ")"    // Nested parens
               | "[" macro_arg_token* "]"    // Nested brackets
               | "{" macro_arg_token* "}"    // Nested braces
               | "+" | "-" | "*" | "/" | "&" | "|" | "^" | "~" | "!"
               | "=" | "<" | ">" | "@" | "->" | "==" | "!=" | "<=" | ">="
               | "&&" | "||" | "<<" | ">>" | "++" | "--" | ";" | ":" | "." | "#"
               | "+=" | "-=" | "*=" | "/=" | "&=" | "|=" | "^=" | "<<=" | ">>="
               | "::"

// Attributes
attribute: "#" "[" attribute_inner "]"
attribute_inner: CFG "(" cfg_condition ")"            -> cfg_attribute
             | attr_name ("(" attribute_args? ")")?
// Note: "snesrom", "stack", "bank" are NOT included here - they're standalone directives, not attributes
attr_name: IDENT

attribute_args: attribute_arg ("," attribute_arg)* ","?
attribute_arg: IDENT "=" expr      -> named_arg
             | expr                -> positional_arg

// cfg condition grammar
cfg_condition: cfg_any

cfg_any: cfg_all ("||" cfg_all)*

cfg_all: cfg_primary ("&&" cfg_primary)*

?cfg_primary: cfg_identifier
            | "!" cfg_primary                    -> cfg_not
            | CFG_NOT cfg_primary                -> cfg_not
            | cfg_comparison
            | "(" cfg_condition ")"

cfg_identifier: IDENT

cfg_comparison: IDENT "=" STRING                 -> cfg_eq
               | IDENT "!=" STRING               -> cfg_ne

// Block
block: "{" statement* "}"

// Statements
?statement: let_stmt
          | tuple_assign_stmt
          | expr_stmt
          | return_stmt
          | break_stmt
          | continue_stmt
          | if_stmt
          | loop_stmt
          | while_stmt
          | for_stmt
          | block
          | asm_stmt
          | increment_stmt
          | decrement_stmt
          | macro_invocation_stmt_inner

// Tuple assignment statement: a, b = tuple_expr;
// No parentheses needed - comma separates targets
// Uses tuple_target which only allows identifiers and registers
tuple_assign_stmt: tuple_target "," tuple_target ("," tuple_target)* "=" expr ";"
tuple_target: IDENT    -> tuple_target_ident
            | REGISTER -> tuple_target_register

// Uses initializer_expr to allow struct literals after =
// Supports both single binding and tuple destructuring:
//   let x = expr;
//   let (a, b) = tuple_expr;
// Supports pointer declarations: let [far|near] [mut] *name: type = expr
let_stmt: LET (FAR | NEAR)? MUT? (tuple_pattern | pointer_pattern | single_pattern) (":" type_expr)? ("=" initializer_expr)? ";"
        | LET (FAR | NEAR)? MUT? safe_ptr_pattern (":" type_expr)? ("=" initializer_expr)? ";"  -> let_stmt_safe_ptr_error
single_pattern: IDENT ("@" binding)?
pointer_pattern: STAR IDENT ("@" binding)?
safe_ptr_pattern: AMPER IDENT ("@" binding)?
tuple_pattern: "(" IDENT ("," IDENT)* ")"
expr_stmt: expr ";"
// Return statement - single value or tuple: return; | return x; | return a, b;
return_stmt: RETURN (return_tuple | expr)?  ";"
return_tuple: expr ("," expr)+
break_stmt: BREAK LABEL_REF? ";"
          | BREAK LABEL_REF? expr ";"
continue_stmt: CONTINUE LABEL_REF? ";"
increment_stmt: lvalue PLUSPLUS ";"
decrement_stmt: lvalue MINUSMINUS ";"

if_stmt: IF expr block (ELSE else_clause)?
else_clause: if_stmt | block

// Note: identical to loop_expr but produces a different tree node;
// loop_stmt is a statement, loop_expr is an initializer (see initializer_expr)
loop_stmt: LABEL_DEF? LOOP block
while_stmt: LABEL_DEF? WHILE expr block
for_stmt: LABEL_DEF? FOR IDENT IN expr (DOTDOT | DOTDOTEQ) expr block

asm_stmt: ASM "!" "(" STRING ("," asm_arg)* ")" ";"
asm_arg: STRING | asm_named_arg
asm_named_arg: IDENT "=" asm_value
asm_value: expr

// Match expression
match_expr: MATCH expr "{" match_arm ("," match_arm)* ","? "}"
match_arm: pattern "=>" expr

// Patterns
?pattern: pattern_or

pattern_or: pattern_primary ("|" pattern_primary)*

?pattern_primary: pattern_range
                | pattern_literal
                | pattern_enum
                | pattern_wildcard
                | pattern_ident

pattern_range: INTEGER DOTDOTEQ INTEGER
             | INTEGER DOTDOT INTEGER

pattern_literal: INTEGER | BOOLEAN
pattern_enum: IDENT "::" IDENT
pattern_wildcard: "_"
pattern_ident: IDENT

// Expressions (precedence from low to high)
?expr: assignment

?assignment: logical_or
           | lvalue "=" assignment                          -> assign
           | lvalue compound_op assignment                  -> compound_assign

compound_op: PLUSEQUAL | MINUSEQUAL | STAREQUAL | SLASHEQUAL
           | AMPEREQUAL | VBAREQUAL | CIRCUMFLEXEQUAL
           | LSHIFTEQUAL | RSHIFTEQUAL

// Lvalue (left-hand side of assignment)
lvalue: IDENT                                   -> lvalue_ident
      | REGISTER                                -> lvalue_register
      | postfix "[" expr "]"                    -> lvalue_array
      | postfix "." IDENT                       -> lvalue_field
      | "*" unary                               -> lvalue_deref

?logical_or: logical_and
           | logical_or "||" logical_and        -> or_expr

?logical_and: equality
            | logical_and "&&" equality         -> and_expr

?equality: comparison
         | equality "==" comparison             -> eq
         | equality "!=" comparison             -> ne

?comparison: bitwise_or
           | comparison "<" bitwise_or          -> lt
           | comparison "<=" bitwise_or         -> le
           | comparison ">" bitwise_or          -> gt
           | comparison ">=" bitwise_or         -> ge

?bitwise_or: bitwise_xor
           | bitwise_or "|" bitwise_xor         -> bitor

?bitwise_xor: bitwise_and
            | bitwise_xor "^" bitwise_and       -> bitxor

?bitwise_and: shift
            | bitwise_and "&" shift             -> bitand

?shift: addition
      | shift "<<" addition                     -> lshift
      | shift ">>" addition                     -> rshift

?addition: multiplication
         | addition "+" multiplication          -> add
         | addition "-" multiplication          -> sub

?multiplication: cast
               | multiplication "*" cast        -> mul
               | multiplication "/" cast        -> div

?cast: unary
     | cast AS type_expr                        -> type_cast

?unary: postfix
      | "!" unary                               -> not_expr
      | "~" unary                               -> bitnot
      | "-" unary                               -> neg
      | "*" unary                               -> deref
      | "&" unary                               -> addressof

?postfix: primary
        | postfix "(" arg_list? ")"             -> call
        | postfix "[" expr "]"                  -> array_index
        | postfix "." IDENT                     -> field_access

arg_list: expr ("," expr)* ","?

// Note: struct_literal_expr is NOT in primary to avoid IDENT "{" ambiguity.
// Struct literals are only allowed in specific initializer contexts (after =).
?primary: INTEGER                               -> integer
         | BOOLEAN                               -> boolean
         | STRING                                -> string_literal
         | CFG_FUNCTION "(" expr ")"             -> cfg_function_call
         | INCLUDE_BYTES "!" "(" STRING ")"      -> include_bytes_expr
         | IDENT "!" "(" macro_args? ")"         -> macro_invocation_expr
         | IDENT "::" IDENT                      -> enum_variant_expr
         | IDENT                                 -> identifier
         | SELF                                  -> self_identifier
         | REGISTER                              -> register_ref
        | "(" expr ")"                          -> paren
        | match_expr
        | if_expr
        | block_expr
        | array_fill_expr
        | array_literal_expr

// Block expression: { statements; final_expr } in expression context
block_expr: "{" statement* expr "}"

// If expression: if cond { expr } else { expr } (else required)
if_expr: IF expr block_expr (ELSE (if_expr | block_expr))

// Array expressions
array_fill_expr: "[" expr ";" expr "]"          // [value; count] - e.g., [0; 256]
array_literal_expr: "[" (expr ("," expr)* ","?)? "]"  // [a, b, c] - explicit elements

// Struct literal expression
// Note: Not directly in primary to avoid IDENT "{" ambiguity with blocks.
// Only used in initializer_expr (after = in let/static declarations).
struct_literal_expr: IDENT "{" struct_field_init ("," struct_field_init)* ","? "}"
struct_field_init: IDENT ":" initializer_expr

// Initializer expression - used after = in let/static declarations
// Allows struct literals and loop expressions which would be ambiguous in general expression context
// Uses ? to inline - the parser will return the struct_literal_expr or expr directly
?initializer_expr: struct_literal_expr
                 | initializer_array_literal
                 | loop_expr
                 | expr

// Loop expression: loop { ... break value; ... } - produces a value via break
// Only allowed in initializer context to avoid grammar ambiguity with loop_stmt
// Note: identical syntax to loop_stmt but produces a different tree node
loop_expr: LABEL_DEF? LOOP block

// Array literal in initializer context - allows struct literals as elements
initializer_array_literal: "[" initializer_expr ("," initializer_expr)* ","? "]"

// Types
?type_expr: type_basic
          | type_array
          | type_pointer
          | type_fn

type_basic: TYPE_NAME | IDENT
type_array: "[" type_expr ";" expr "]"
// Pointer type for casting: *type (implied near) or far *type or near *type
// With optional dyn keyword for trait pointers: *dyn Trait or far *dyn Trait
type_pointer: (FAR | NEAR)? STAR DYN? type_expr
type_fn: FAR? FN "(" type_list? ")" ("->" type_expr)?

// Tuple type for multiple return values: (u8, u8)
type_tuple: "(" type_expr ("," type_expr)+ ")"

type_list: type_expr ("," type_expr)* ","?

// ============================================================================
// Lexer Rules (uppercase names - Terminals)
// ============================================================================

// Keywords, registers, types, and booleans
// Ordered to check longer patterns first and avoid partial matches
// Within same priority (.10), definition order matters - first defined has priority

// Keywords used in parser rules - priority .10 to match before IDENT
// Order: longer keywords first to avoid partial matches
INCLUDE_BYTES.10: /include_bytes\b/
CONTINUE.10: /continue\b/
INCLUDE.10: /include\b/
RETURN.10: /return\b/
STRUCT.10: /struct\b/
STATIC.10: /static\b/
BREAK.10: /break\b/
CONST.10: /const\b/
WHILE.10: /while\b/
MATCH.10: /match\b/
ENUM.10: /enum\b/
LOOP.10: /loop\b/
FOR.10: /for\b/
IN.10: /in\b/
TYPE.10: /type\b/
ELSE.10: /else\b/
NEAR.10: /near\b/
LET.10: /let\b/
MUT.10: /mut\b/
ASM.10: /asm\b/
TRAIT.10: /trait\b/
IMPL.10: /impl\b/
SELF.10: /self\b/
DYN.10: /dyn\b/
FAR.10: /far\b/
FN.10: /fn\b/
IF.10: /if\b/
AS.10: /as\b/

// Conditional compilation
CFG_FUNCTION.10: /cfg!(?=\()/
CFG.10: /cfg\b/
CFG_NOT.10: /not\b/

// Macro keyword
MACRO_RULES.10: /macro_rules\b/

// Loop labels
// Label definition: 'outer: (before a loop)
LABEL_DEF.10: /'[a-zA-Z_][a-zA-Z0-9_]*:/
// Label reference: 'outer (in break/continue)
LABEL_REF.10: /'[a-zA-Z_][a-zA-Z0-9_]*/

// Macro variable reference ($name)
MACRO_VAR.10: /\$[a-zA-Z_][a-zA-Z0-9_]*/

// Fragment type specifiers for macro parameters
FRAGMENT_TYPE.10: /expr\b/ | /ident\b/ | /literal\b/ | /ty\b/ | /reg\b/ | /tt\b/

// Reserved keywords (not used in parser, but reserved for future use)
// Rust reserved words only - builtin functions (mul, div, etc.) are regular identifiers
// Note: 'macro' removed - now a first-class keyword
// Note: 'for' and 'in' removed - now first-class keywords for for loops
// Note: 'impl' and 'self' removed - now first-class keywords for impl blocks
KEYWORD.10: /abstract\b/ | /override\b/ | /unsized\b/ | /virtual\b/ | /typeof\b/ | /unsafe\b/ | /extern\b/ | /become\b/ | /async\b/ | /await\b/ | /where\b/ | /super\b/ | /yield\b/ | /crate\b/ | /final\b/ | /move\b/ | /priv\b/ | /Self\b/ | /box\b/ | /pub\b/ | /ref\b/ | /try\b/ | /use\b/ | /do\b/

// Booleans
BOOLEAN.10: /true\b/ | /false\b/

// Registers and types (with word boundaries)
REGISTER.10: /STATUS\b/ | /DBR\b/ | /PBR\b/ | /[ABXYDS]\b/
TYPE_NAME.10: /bool\b/ | /u16\b/ | /i16\b/ | /u8\b/ | /i8\b/

// Literals
INTEGER: HEX_INTEGER | BIN_INTEGER | DEC_INTEGER
// Allow zero digits after prefix - validation happens in lexer
HEX_INTEGER: /0[xX][0-9a-fA-F_]*(u16|i16|u8|i8)?/
BIN_INTEGER: /0[bB][01_]*(u16|i16|u8|i8)?/
DEC_INTEGER: /[0-9][0-9_]*(u16|i16|u8|i8)?/

STRING: ESCAPED_STRING

// Two-character operators (must come before single-char)
// Priority .10 ensures these are lexed before single-char operators
LSHIFT.10: "<<"
RSHIFT.10: ">>"
EQEQUAL.10: "=="
NOTEQUAL.10: "!="
LESSEQUAL.10: "<="
GREATEREQUAL.10: ">="
AND.10: "&&"
OR.10: "||"
RARROW.10: "->"
PLUSPLUS.10: "++"
MINUSMINUS.10: "--"
DOTDOTEQ.11: "..="
DOTDOT.10: ".."

// Compound assignment operators (must come before single-char operators)
// Priority .11 ensures three-char operators are lexed before two-char
LSHIFTEQUAL.11: "<<="
RSHIFTEQUAL.11: ">>="
PLUSEQUAL.10: "+="
MINUSEQUAL.10: "-="
STAREQUAL.10: "*="
SLASHEQUAL.10: "/="
AMPEREQUAL.10: "&="
VBAREQUAL.10: "|="
CIRCUMFLEXEQUAL.10: "^="

// Single-character operators
PLUS: "+"
MINUS: "-"
STAR: "*"
SLASH: "/"
AMPER: "&"
VBAR: "|"
CIRCUMFLEX: "^"
TILDE: "~"
EQUAL: "="
LESS: "<"
GREATER: ">"
EXCLAMATION: "!"
AT: "@"

// Delimiters
LPAR: "("
RPAR: ")"
LBRACE: "{"
RBRACE: "}"
LSQB: "["
RSQB: "]"
SEMI: ";"
COLON: ":"
COMMA: ","
DOT: "."
HASH: "#"

// Dollar sign for macro syntax
DOLLAR: "$"

// Identifiers (lowest priority)
// Negative lookahead documents which words are NOT identifiers. Uses $ (not \b) because
// the contextual lexer needs to match register names as IDENT in certain parser contexts
// (e.g., asm_named_arg: IDENT "=" ...). Actual disambiguation is via terminal priorities.
// Note: Builtin functions (mul, div, SEP, REP, etc.) are NOT excluded - they are valid identifiers
IDENT.1: /(?!(include_bytes|macro_rules|continue|include|return|struct|static|break|const|while|enum|impl|self|loop|type|else|near|let|mut|asm|far|fn|if|as|abstract|override|unsized|virtual|typeof|unsafe|extern|become|async|await|match|where|super|trait|yield|crate|final|move|priv|Self|box|dyn|for|mod|pub|ref|try|use|in|do|expr|ident|literal|ty|reg|tt|STATUS|DBR|PBR|bool|u16|i16|u8|i8|true|false|[ABXYDS])$)[a-zA-Z_][a-zA-Z0-9_]*/

// Imports and ignores
%import common.ESCAPED_STRING
%import common.WS
%import common.C_COMMENT
%import common.CPP_COMMENT

%ignore WS
%ignore C_COMMENT
%ignore CPP_COMMENT
