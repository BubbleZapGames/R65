// R65 Grammar for Lark Parser
// Complete grammar for both lexing and parsing

// ============================================================================
// Parser Rules (lowercase names)
// ============================================================================

// Starting rule - a source file is a list of items
start: item*

// Top-level items
?item: function_decl
     | static_decl
     | const_decl
     | struct_decl
     | enum_decl
     | type_alias
     | include_stmt
     | stack_directive
     | macro_decl
     | macro_invocation_stmt
     | _reserved_keyword  // Dummy rule to make reserved keywords valid tokens

// Stack directive - global attribute for stack region
// Uses explicit syntax to avoid grammar ambiguity
stack_directive: "#" "[" "stack" "(" INTEGER "," INTEGER ")" "]"

// Dummy rule to tell Lark that these terminals are valid (never actually matched in valid code)
_reserved_keyword: KEYWORD

// Function declaration
function_decl: attribute* FAR? FN IDENT "(" param_list? ")" return_type? block

param_list: param ("," param)* ","?
param: IDENT ("@" binding)? ":" type_expr

binding: REGISTER | IDENT

return_type: "->" (type_expr | "!")

// Static variable declaration
// Uses initializer_expr to allow struct literals after =
static_decl: attribute* STATIC MUT? IDENT ":" type_expr ("=" initializer_expr)? ";"

// Const declaration
const_decl: CONST IDENT ":" type_expr "=" expr ";"

// Struct declaration
struct_decl: STRUCT IDENT "{" struct_field* "}"
struct_field: IDENT ":" type_expr ","?

// Enum declaration
enum_decl: ENUM IDENT "{" enum_variant ("," enum_variant)* ","? "}"
enum_variant: IDENT ("=" expr)?

// Type alias
type_alias: TYPE IDENT "=" type_expr ";"

// Include statement
include_stmt: INCLUDE "!" "(" STRING ")"

// Macro definition
// macro_rules! name($param:fragment, ...) { body }
macro_decl: MACRO_RULES "!" IDENT "(" macro_params? ")" macro_body

macro_params: macro_param ("," macro_param)* ","?

// Simple parameter: $name:fragment
// Repeated parameter: $($name:fragment),*
macro_param: MACRO_VAR ":" FRAGMENT_TYPE                              -> macro_param_simple
           | DOLLAR "(" MACRO_VAR ":" FRAGMENT_TYPE ")" "," "*"       -> macro_param_repeated

// Macro body is captured as raw tokens between braces
// We use a special rule to capture everything including nested braces
macro_body: "{" macro_body_content* "}"

// Content inside macro body - can be any token or nested braces
?macro_body_content: macro_body              // Nested braces
                   | MACRO_VAR               // $param references
                   | macro_repetition        // $(...)*
                   | macro_token             // Any other token

// Repetition in macro body: $( content ),*
macro_repetition: DOLLAR "(" macro_body_content+ ")" "," "*"    -> macro_rep_comma
                | DOLLAR "(" macro_body_content+ ")" "*"         -> macro_rep_no_sep

// Any token that can appear in a macro body (excluding special macro syntax)
macro_token: IDENT | REGISTER | TYPE_NAME | INTEGER | STRING | BOOLEAN
           | KEYWORD | INCLUDE | INCLUDE_BYTES | CONST | STATIC | LET | MUT
           | FN | FAR | NEAR | IF | ELSE | LOOP | WHILE | MATCH | RETURN
           | BREAK | CONTINUE | ASM | STRUCT | ENUM | TYPE | AS
           | "(" | ")" | "[" | "]" | ";" | ":" | "," | "." | "#"
           | "+" | "-" | "*" | "/" | "%" | "&" | "|" | "^" | "~" | "!"
           | "=" | "<" | ">" | "@" | "->" | "==" | "!=" | "<=" | ">="
           | "&&" | "||" | "<<" | ">>" | "++" | "--"
           | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^=" | "<<=" | ">>="
           | "::"

// Top-level macro invocation: name!(args);
macro_invocation_stmt: IDENT "!" "(" macro_args? ")" ";"

// Statement-level macro invocation (inside function bodies)
macro_invocation_stmt_inner: IDENT "!" "(" macro_args? ")" ";"

// Macro arguments - comma-separated token trees
macro_args: macro_arg ("," macro_arg)*

// A single macro argument - balanced tokens
macro_arg: macro_arg_token+

macro_arg_token: IDENT | REGISTER | TYPE_NAME | INTEGER | STRING | BOOLEAN
               | KEYWORD | MACRO_VAR
               | "(" macro_arg_token* ")"    // Nested parens
               | "[" macro_arg_token* "]"    // Nested brackets
               | "{" macro_arg_token* "}"    // Nested braces
               | "+" | "-" | "*" | "/" | "%" | "&" | "|" | "^" | "~" | "!"
               | "=" | "<" | ">" | "@" | "->" | "==" | "!=" | "<=" | ">="
               | "&&" | "||" | "<<" | ">>" | "++" | "--" | ";" | ":" | "." | "#"
               | "::"

// Attributes
attribute: "#" "[" attribute_inner "]"
attribute_inner: IDENT ("(" attribute_args? ")")?
attribute_args: attribute_arg ("," attribute_arg)* ","?
attribute_arg: IDENT "=" expr      -> named_arg
             | expr                -> positional_arg

// Block
block: "{" statement* "}"

// Statements
?statement: let_stmt
          | expr_stmt
          | return_stmt
          | break_stmt
          | continue_stmt
          | if_stmt
          | loop_stmt
          | while_stmt
          | block
          | asm_stmt
          | increment_stmt
          | decrement_stmt
          | macro_invocation_stmt_inner

// Uses initializer_expr to allow struct literals after =
let_stmt: LET MUT? IDENT ("@" binding)? (":" type_expr)? "=" initializer_expr ";"
expr_stmt: expr ";"
return_stmt: RETURN (expr ("," expr)*)? ";"
break_stmt: BREAK ";"
continue_stmt: CONTINUE ";"
increment_stmt: lvalue PLUSPLUS ";"
decrement_stmt: lvalue MINUSMINUS ";"

if_stmt: IF expr block (ELSE else_clause)?
else_clause: if_stmt | block

loop_stmt: LOOP block
while_stmt: WHILE expr block

asm_stmt: ASM "!" "(" STRING ("," STRING)* ")" ";"

// Match expression
match_expr: MATCH expr "{" match_arm ("," match_arm)* ","? "}"
match_arm: pattern "=>" expr

// Patterns
?pattern: pattern_or

pattern_or: pattern_primary ("|" pattern_primary)*

?pattern_primary: pattern_literal
                | pattern_enum
                | pattern_wildcard
                | pattern_ident

pattern_literal: INTEGER | BOOLEAN
pattern_enum: IDENT "::" IDENT
pattern_wildcard: "_"
pattern_ident: IDENT

// Expressions (precedence from low to high)
?expr: assignment

?assignment: logical_or
           | lvalue "=" assignment                          -> assign
           | lvalue compound_op assignment                  -> compound_assign

compound_op: PLUSEQUAL | MINUSEQUAL | STAREQUAL | SLASHEQUAL | PERCENTEQUAL
           | AMPEREQUAL | VBAREQUAL | CIRCUMFLEXEQUAL
           | LSHIFTEQUAL | RSHIFTEQUAL

lvalue: IDENT                                   -> lvalue_ident
      | REGISTER                                -> lvalue_register
      | postfix "[" expr "]"                    -> lvalue_array
      | postfix "." IDENT                       -> lvalue_field
      | "*" unary                               -> lvalue_deref

?logical_or: logical_and
           | logical_or "||" logical_and        -> or_expr

?logical_and: equality
            | logical_and "&&" equality         -> and_expr

?equality: comparison
         | equality "==" comparison             -> eq
         | equality "!=" comparison             -> ne

?comparison: bitwise_or
           | comparison "<" bitwise_or          -> lt
           | comparison "<=" bitwise_or         -> le
           | comparison ">" bitwise_or          -> gt
           | comparison ">=" bitwise_or         -> ge

?bitwise_or: bitwise_xor
           | bitwise_or "|" bitwise_xor         -> bitor

?bitwise_xor: bitwise_and
            | bitwise_xor "^" bitwise_and       -> bitxor

?bitwise_and: shift
            | bitwise_and "&" shift             -> bitand

?shift: addition
      | shift "<<" addition                     -> lshift
      | shift ">>" addition                     -> rshift

?addition: multiplication
         | addition "+" multiplication          -> add
         | addition "-" multiplication          -> sub

?multiplication: cast
               | multiplication "*" cast        -> mul
               | multiplication "/" cast        -> div
               | multiplication "%" cast        -> mod

?cast: unary
     | cast AS type_expr                        -> type_cast

?unary: postfix
      | "!" unary                               -> not_expr
      | "~" unary                               -> bitnot
      | "-" unary                               -> neg
      | "*" unary                               -> deref
      | "&" unary                               -> addressof

?postfix: primary
        | postfix "(" arg_list? ")"             -> call
        | postfix "[" expr "]"                  -> array_index
        | postfix "." IDENT                     -> field_access

arg_list: expr ("," expr)* ","?

// Note: struct_literal_expr is NOT in primary to avoid IDENT "{" ambiguity.
// Struct literals are only allowed in specific initializer contexts (after =).
?primary: INTEGER                               -> integer
        | BOOLEAN                               -> boolean
        | STRING                                -> string_literal
        | INCLUDE_BYTES "!" "(" STRING ")"      -> include_bytes_expr
        | IDENT "::" IDENT                      -> enum_variant_expr
        | IDENT                                 -> identifier
        | REGISTER                              -> register_ref
        | "(" expr ")"                          -> paren
        | match_expr
        | array_fill_expr
        | array_literal_expr

// Array expressions
array_fill_expr: "[" expr ";" expr "]"          // [value; count] - e.g., [0; 256]
array_literal_expr: "[" (expr ("," expr)* ","?)? "]"  // [a, b, c] - explicit elements

// Struct literal expression
// Note: Not directly in primary to avoid IDENT "{" ambiguity with blocks.
// Only used in initializer_expr (after = in let/static declarations).
struct_literal_expr: IDENT "{" struct_field_init ("," struct_field_init)* ","? "}"
struct_field_init: IDENT ":" expr

// Initializer expression - used after = in let/static declarations
// Allows struct literals which would be ambiguous in general expression context
// Uses ? to inline - the parser will return the struct_literal_expr or expr directly
?initializer_expr: struct_literal_expr
                 | initializer_array_literal
                 | expr

// Array literal in initializer context - allows struct literals as elements
initializer_array_literal: "[" initializer_expr ("," initializer_expr)* ","? "]"

// Types
?type_expr: type_basic
          | type_array
          | type_pointer
          | type_fn

type_basic: TYPE_NAME | IDENT
type_array: "[" type_expr ";" expr "]"
type_pointer: (NEAR | FAR) "<" type_expr ">"
type_fn: FAR? FN "(" type_list? ")" ("->" type_expr)?

type_list: type_expr ("," type_expr)* ","?

// ============================================================================
// Lexer Rules (uppercase names - Terminals)
// ============================================================================

// Keywords, registers, types, and booleans
// Ordered to check longer patterns first and avoid partial matches
// Within same priority (.10), definition order matters - first defined has priority

// Keywords used in parser rules - priority .10 to match before IDENT
// Order: longer keywords first to avoid partial matches
INCLUDE_BYTES.10: /include_bytes\b/
CONTINUE.10: /continue\b/
INCLUDE.10: /include\b/
RETURN.10: /return\b/
STRUCT.10: /struct\b/
STATIC.10: /static\b/
BREAK.10: /break\b/
CONST.10: /const\b/
WHILE.10: /while\b/
MATCH.10: /match\b/
ENUM.10: /enum\b/
LOOP.10: /loop\b/
TYPE.10: /type\b/
ELSE.10: /else\b/
NEAR.10: /near\b/
LET.10: /let\b/
MUT.10: /mut\b/
ASM.10: /asm\b/
FAR.10: /far\b/
FN.10: /fn\b/
IF.10: /if\b/
AS.10: /as\b/

// Macro keyword
MACRO_RULES.10: /macro_rules\b/

// Macro variable reference ($name)
MACRO_VAR.10: /\$[a-zA-Z_][a-zA-Z0-9_]*/

// Fragment type specifiers for macro parameters
FRAGMENT_TYPE.10: /expr\b/ | /ident\b/ | /literal\b/ | /ty\b/ | /reg\b/ | /tt\b/

// Reserved keywords (not used in parser, but reserved for future use)
// Rust reserved words only - builtin functions (mul, div, etc.) are regular identifiers
// Note: 'macro' removed - now a first-class keyword
KEYWORD.10: /abstract\b/ | /override\b/ | /unsized\b/ | /virtual\b/ | /typeof\b/ | /unsafe\b/ | /extern\b/ | /become\b/ | /async\b/ | /await\b/ | /where\b/ | /super\b/ | /trait\b/ | /yield\b/ | /crate\b/ | /final\b/ | /impl\b/ | /move\b/ | /priv\b/ | /self\b/ | /Self\b/ | /box\b/ | /dyn\b/ | /for\b/ | /mod\b/ | /pub\b/ | /ref\b/ | /try\b/ | /use\b/ | /in\b/ | /do\b/

// Booleans
BOOLEAN.10: /true\b/ | /false\b/

// Registers and types (with word boundaries)
REGISTER.10: /STATUS\b/ | /DBR\b/ | /PBR\b/ | /[ABXYDS]\b/
TYPE_NAME.10: /bool\b/ | /u16\b/ | /i16\b/ | /u8\b/ | /i8\b/

// Literals
INTEGER: HEX_INTEGER | BIN_INTEGER | DEC_INTEGER
// Allow zero digits after prefix - validation happens in lexer
HEX_INTEGER: /0[xX][0-9a-fA-F_]*/
BIN_INTEGER: /0[bB][01_]*/
DEC_INTEGER: /[0-9][0-9_]*/

STRING: ESCAPED_STRING

// Two-character operators (must come before single-char)
LSHIFT: "<<"
RSHIFT: ">>"
EQEQUAL: "=="
NOTEQUAL: "!="
LESSEQUAL: "<="
GREATEREQUAL: ">="
AND: "&&"
OR: "||"
RARROW: "->"
PLUSPLUS: "++"
MINUSMINUS: "--"

// Compound assignment operators (must come before single-char operators)
LSHIFTEQUAL: "<<="
RSHIFTEQUAL: ">>="
PLUSEQUAL: "+="
MINUSEQUAL: "-="
STAREQUAL: "*="
SLASHEQUAL: "/="
PERCENTEQUAL: "%="
AMPEREQUAL: "&="
VBAREQUAL: "|="
CIRCUMFLEXEQUAL: "^="

// Single-character operators
PLUS: "+"
MINUS: "-"
STAR: "*"
SLASH: "/"
PERCENT: "%"
AMPER: "&"
VBAR: "|"
CIRCUMFLEX: "^"
TILDE: "~"
EQUAL: "="
LESS: "<"
GREATER: ">"
EXCLAMATION: "!"
AT: "@"

// Delimiters
LPAR: "("
RPAR: ")"
LBRACE: "{"
RBRACE: "}"
LSQB: "["
RSQB: "]"
SEMI: ";"
COLON: ":"
COMMA: ","
DOT: "."
HASH: "#"

// Dollar sign for macro syntax
DOLLAR: "$"

// Identifiers (lowest priority)
// Use negative lookahead to exclude all keywords, registers, types, and booleans
// Identifiers - lowest priority, with negative lookahead to exclude all keywords, registers, types, and booleans
// Note: Builtin functions (mul, div, SEP, REP, etc.) are NOT excluded - they are valid identifiers
IDENT.1: /(?!(include_bytes|macro_rules|continue|include|return|struct|static|break|const|while|enum|loop|type|else|near|let|mut|asm|far|fn|if|as|abstract|override|unsized|virtual|typeof|unsafe|extern|become|async|await|match|where|super|trait|yield|crate|final|impl|move|priv|self|Self|box|dyn|for|mod|pub|ref|try|use|in|do|expr|ident|literal|ty|reg|tt|STATUS|DBR|PBR|bool|u16|i16|u8|i8|true|false|[AXYDS])$)[a-zA-Z_][a-zA-Z0-9_]*/

// Imports and ignores
%import common.ESCAPED_STRING
%import common.WS
%import common.C_COMMENT
%import common.CPP_COMMENT

%ignore WS
%ignore C_COMMENT
%ignore CPP_COMMENT
