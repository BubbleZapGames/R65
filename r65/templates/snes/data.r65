static mut TILE_DATA: [u8; 16] = [
    // Row 0: 00001111
    0x0F, 0x00,
    // Row 1: 00001111  
    0x0F, 0x00,
    // Row 2: 00001111
    0x0F, 0x00,
    // Row 3: 00001111
    0x0F, 0x00,
    // Row 4: 11110000
    0xF0, 0x00,
    // Row 5: 11110000
    0xF0, 0x00,
    // Row 6: 11110000
    0xF0, 0x00,
    // Row 7: 11110000
