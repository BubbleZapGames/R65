# {{PROJECT_NAME}} - Makefile for SNES development with WLA-DX
# Generated by R65 project management tool

# Project configuration
PROJECT = {{PROJECT_NAME_UPPER}}
MAIN_SRC = src/main.r65
BUILD_DIR = build
ROM_FILE = $(BUILD_DIR)/$(PROJECT).smc

# Tools
PYTHON = python
R65C = $(PYTHON) -m r65.compiler.main
R65PKG = $(PYTHON) -m r65.pkg.cli
WLA = wla-65816
WLA_LINK = wlalink

# ABI model chosen at `r65x init` (Default or FixedStack)
ABI = {{ABI}}

# Flags
WLA_FLAGS = -I src -o
R65C_FLAGS = -v --cfg snes --dbg -I src

# File operations through Python (already required for R65): Windows make
# runs recipes in cmd.exe when no sh.exe is on PATH, where `mkdir -p` makes a
# folder named "-p" and `rm -rf` doesn't exist.
MKDIR = $(PYTHON) -c "import os, sys; [os.makedirs(d, exist_ok=True) for d in sys.argv[1:]]"
RMDIR = $(PYTHON) -c "import shutil, sys; [shutil.rmtree(d, ignore_errors=True) for d in sys.argv[1:]]"
RM = $(PYTHON) -c "import glob, os, sys; [os.remove(f) for p in sys.argv[1:] for f in glob.glob(p)]"

# Default target
all: $(ROM_FILE)

# Compile R65 source to WLA-DX assembly. r65c finds stdlib through r65.toml;
# the depfile names every file the build read, so editing any one rebuilds.
$(BUILD_DIR)/main.asm: $(MAIN_SRC) | deps
	@$(MKDIR) $(BUILD_DIR)
	$(R65C) $(MAIN_SRC) -o $@ $(R65C_FLAGS) --abi $(ABI) --depfile $(BUILD_DIR)/main.d

-include $(BUILD_DIR)/main.d

# Lock the r65.toml dependencies (r65.lock) and fetch them into .r65/deps/
deps:
	$(R65PKG) fetch

# Assemble WLA-DX object file
$(BUILD_DIR)/main.o: $(BUILD_DIR)/main.asm
	$(WLA) $(WLA_FLAGS) $@ $<

# Link object file to ROM (uses linkfile generated by R65 compiler)
$(ROM_FILE): $(BUILD_DIR)/main.o
	@echo "[LINK] $@"
	$(WLA_LINK) -v -S $(BUILD_DIR)/main.link $@

# Build using r65x (alternative method)
r65x-build:
	r65x build

# Clean build artifacts
clean:
	@echo "[CLEAN] Removing build artifacts..."
	$(RMDIR) $(BUILD_DIR)
	$(RM) "*.o" "*.asm" "*.smc" "*.sym" "*.map"

# Install dependencies
install-deps:
	@echo "[INSTALL] Installing WLA-DX..."
	@if command -v brew >/dev/null 2>&1; then \
		brew install wla-dx; \
	else \
		echo "Error: Homebrew not found."; \
		echo "Option 1: Install Homebrew (https://brew.sh) then run: brew install wla-dx"; \
		echo "Option 2: Download pre-built binaries from https://github.com/vhelin/wla-dx/releases"; \
		echo "          Extract and place wla-65816 and wlalink on your PATH."; \
		exit 1; \
	fi

# Run with emulator (requires BSNES or higan)
run: $(ROM_FILE)
	@if command -v Mesen >/dev/null 2>&1; then \
		Mesen $(ROM_FILE); \
	elif command -v higan >/dev/null 2>&1; then \
		higan $(ROM_FILE); \
	elif command -v bsnes >/dev/null 2>&1; then \
		bsnes $(ROM_FILE); \
	else \
		echo "No compatible emulator found. Install bsnes or higan."; \
		echo "Then run: make run"; \
	fi

# Run tests/*.script against the ROM with mesen-gdb (skipped if not installed)
tests: $(ROM_FILE)
	$(MAKE) -C tests ROM=../$(ROM_FILE)

# Debug with verbose output
debug: clean
	$(MAKE) all R65C_FLAGS="-v"

# Check syntax only (no ROM generation)
syntax: $(BUILD_DIR)/main.asm

# Show help
help:
	@echo "Available targets:"
	@echo "  all          - Build ROM (default)"
	@echo "  deps         - Lock and fetch the r65.toml dependencies"
	@echo "  r65x-build   - Build using r65x tool"
	@echo "  clean        - Remove build artifacts"
	@echo "  install-deps - Install WLA-DX dependencies"
	@echo "  run          - Run ROM with emulator"
	@echo "  tests        - Run tests/*.script with mesen-gdb"
	@echo "  debug        - Build with verbose output"
	@echo "  syntax       - Check syntax only"
	@echo "  help         - Show this help"

# Debug print variables
debug-vars:
	@echo "PROJECT: $(PROJECT)"
	@echo "MAIN_SRC: $(MAIN_SRC)"
	@echo "ROM_FILE: $(ROM_FILE)"
	@echo "ABI: $(ABI)"

.PHONY: all deps clean install-deps run tests debug syntax r65x-build help debug-vars
