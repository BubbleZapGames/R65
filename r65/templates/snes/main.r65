// {{PROJECT_NAME}} - Main entry point
// SNES LoROM template project

#[snesrom(name="{{PROJECT_NAME_UPPER}}")]

// Include standard libraries
include!("lib/65816.r65")
include!("lib/sneslib.r65")
include!("lib/math.r65")

// Bank 0 - Main code
#[bank(0)]

// NMI handler - called every VBlank
#[interrupt(nmi)]
fn nmi_handler() {
    // Update game logic here
    clear_nmi!()
}

// Program entry point
#[entry]
fn main() -> ! {
    // Initialize SNES hardware (force-blank boot path; configure PPU / DMA
    // inside snes_init or other functions listed in r65-lint.toml's
    // exclude_subtrees).
    snes_init();

    // Main loop
    loop {

    }
}
