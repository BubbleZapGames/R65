// {{PROJECT_NAME}} - Main entry point
// SNES LoROM template project

#[snesrom(name="{{PROJECT_NAME_UPPER}}")]

#[stack(0x0100, 0x01FF)]

// Include standard libraries
include!("lib/65816.r65")
include!("lib/sneslib.r65")
include!("lib/math.r65")

// Bank 0 - Main code
#[bank(0)]

// Reset handler — runs once at power-on. Initializes SNES hardware, then
// hands off to main(). Listed in r65-lint.toml's exclude_subtrees so the
// PPU/DMA writes inside snes_init() are recognized as force-blank boot.
#[entry]
fn init_reset() -> ! {
    snes_init();
    main();
}

// NMI handler — called every VBlank. Put PPU/DMA traffic here
#[interrupt(nmi)]
fn nmi_handler() {
    clear_nmi!()
}

// Game loop: runs forever after init_reset() hands off. Edit this.
fn main() -> ! {
    loop {
        wait_nmi!();
    }
}
