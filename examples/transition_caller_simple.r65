// Test transition=caller mode handling

#[zeropage(0x20)]
static mut VALUE: u8 = 0;

// M16 mode function with transition=caller
#[mode(m16, x16, transition=caller)]
fn process_16bit() {
    A = 0x1234;
}

// M8 mode caller
#[mode(m8, x8)]
fn caller() {
    process_16bit();
}

// Entry point
#[mode(m8, x8)]
fn main() -> ! {
    caller();
    loop {
        VALUE = 0;
    }
}
