// Test transition=caller

#[zeropage(0x20)]
static mut VALUE: u8 = 0;

// Function with transition=caller
#[mode(m16, x16, transition=caller)]
fn process_16bit() {
    A = 0x1234;
}

// Function with transition=caller and preserves(STATUS)
#[mode(m16, x16, transition=caller)]
#[preserves(STATUS)]
fn process_16bit_preserves() {
    A = 0xABCD;
}

// Caller in m8 mode
#[mode(m8, x8)]
fn caller() {
    // Should generate PHP/PLP wrapper
    process_16bit();

    // Should generate SEP/REP wrapper (no PHP/PLP)
    process_16bit_preserves();
}
