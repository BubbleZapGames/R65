// Test mode transition handling

#[zeropage(0x20)]
static mut VALUE: u8 = 0;

// M8 mode function with transition=none (default)
#[mode(m8, x8)]
fn func_m8_none() {
    A = 0x42;
    VALUE = A;
}

// M16 mode function with transition=none
#[mode(m16, x16)]
fn func_m16_none() {
    A = 0x1234;
}

// M16 mode function with transition=caller
#[mode(m16, x16, transition=caller)]
fn func_m16_caller() {
    A = 0x5678;
}

// M16 mode function with transition=caller AND preserves(STATUS)
#[mode(m16, x16, transition=caller)]
#[preserves(STATUS)]
fn func_m16_caller_preserves() {
    // This function promises not to modify STATUS
    // So it expects to be called in m16/x16 mode
    A = 0xABCD;
}

// M8 mode caller that calls different functions
#[mode(m8, x8)]
fn caller_m8() {
    // Same mode - no wrapper
    func_m8_none();

    // Mixed mode with transition=none - no wrapper (programmer handles)
    func_m16_none();

    // Mixed mode with transition=caller - generates PHP/PLP wrapper
    func_m16_caller();

    // Mixed mode with transition=caller + preserves(STATUS) - generates SEP/REP wrapper
    func_m16_caller_preserves();
}

// Entry point
#[entry]
#[mode(m8, x8)]
fn main() -> ! {
    caller_m8();
    loop {}
}
