// Test control flow lowering to MIR

#[zeropage(0x20)]
static mut COUNTER: u8 = 0;

#[zeropage(0x21)]
static mut FLAG: u8 = 0;

// Test if/else
#[mode(m8, x8)]
fn test_if(value @ A: u8) -> u8 {
    if value == 0 {
        A = 1;
    } else {
        A = 2;
    }
    return A;
}

// Test else-if chain
#[mode(m8, x8)]
fn test_else_if(value @ A: u8) -> u8 {
    if value == 0 {
        A = 10;
    } else if value == 1 {
        A = 20;
    } else {
        A = 30;
    }
    return A;
}

// Test while loop
#[mode(m8, x8)]
fn test_while() {
    let count @ A = 0;
    while count < 10 {
        count = count + 1;
    }
    COUNTER = count;
}

// Test infinite loop with break
#[mode(m8, x8)]
fn test_loop_break() {
    let count @ A = 0;
    loop {
        count = count + 1;
        if count == 5 {
            break;
        }
    }
    COUNTER = count;
}

// Test continue
#[mode(m8, x8)]
fn test_continue() {
    let count @ A = 0;
    let sum @ X = 0;

    while count < 10 {
        count = count + 1;
        if count == 5 {
            continue;
        }
        sum = sum + count;
    }
    COUNTER = sum;
}

// Test nested loops
#[mode(m8, x8)]
fn test_nested() {
    let i @ A = 0;
    let j @ X = 0;

    while i < 3 {
        j = 0;
        while j < 3 {
            if i == j {
                j = j + 1;
                continue;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}
