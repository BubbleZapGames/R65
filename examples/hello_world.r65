// ============================================================================
// SNES Hello World in R65
// ============================================================================
// Displays "HELLO WORLD" on screen using BG1 tiles
// Uses the standard sneslib.r65 library
// ============================================================================

#[snesrom(name="HELLO WORLD")]

include!("../stdlib/sneslib.r65")

// ----------------------------------------------------------------------------
// Message to display
// ----------------------------------------------------------------------------

#[rom]
static MESSAGE: [u8; 12] = "HELLO WORLD\0";

// ----------------------------------------------------------------------------
// Simple 8x8 Font (1bpp, space + A-Z)
// Each character is 8 bytes (8 rows of 8 pixels)
// ----------------------------------------------------------------------------

#[rom]
static FONT: [u8; 216] = [
    // Tile 0: Space (blank)
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,

    // Tile 1: 'A'
    0x18, 0x3C, 0x66, 0x66, 0x7E, 0x66, 0x66, 0x00,

    // Tile 2: 'B'
    0x7C, 0x66, 0x66, 0x7C, 0x66, 0x66, 0x7C, 0x00,

    // Tile 3: 'C'
    0x3C, 0x66, 0x60, 0x60, 0x60, 0x66, 0x3C, 0x00,

    // Tile 4: 'D'
    0x78, 0x6C, 0x66, 0x66, 0x66, 0x6C, 0x78, 0x00,

    // Tile 5: 'E'
    0x7E, 0x60, 0x60, 0x7C, 0x60, 0x60, 0x7E, 0x00,

    // Tile 6: 'F'
    0x7E, 0x60, 0x60, 0x7C, 0x60, 0x60, 0x60, 0x00,

    // Tile 7: 'G'
    0x3C, 0x66, 0x60, 0x6E, 0x66, 0x66, 0x3E, 0x00,

    // Tile 8: 'H'
    0x66, 0x66, 0x66, 0x7E, 0x66, 0x66, 0x66, 0x00,

    // Tile 9: 'I'
    0x3C, 0x18, 0x18, 0x18, 0x18, 0x18, 0x3C, 0x00,

    // Tile 10: 'J'
    0x1E, 0x0C, 0x0C, 0x0C, 0x0C, 0x6C, 0x38, 0x00,

    // Tile 11: 'K'
    0x66, 0x6C, 0x78, 0x70, 0x78, 0x6C, 0x66, 0x00,

    // Tile 12: 'L'
    0x60, 0x60, 0x60, 0x60, 0x60, 0x60, 0x7E, 0x00,

    // Tile 13: 'M'
    0x63, 0x77, 0x7F, 0x6B, 0x63, 0x63, 0x63, 0x00,

    // Tile 14: 'N'
    0x66, 0x76, 0x7E, 0x7E, 0x6E, 0x66, 0x66, 0x00,

    // Tile 15: 'O'
    0x3C, 0x66, 0x66, 0x66, 0x66, 0x66, 0x3C, 0x00,

    // Tile 16: 'P'
    0x7C, 0x66, 0x66, 0x7C, 0x60, 0x60, 0x60, 0x00,

    // Tile 17: 'Q'
    0x3C, 0x66, 0x66, 0x66, 0x6A, 0x6C, 0x36, 0x00,

    // Tile 18: 'R'
    0x7C, 0x66, 0x66, 0x7C, 0x6C, 0x66, 0x66, 0x00,

    // Tile 19: 'S'
    0x3C, 0x66, 0x60, 0x3C, 0x06, 0x66, 0x3C, 0x00,

    // Tile 20: 'T'
    0x7E, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x00,

    // Tile 21: 'U'
    0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x3C, 0x00,

    // Tile 22: 'V'
    0x66, 0x66, 0x66, 0x66, 0x66, 0x3C, 0x18, 0x00,

    // Tile 23: 'W'
    0x63, 0x63, 0x63, 0x6B, 0x7F, 0x77, 0x63, 0x00,

    // Tile 24: 'X'
    0x66, 0x66, 0x3C, 0x18, 0x3C, 0x66, 0x66, 0x00,

    // Tile 25: 'Y'
    0x66, 0x66, 0x66, 0x3C, 0x18, 0x18, 0x18, 0x00,

    // Tile 26: 'Z'
    0x7E, 0x06, 0x0C, 0x18, 0x30, 0x60, 0x7E, 0x00
];

// ----------------------------------------------------------------------------
// Palette data (4 colors for 2bpp mode)
// ----------------------------------------------------------------------------

#[rom]
static PALETTE: [u8; 8] = [
    0x00, 0x00,  // Color 0: Black (background)
    0x29, 0x25,  // Color 1: Dark gray
    0x52, 0x4A,  // Color 2: Light gray
    0xFF, 0x7F   // Color 3: White (foreground)
];

// ----------------------------------------------------------------------------
// Entry Point
// ----------------------------------------------------------------------------

#[mode(m8, x8)]
#[entry]
fn main() -> ! {
    // Initialize SNES (PPU, clear VRAM/CGRAM/OAM)
    snes_init();

    // Configure BG mode and tilemap
    BGMODE = BGMODE_0;                  // Mode 0: 4 layers, 2bpp each
    BG1SC = 0x00;                       // Tilemap at VRAM $0000, 32x32
    BG12NBA = 0x01;                     // Characters at VRAM $1000

    // Set VRAM increment mode
    set_vram_inc!(VMAIN_INCREMENT_HIGH);

    // Upload font to VRAM
    upload_font();

    // Write message to tilemap
    write_message(14, 0, &MESSAGE);

    // Upload palette
    upload_palette();

    // Enable BG1 on main screen
    enable_main!(SCREEN_BG1);

    // Turn on screen
    screen_on!(BRIGHTNESS_FULL);

    // Main loop
    loop {
        wait_nmi();
    }
}

// ----------------------------------------------------------------------------
// Upload font tiles to VRAM
// ----------------------------------------------------------------------------

#[mode(m8, x8)]
fn upload_font() {
    // Set VRAM address for character data
    // BG12NBA = 0x01 means char base at 1 * $2000 bytes = $1000 words
    set_vram_addr!(0x1000);

    // SNES 2bpp format is INTERLEAVED by row:
    // Byte 0: Row 0 BP0, Byte 1: Row 0 BP1
    // Byte 2: Row 1 BP0, Byte 3: Row 1 BP1
    // ... (16 bytes per tile)
    //
    // To get color 3 (both bits set), write same byte to both bitplanes.
    // Each source byte (1bpp row) becomes one VRAM word.

    X = 0;
    loop {
        A = FONT[X];
        VMDATAL = A;  // Row N, Bitplane 0
        VMDATAH = A;  // Row N, Bitplane 1
        X++;
        if X == 216 {
            break;
        }
    }
}

// ----------------------------------------------------------------------------
// Write "HELLO WORLD" to the tilemap
// ----------------------------------------------------------------------------

#[mode(m8, x8)]
fn write_message(row @ A: u8, column @ X: u8, message: far *[u8; 12]) {
    // Set VRAM address to tilemap position
    // Row 14, Column 10 (centered on 32x32 tilemap)
    // Offset = (14 * 32 + 10) = 458 = $01CA
    A = A << 5;  // row * 32 (tiles per row)
    set_vram_addr!(A + X);

    // Write each character as a tile
    X = 0;
    loop {
        A = message[X];

        // Check for null terminator
        if A == 0 {
            break;
        }

        // Convert ASCII to tile index
        A = ascii_to_tile(A);

        VMDATAL = A;   // Tile number
        VMDATAH = 0;   // Attributes (palette 0, no flip)

        X++;
    }
}

// ----------------------------------------------------------------------------
// Convert ASCII character to tile index
// ----------------------------------------------------------------------------

#[mode(m8, x8)]
fn ascii_to_tile(char @ A: u8) -> u8 {
    if A == 0x20 {
        // Space -> tile 0
        A = 0;
    } else {
        // A-Z: 0x41-0x5A -> tiles 1-26
        A = A - 0x40;
    }
    return A;
}

// ----------------------------------------------------------------------------
// Upload palette to CGRAM
// ----------------------------------------------------------------------------

#[mode(m8, x8)]
fn upload_palette() {
    set_cgram_addr!(0);

    X = 0;
    loop {
        A = PALETTE[X];
        CGDATA = A;
        X++;
        if X == 8 {
            break;
        }
    }
}
