// Quicksort Demo - Sorting Playing Cards
// Demonstrates: enums, structs, arrays, recursion, comparisons, bit manipulation
//
// This example sorts a hand of playing cards first by suit, then by rank.
// It showcases R65's support for recursive algorithms on the 65816 processor.

#[snesrom(name="QUICKSORT DEMO")]

// ============================================================================
// Card Definitions
// ============================================================================

// Suit enum - ordered for sorting (Hearts < Diamonds < Clubs < Spades)
enum Suit {
    Hearts = 0,
    Diamonds = 1,
    Clubs = 2,
    Spades = 3
}

// Rank enum - standard card ranks
enum Rank {
    Ace = 1,
    Two = 2,
    Three = 3,
    Four = 4,
    Five = 5,
    Six = 6,
    Seven = 7,
    Eight = 8,
    Nine = 9,
    Ten = 10,
    Jack = 11,
    Queen = 12,
    King = 13
}

// Card struct with suit and rank
struct Card {
    suit: Suit,
    rank: Rank
}

// ============================================================================
// Memory Layout
// ============================================================================

const HAND_SIZE: u8 = 8;

// Array of cards - initialized with unsorted hand
#[ram]
static mut CARDS: [Card; 8] = [
    Card { suit: Suit::Spades, rank: Rank::Seven },    // 7 of Spades
    Card { suit: Suit::Hearts, rank: Rank::King },     // King of Hearts
    Card { suit: Suit::Clubs, rank: Rank::Ace },       // Ace of Clubs
    Card { suit: Suit::Hearts, rank: Rank::Two },      // 2 of Hearts
    Card { suit: Suit::Diamonds, rank: Rank::Jack },   // Jack of Diamonds
    Card { suit: Suit::Spades, rank: Rank::Ace },      // Ace of Spades
    Card { suit: Suit::Diamonds, rank: Rank::Five },   // 5 of Diamonds
    Card { suit: Suit::Clubs, rank: Rank::Queen }      // Queen of Clubs
];

// Temp storage for swapping (cheaper than stack on 6502)
#[zeropage(0x10)]
static mut TEMP_CARD: Card;

// Scratch registers for compiler temporaries
#[zeropage(0x14, register)]
static mut SCRATCH0: u8;

#[zeropage(0x16, register)]
static mut SCRATCH1: u16;

// ============================================================================
// Comparison Function
// ============================================================================

// Compute sort key for a card: (suit << 4) | rank
// This allows single-byte comparison instead of two comparisons.
// Max value = 3*16 + 13 = 61, fits in u8
fn card_sort_key(idx: u8) -> u8 {
    let suit: u8 = CARDS[idx].suit as u8;
    let key: u8 = suit << 4;  // suit * 16
    return key + CARDS[idx].rank as u8;
}

// Returns 1 if card[a] > card[b], else 0
fn card_greater(a: u8, b: u8) -> u8 {
    let key_a: u8 = card_sort_key(a);
    let key_b: u8 = card_sort_key(b);

    if key_a > key_b {
        return 1;
    }
    return 0;
}

// ============================================================================
// Swap Function
// ============================================================================

fn swap_cards(i: u8, j: u8) {
    // Save card[i] to temp
    TEMP_CARD.suit = CARDS[i].suit;
    TEMP_CARD.rank = CARDS[i].rank;

    // Copy card[j] to card[i]
    CARDS[i].suit = CARDS[j].suit;
    CARDS[i].rank = CARDS[j].rank;

    // Copy temp to card[j]
    CARDS[j].suit = TEMP_CARD.suit;
    CARDS[j].rank = TEMP_CARD.rank;
}

// ============================================================================
// Quicksort Implementation
// ============================================================================

// Partition: rearrange so elements <= pivot are left of pivot
// Returns final pivot position
fn partition(low: u8, high: u8) -> u8 {
    // Pivot is the last element
    let pivot_idx: u8 = high;
    let mut i: u8 = low;
    let mut j: u8 = low;

    while j < high {
        // If card[j] <= pivot (i.e., pivot > card[j])
        let cmp: u8 = card_greater(pivot_idx, j);
        if cmp == 1 {
            // card[j] < pivot, swap to left partition
            swap_cards(i, j);
            i++;
        }
        j++;
    }

    // Place pivot in its final position
    swap_cards(i, high);
    return i;
}

// Recursive quicksort
// Note: Recursion on 6502 uses hardware stack - keep arrays small!
// For 8 elements, max recursion depth is ~3, using ~12 bytes of stack.
fn quicksort(low: u8, high: u8) {
    if low < high {
        let pivot: u8 = partition(low, high);

        // Sort left partition (low to pivot-1)
        // Guard against underflow when pivot == 0
        if pivot > low {
            let pivot_minus_1: u8 = pivot - 1;
            quicksort(low, pivot_minus_1);
        }

        // Sort right partition (pivot+1 to high)
        if pivot < high {
            let pivot_plus_1: u8 = pivot + 1;
            quicksort(pivot_plus_1, high);
        }
    }
}

// ============================================================================
// Entry Point
// ============================================================================

#[entry]
fn main() -> ! {
    // Sort the hand of cards (initialized in CARDS declaration)
    // Array indices are 0 to HAND_SIZE-1 (0 to 7)
    quicksort(0, 7);

    // After sorting, cards will be ordered by suit, then rank:
    //
    // Suit order: Hearts < Diamonds < Clubs < Spades
    // Rank order: Ace < 2 < ... < 10 < Jack < Queen < King
    //
    // Result:
    // Index 0: 2 of Hearts
    // Index 1: King of Hearts
    // Index 2: 5 of Diamonds
    // Index 3: Jack of Diamonds
    // Index 4: Ace of Clubs
    // Index 5: Queen of Clubs
    // Index 6: Ace of Spades
    // Index 7: 7 of Spades
}
