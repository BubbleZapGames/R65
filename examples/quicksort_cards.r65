// Quicksort Demo - Sorting Playing Cards
// Demonstrates: arrays, recursion, comparisons, bit manipulation
//
// This example sorts a hand of playing cards first by suit, then by rank.
// It showcases R65's support for recursive algorithms on the 65816 processor.
//
// Note: Uses parallel arrays for suits and ranks to work around a type
// checker limitation with array[index].field assignments.

// ============================================================================
// Card Definitions
// ============================================================================

// Suit values: Hearts=0, Diamonds=1, Clubs=2, Spades=3
// Rank values: Ace=1, 2-10, Jack=11, Queen=12, King=13

// ============================================================================
// Memory Layout
// ============================================================================

const HAND_SIZE: u8 = 8;

// Parallel arrays for card data
#[ram]
static mut SUITS: [u8; 8];

#[ram]
static mut RANKS: [u8; 8];

// Temp storage for swapping (cheaper than stack on 6502)
#[zeropage(0x10)]
static mut TEMP_SUIT: u8;

#[zeropage(0x11)]
static mut TEMP_RANK: u8;

// Scratch registers for compiler temporaries
#[zeropage(0x12, register)]
static mut SCRATCH0: u8;

#[zeropage(0x14, register)]
static mut SCRATCH1: u16;

// ============================================================================
// Initialization
// ============================================================================

// Initialize the hand with 8 unsorted cards
#[mode(m8, x8)]
fn init_hand() {
    // Card 0: 7 of Spades (suit=3, rank=7)
    SUITS[0] = 3;
    RANKS[0] = 7;

    // Card 1: King of Hearts (suit=0, rank=13)
    SUITS[1] = 0;
    RANKS[1] = 13;

    // Card 2: Ace of Clubs (suit=2, rank=1)
    SUITS[2] = 2;
    RANKS[2] = 1;

    // Card 3: 2 of Hearts (suit=0, rank=2)
    SUITS[3] = 0;
    RANKS[3] = 2;

    // Card 4: Jack of Diamonds (suit=1, rank=11)
    SUITS[4] = 1;
    RANKS[4] = 11;

    // Card 5: Ace of Spades (suit=3, rank=1)
    SUITS[5] = 3;
    RANKS[5] = 1;

    // Card 6: 5 of Diamonds (suit=1, rank=5)
    SUITS[6] = 1;
    RANKS[6] = 5;

    // Card 7: Queen of Clubs (suit=2, rank=12)
    SUITS[7] = 2;
    RANKS[7] = 12;
}

// ============================================================================
// Comparison Function
// ============================================================================

// Compute sort key for a card: (suit << 4) | rank
// This allows single-byte comparison instead of two comparisons.
// Max value = 3*16 + 13 = 61, fits in u8
#[mode(m8, x8)]
fn card_sort_key(idx @ X: u8) -> u8 {
    let suit @ A = SUITS[idx];
    A = A << 4;  // suit * 16
    A = A + RANKS[idx];
    return A;
}

// Returns 1 if card[a] > card[b], else 0
#[mode(m8, x8)]
fn card_greater(a: u8, b: u8) -> u8 {
    X = a;
    let key_a @ A = card_sort_key(X);
    TEMP_SUIT = A;  // Stash key_a temporarily

    X = b;
    let key_b @ A = card_sort_key(X);

    // Compare: key_a > key_b ?
    if TEMP_SUIT > A {
        return 1;
    }
    return 0;
}

// ============================================================================
// Swap Function
// ============================================================================

#[mode(m8, x8)]
fn swap_cards(i: u8, j: u8) {
    // Save card[i] to temp
    X = i;
    TEMP_SUIT = SUITS[i];
    TEMP_RANK = RANKS[i];

    // Copy card[j] to card[i]
    Y = j;
    A = SUITS[j];
    SUITS[i] = A;
    A = RANKS[j];
    RANKS[i] = A;

    // Copy temp to card[j]
    SUITS[j] = TEMP_SUIT;
    RANKS[j] = TEMP_RANK;
}

// ============================================================================
// Quicksort Implementation
// ============================================================================

// Partition: rearrange so elements <= pivot are left of pivot
// Returns final pivot position
#[mode(m8, x8)]
fn partition(low: u8, high: u8) -> u8 {
    // Pivot is the last element
    let pivot_idx: u8 = high;
    let mut i: u8 = low;
    let mut j: u8 = low;

    while j < high {
        // If card[j] <= pivot (i.e., pivot > card[j])
        let cmp @ A = card_greater(pivot_idx, j);
        if A == 1 {
            // card[j] < pivot, swap to left partition
            swap_cards(i, j);
            i++;
        }
        j++;
    }

    // Place pivot in its final position
    swap_cards(i, high);
    return i;
}

// Recursive quicksort
// Note: Recursion on 6502 uses hardware stack - keep arrays small!
// For 8 elements, max recursion depth is ~3, using ~12 bytes of stack.
#[mode(m8, x8)]
fn quicksort(low: u8, high: u8) {
    if low < high {
        let pivot @ A = partition(low, high);

        // Sort left partition (low to pivot-1)
        // Guard against underflow when pivot == 0
        if pivot > low {
            let pivot_minus_1: u8 = pivot - 1;
            quicksort(low, pivot_minus_1);
        }

        // Sort right partition (pivot+1 to high)
        if pivot < high {
            let pivot_plus_1: u8 = pivot + 1;
            quicksort(pivot_plus_1, high);
        }
    }
}

// ============================================================================
// Entry Point
// ============================================================================

#[entry]
#[mode(m8, x8)]
fn main() -> ! {
    // Initialize the unsorted hand
    init_hand();

    // Sort the hand of cards
    // Array indices are 0 to HAND_SIZE-1 (0 to 7)
    quicksort(0, 7);

    // After sorting, cards will be ordered by suit, then rank:
    //
    // Suit order: Hearts(0) < Diamonds(1) < Clubs(2) < Spades(3)
    // Rank order: Ace(1) < 2 < ... < 10 < Jack(11) < Queen(12) < King(13)
    //
    // Result:
    // Index 0: 2 of Hearts      (suit=0, rank=2)
    // Index 1: King of Hearts   (suit=0, rank=13)
    // Index 2: 5 of Diamonds    (suit=1, rank=5)
    // Index 3: Jack of Diamonds (suit=1, rank=11)
    // Index 4: Ace of Clubs     (suit=2, rank=1)
    // Index 5: Queen of Clubs   (suit=2, rank=12)
    // Index 6: Ace of Spades    (suit=3, rank=1)
    // Index 7: 7 of Spades      (suit=3, rank=7)

    loop {
        wai();
    }
}
