// Type checker test - should pass

#[hw(0x2100)]
static mut INIDISP: u8;

#[zeropage(0x20)]
static mut FLAGS: u8 = 0;

#[mode(m8, x8)]
#[preserves(X, Y)]
fn set_flag() {
    let flag @ A = FLAGS;
    flag = flag | 0x80;
    FLAGS = flag;
}

#[mode(m8, x8)]
fn main() -> ! {
    INIDISP = 0x0F;
    loop {
        set_flag();
    }
}
