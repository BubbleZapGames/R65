// Simple test for mode transition

#[zeropage(0x20)]
static mut VALUE: u8 = 0;

// M16 mode function with transition=caller
#[mode(m16, x16, transition=caller)]
fn func_m16() {
    A = 0x1234;
}

// M8 mode caller
#[mode(m8, x8)]
fn caller() {
    A = 0x42;
    func_m16();  // Mixed mode call with transition=caller
    VALUE = A;
}
