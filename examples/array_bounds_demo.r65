// Example demonstrating constant index bounds checking in R65

#[ram]
static mut BUFFER: [u8; 256] = [0; 256];

const BUFFER_SIZE: u16 = 256;
const LAST_INDEX: u16 = BUFFER_SIZE - 1;  // 255

fn main() {
    // === Valid constant indices (compile-time checked) ===
    BUFFER[0] = 42;           // OK - within bounds
    BUFFER[255] = 99;          // OK - within bounds
    BUFFER[BUFFER_SIZE - 1] = 77;  // OK - constant expression
    BUFFER[LAST_INDEX] = 88;       // OK - constant expression
    
    // === Invalid constant indices (compile-time errors) ===
    // BUFFER[256] = 1;      // COMPILE ERROR: index 256 >= array size 256
    // BUFFER[300] = 5;      // COMPILE ERROR: index 300 >= array size 256
    // BUFFER[-1] = 10;      // COMPILE ERROR: negative index
    // BUFFER[BUFFER_SIZE] = 0;  // COMPILE ERROR: index 256 >= array size 256
    
    // === Dynamic indices (no bounds checking) ===
    let index = 128;
    BUFFER[index] = 200;      // OK - dynamic index, no check
    
    let offset = A + 1;
    BUFFER[offset] = 150;     // OK - dynamic expression, no check
    
    // Programmer is responsible for ensuring dynamic indices are valid
    if index < BUFFER_SIZE {
        BUFFER[index] = BUFFER[index] + 1;
    }
}

fn safe_write(buffer_index: u16, value: u8) {
    // Example of manual bounds checking for dynamic indices
    if buffer_index < BUFFER_SIZE {
        BUFFER[buffer_index] = value;
    }
    // Silently ignore out-of-bounds writes (alternative: return error)
}

fn safe_read(buffer_index: u16) -> u8 {
    // Example of safe reading with error handling
    if buffer_index >= BUFFER_SIZE {
        return 0xFF;  // Error indicator
    }
    return BUFFER[buffer_index];
}

// Hardware register example
#[hw(0x2100)]
static mut INIDISP: u8;

fn vblank_handler() {
    // Constant index access to buffer
    BUFFER[0] = FRAME_COUNT;   // OK - constant index 0
    
    // Dynamic index based on hardware state
    let brightness = INIDISP;
    BUFFER[brightness] = brightness;  // OK - dynamic index
}

#[zeropage]
static mut FRAME_COUNT: u8 = 0;