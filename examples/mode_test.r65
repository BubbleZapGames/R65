// Test mode tracking through MIR CFG (without SEP/REP for now)

#[zeropage(0x20)]
static mut VALUE16: u16 = 0;

#[zeropage(0x22)]
static mut VALUE8: u8 = 0;

// Test 1: Simple mode attribute tracking
#[mode(m8, x8)]
fn simple_m8() {
    A = 0xFF;
}

#[mode(m16, x16)]
fn simple_m16() {
    A = 0xFFFF;
}

// Test 2: Conditional control flow (mode stays same)
#[mode(m8, x8)]
fn conditional_same_mode(flag @ A: u8) {
    if flag == 0 {
        A = 0x10;
    } else {
        A = 0x42;
    }
    // Both branches in m8 mode
    A = 0x33;
}

// Test 3: Loop (mode stays same)
#[mode(m8, x8)]
fn loop_same_mode() {
    let mut count @ A = 0;

    loop {
        A = A + 1;
        if count == 10 {
            break;
        }
    }
}

// Test 4: Nested control flow
#[mode(m8, x8)]
fn nested(flag: u8) {
    if flag > 0 {
        if flag > 5 {
            A = 0x10;
        } else {
            A = 0x20;
        }
    }
    A = 0x42;
}

// Test 5: m16 mode function
#[mode(m16, x8)]
fn process_16bit() {
    A = 0x1234;
    X = 0x56;
}

// Test 6: x16 mode function
#[mode(m8, x16)]
fn process_index16() {
    A = 0x12;
    X = 0x3456;
}

// Test 7: Full 16-bit mode
#[mode(m16, x16)]
fn full_16bit() {
    A = 0x1234;
    X = 0x5678;
    Y = 0x9ABC;
}

// Test 8: Function with default m8/x8 mode
#[mode(m8, x8)]
fn default_mode() {
    A = 0x12;
}

// Test 9: Complex CFG with multiple paths
#[mode(m8, x8)]
fn complex_cfg(a: u8, b: u8) -> u8 {
    let mut result: u8 = 0;

    if a > 0 {
        if b > 0 {
            result = a + b;
        } else {
            result = a;
        }
    } else {
        if b > 0 {
            result = b;
        } else {
            result = 0;
        }
    }

    return result;
}
