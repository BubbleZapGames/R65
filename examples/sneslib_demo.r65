// SNES Library Demo
// Demonstrates usage of sneslib.r65 macros and functions

#[snesrom(name="SNESLIB DEMO", fastrom)]
#[bank(0)]

include!("../stdlib/sneslib.r65")

// RAM variables
#[zeropage]
static mut FRAME_COUNT: u16;

#[zeropage]
static mut SCROLL_X: u16;

#[zeropage]
static mut SCROLL_Y: u16;

// Tile data in ROM
static TILE_DATA: [u8; 32] = [
    0x00, 0x00, 0x7E, 0x7E, 0x42, 0x42, 0x42, 0x42,
    0x42, 0x42, 0x42, 0x42, 0x7E, 0x7E, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
];

// Tilemap data in ROM
static TILEMAP_DATA: [u8; 64] = [
    0x01, 0x00, 0x01, 0x00, 0x01, 0x00, 0x01, 0x00,
    0x01, 0x00, 0x01, 0x00, 0x01, 0x00, 0x01, 0x00,
    0x01, 0x00, 0x01, 0x00, 0x01, 0x00, 0x01, 0x00,
    0x01, 0x00, 0x01, 0x00, 0x01, 0x00, 0x01, 0x00,
    0x01, 0x00, 0x01, 0x00, 0x01, 0x00, 0x01, 0x00,
    0x01, 0x00, 0x01, 0x00, 0x01, 0x00, 0x01, 0x00,
    0x01, 0x00, 0x01, 0x00, 0x01, 0x00, 0x01, 0x00,
    0x01, 0x00, 0x01, 0x00, 0x01, 0x00, 0x01, 0x00
];

// Palette data (blue color)
static PALETTE_DATA: [u8; 4] = [
    0x00, 0x00,  // Color 0: Black (transparent)
    0x1F, 0x7C   // Color 1: Blue
];

#[entry]
fn main() {
    // Disable screen during setup
    screen_off!();

    // Initialize hardware
    clear_vram();
    clear_cgram();
    clear_oam();

    // Set video mode 1 (4bpp BG1, 4bpp BG2, 2bpp BG3)
    set_bgmode!(1, 0);

    // Configure BG1 tilemap at VRAM $0000, 32x32 tiles
    set_bg1_map!(0x00, 0);

    // Configure BG1 character data at VRAM $1000 (8KB unit 2 = $1000 words)
    set_bg12_chr!(2, 0);

    // Upload tile data to VRAM using DMA channel 0
    dma_vram!(0, &TILE_DATA, 0, 0x1000, 32);

    // Upload tilemap data to VRAM
    dma_vram!(0, &TILEMAP_DATA, 0, 0x0000, 64);

    // Upload palette data to CGRAM
    dma_cgram!(0, &PALETTE_DATA, 0, 0, 4);

    // Set backdrop color (dark gray)
    set_backdrop!(0x0842);

    // Initialize scroll positions
    SCROLL_X = 0;
    SCROLL_Y = 0;
    set_bg1_hscroll!(0);
    set_bg1_vscroll!(0);

    // Enable BG1 on main screen
    enable_main!(SCREEN_BG1);

    // Turn screen on at full brightness
    screen_on!(15);

    // Initialize frame counter
    FRAME_COUNT = 0;

    // Main loop
    loop {
        // Wait for vblank
        wait_nmi();

        // Update frame counter
        FRAME_COUNT = FRAME_COUNT + 1;

        // Scroll background slowly
        if FRAME_COUNT & 0x03 == 0 {
            SCROLL_X = SCROLL_X + 1;
        }

        // Update scroll registers
        set_bg1_hscroll!(SCROLL_X);
    }
}

// NMI handler (called during vblank)
#[interrupt(nmi)]
fn nmi_handler() {
    // Read RDNMI to acknowledge NMI
    A = RDNMI;
}
