// Test transition=caller

#[zeropage(0x20)]
static mut VALUE: u8 = 0;

#[mode(m8, x8)]
fn process_8bit() {
    A = 0x42;
    VALUE = A;
}

#[mode(m16, x16, transition=caller)]
fn process_16bit() {
    A = 0x1234;
}

#[mode(m8, x8)]
fn caller_8bit() {
    process_8bit();
    process_16bit();
}

#[mode(m8, x8)]
fn main() -> ! {
    caller_8bit();
    loop {
        process_8bit();
    }
}
