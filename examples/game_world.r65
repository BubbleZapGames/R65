// Game World Simulation
// Demonstrates: enums, structs, arrays, pathfinding, state machines, collision detection
//
// This example implements a tile-based game world with entities that have AI
// behaviors including patrolling, chasing, and attacking. Uses BFS pathfinding.

#[snesrom(name="GAME WORLD DEMO")]

// ============================================================================
// ENUMS - Entity types, directions, AI states, tile types
// ============================================================================

// Entity types in the game world
enum EntityType {
    Empty = 0,      // No entity (slot available)
    Player = 1,     // Player-controlled entity
    Enemy = 2,      // Enemy AI entity
    Item = 3,       // Collectible item
    Projectile = 4  // Moving projectile
}

// Directions for movement and pathfinding
enum Direction {
    None = 0,
    North = 1,
    East = 2,
    South = 3,
    West = 4
}

// Entity AI states (state machine)
enum AIState {
    Idle = 0,       // Standing still
    Patrol = 1,     // Random wandering
    Chase = 2,      // Pursuing target
    Flee = 3,       // Running away
    Attack = 4      // Attacking target
}

// Tile types for the game map
enum TileType {
    Floor = 0,      // Walkable floor
    Wall = 1,       // Blocking wall
    Water = 2,      // Damaging water
    Door = 3        // Conditional passage
}

// ============================================================================
// STRUCTS - Position, Entity, Queue node
// ============================================================================

// Position on the grid (2 bytes)
struct Position {
    x: u8,
    y: u8
}

// Entity representation (8 bytes)
struct Entity {
    x: u8,          // Current X position
    y: u8,          // Current Y position
    entity_type: u8,// EntityType
    state: u8,      // AIState
    health: u8,     // Current health
    target_x: u8,   // Target position for pathfinding
    target_y: u8,   // Target position for pathfinding
    timer: u8       // State timer/cooldown
}

// BFS queue node for pathfinding (3 bytes)
struct QueueNode {
    x: u8,
    y: u8,
    dist: u8
}

// ============================================================================
// CONSTANTS
// ============================================================================

// Grid dimensions (keep small for memory)
const GRID_WIDTH: u8 = 16;
const GRID_HEIGHT: u8 = 12;
const GRID_SIZE: u16 = 192;  // 16 * 12

// Entity limits
const MAX_ENTITIES: u8 = 8;
const ENTITY_SIZE: u8 = 8;

// Pathfinding queue (for BFS)
const QUEUE_SIZE: u8 = 64;

// LFSR seed for PRNG
const LFSR_SEED: u16 = 0xACE1;

// Gameplay constants
const SIGHT_RANGE: u8 = 5;
const ATTACK_RANGE: u8 = 1;
const PATROL_TIMER: u8 = 30;
const IDLE_TIMER: u8 = 60;
const ATTACK_COOLDOWN: u8 = 20;

// Max ticks for simulation
const MAX_TICKS: u8 = 100;

// ============================================================================
// ZERO-PAGE VARIABLES - Fast access memory
// ============================================================================

// Scratch registers for compiler temporaries
#[zeropage(0x10, register)]
static mut SCRATCH0: u8;

#[zeropage(0x12, register)]
static mut SCRATCH1: u16;

// PRNG state (16-bit LFSR)
#[zeropage(0x14)]
static mut RNG_STATE: u16 = LFSR_SEED;

// Temporary variables for pathfinding
#[zeropage(0x16)]
static mut TEMP_X: u8;

#[zeropage(0x17)]
static mut TEMP_Y: u8;

#[zeropage(0x18)]
static mut TEMP_DIST: u8;

// BFS queue pointers
#[zeropage(0x19)]
static mut QUEUE_HEAD: u8 = 0;

#[zeropage(0x1A)]
static mut QUEUE_TAIL: u8 = 0;

// Current entity being processed
#[zeropage(0x1B)]
static mut CURRENT_ENTITY: u8 = 0;

// Frame counter for timing
#[zeropage(0x1C)]
static mut TICK_COUNT: u8 = 0;

// Pathfinding result
#[zeropage(0x1D)]
static mut PATH_RESULT: u8 = 0;

// Temporary entity storage
#[zeropage(0x20)]
static mut TEMP_ENTITY: Entity;

// ============================================================================
// RAM VARIABLES - Main memory arrays
// ============================================================================

// Tile map grid (192 bytes = 16x12)
#[ram]
static mut TILE_MAP: [u8; 192] = [0; 192];

// Entity array (8 entities * 8 bytes = 64 bytes)
#[ram]
static mut ENTITIES: [Entity; 8] = [
    Entity { x: 0, y: 0, entity_type: 0, state: 0, health: 0, target_x: 0, target_y: 0, timer: 0 },
    Entity { x: 0, y: 0, entity_type: 0, state: 0, health: 0, target_x: 0, target_y: 0, timer: 0 },
    Entity { x: 0, y: 0, entity_type: 0, state: 0, health: 0, target_x: 0, target_y: 0, timer: 0 },
    Entity { x: 0, y: 0, entity_type: 0, state: 0, health: 0, target_x: 0, target_y: 0, timer: 0 },
    Entity { x: 0, y: 0, entity_type: 0, state: 0, health: 0, target_x: 0, target_y: 0, timer: 0 },
    Entity { x: 0, y: 0, entity_type: 0, state: 0, health: 0, target_x: 0, target_y: 0, timer: 0 },
    Entity { x: 0, y: 0, entity_type: 0, state: 0, health: 0, target_x: 0, target_y: 0, timer: 0 },
    Entity { x: 0, y: 0, entity_type: 0, state: 0, health: 0, target_x: 0, target_y: 0, timer: 0 }
];

// BFS queue for pathfinding (64 * 3 = 192 bytes)
// Uninitialized - cleared at runtime
#[ram]
static mut BFS_QUEUE: [QueueNode; 64];

// Visited array for pathfinding (192 bytes = 16x12)
#[ram]
static mut VISITED: [u8; 192] = [0; 192];

// Direction map from pathfinding (stores direction to reach each cell)
#[ram]
static mut DIR_MAP: [u8; 192] = [0; 192];

// ============================================================================
// MACROS
// ============================================================================

// Calculate array index from (x, y) position: y * GRID_WIDTH + x
macro_rules! grid_index($x:expr, $y:expr) {
    (($y as u16) << 4) + ($x as u16)
}

// Check if position is in bounds
macro_rules! in_bounds($x:expr, $y:expr) {
    ($x < GRID_WIDTH && $y < GRID_HEIGHT)
}

// ============================================================================
// RANDOM NUMBER GENERATOR
// ============================================================================

// Generate random byte using 16-bit Galois LFSR
// Polynomial: x^16 + x^14 + x^13 + x^11 + 1 (feedback = 0xB400)
fn random() -> u8 {
    let low @ A = RNG_STATE as u8;
    let bit @ A = low & 0x01;

    // Shift right by 1
    RNG_STATE = RNG_STATE >> 1;

    // Apply feedback if LSB was 1
    if bit != 0 {
        RNG_STATE = RNG_STATE ^ 0xB400;
    }

    // Return low byte
    A = RNG_STATE as u8;
    return A;
}

// Generate random number in range [0, max)
fn random_range(max: u8) -> u8 {
    let r @ A = random();
    // Simple modulo approximation: mask to power of 2, retry if >= max
    // For simplicity, just use bitwise AND with largest power of 2 <= max
    A = A & 0x0F;  // Range 0-15
    while A >= max {
        A = A - max;
    }
    return A;
}

// ============================================================================
// POSITION AND TILE UTILITIES
// ============================================================================

// Get tile at position (x, y)
fn get_tile(x @ A: u8, y: u8) -> u8 {
    // Bounds check
    if A >= GRID_WIDTH {
        return TileType::Wall as u8;
    }
    if y >= GRID_HEIGHT {
        return TileType::Wall as u8;
    }

    // Calculate index: y * 16 + x
    Y = (y as u16) << 4;
    Y = Y + (A as u16);
    A = TILE_MAP[Y];
    return A;
}

// Set tile at position (x, y)
fn set_tile(x: u8, y: u8, tile @ A: u8) {
    // Bounds check
    if x >= GRID_WIDTH {
        return;
    }
    if y >= GRID_HEIGHT {
        return;
    }

    // Calculate index
    X = (y as u16) << 4;
    X = X + (x as u16);
    TILE_MAP[X] = A;
}

// Check if tile at (x, y) is walkable
fn is_walkable(x @ A: u8, y: u8) -> u8 {
    let tile @ A = get_tile(A, y);
    if A == TileType::Floor as u8 {
        return 1;
    }
    if A == TileType::Door as u8 {
        return 1;
    }
    return 0;
}

// Calculate Manhattan distance between two points
fn manhattan_distance(x1: u8, y1: u8, x2: u8, y2: u8) -> u8 {
    let mut dx: u8 = 0;
    let mut dy: u8 = 0;

    // Calculate |x1 - x2|
    if x1 >= x2 {
        dx = x1 - x2;
    } else {
        dx = x2 - x1;
    }

    // Calculate |y1 - y2|
    if y1 >= y2 {
        dy = y1 - y2;
    } else {
        dy = y2 - y1;
    }

    A = dx + dy;
    return A;
}

// Get opposite direction
fn opposite_direction(dir @ A: u8) -> u8 {
    if A == Direction::North as u8 {
        return Direction::South as u8;
    }
    if A == Direction::South as u8 {
        return Direction::North as u8;
    }
    if A == Direction::East as u8 {
        return Direction::West as u8;
    }
    if A == Direction::West as u8 {
        return Direction::East as u8;
    }
    return Direction::None as u8;
}

// Apply direction offset to position, returns new position in TEMP_X/TEMP_Y
fn apply_direction(x @ A: u8, y: u8, dir: u8) {
    TEMP_X = A;
    TEMP_Y = y;

    if dir == Direction::North as u8 {
        if y > 0 {
            TEMP_Y = y - 1;
        }
    } else if dir == Direction::South as u8 {
        if y < GRID_HEIGHT - 1 {
            TEMP_Y = y + 1;
        }
    } else if dir == Direction::East as u8 {
        if A < GRID_WIDTH - 1 {
            TEMP_X = A + 1;
        }
    } else if dir == Direction::West as u8 {
        if A > 0 {
            TEMP_X = A - 1;
        }
    }
}

// ============================================================================
// BFS PATHFINDING
// ============================================================================

// Clear visited array for new pathfinding search
fn clear_visited() {
    for i in 0..192 {
        VISITED[i] = 0;
    }
}

// Clear direction map
fn clear_dir_map() {
    for i in 0..192 {
        DIR_MAP[i] = 0;
    }
}

// Mark position as visited
fn mark_visited(x @ A: u8, y: u8) {
    if A >= GRID_WIDTH {
        return;
    }
    if y >= GRID_HEIGHT {
        return;
    }

    Y = (y as u16) << 4;
    Y = Y + (A as u16);
    VISITED[Y] = 1;
}

// Check if position is visited
fn is_visited(x @ A: u8, y: u8) -> u8 {
    if A >= GRID_WIDTH {
        return 1;  // Out of bounds = visited
    }
    if y >= GRID_HEIGHT {
        return 1;
    }

    Y = (y as u16) << 4;
    Y = Y + (A as u16);
    A = VISITED[Y];
    return A;
}

// Set direction to reach cell
fn set_dir(x @ A: u8, y: u8, dir: u8) {
    if A >= GRID_WIDTH {
        return;
    }
    if y >= GRID_HEIGHT {
        return;
    }

    Y = (y as u16) << 4;
    Y = Y + (A as u16);
    DIR_MAP[Y] = dir;
}

// Get direction stored for cell
fn get_dir(x @ A: u8, y: u8) -> u8 {
    if A >= GRID_WIDTH {
        return Direction::None as u8;
    }
    if y >= GRID_HEIGHT {
        return Direction::None as u8;
    }

    Y = (y as u16) << 4;
    Y = Y + (A as u16);
    A = DIR_MAP[Y];
    return A;
}

// Enqueue a node in the BFS queue
fn bfs_enqueue(x @ A: u8, y: u8, dist: u8) {
    Y = QUEUE_TAIL as u16;
    if Y >= QUEUE_SIZE as u16 {
        return;  // Queue full
    }

    BFS_QUEUE[Y].x = A;
    BFS_QUEUE[Y].y = y;
    BFS_QUEUE[Y].dist = dist;
    QUEUE_TAIL++;
}

// Dequeue a node from BFS queue (result in TEMP_X, TEMP_Y, TEMP_DIST)
fn bfs_dequeue() -> u8 {
    let head: u8 = QUEUE_HEAD;
    let tail: u8 = QUEUE_TAIL;

    if head >= tail {
        return 0;  // Queue empty
    }

    X = head as u16;
    TEMP_X = BFS_QUEUE[X].x;
    TEMP_Y = BFS_QUEUE[X].y;
    TEMP_DIST = BFS_QUEUE[X].dist;
    QUEUE_HEAD++;
    return 1;
}

// Find path using BFS from (start_x, start_y) to (target_x, target_y)
// Returns the direction to move from start, or Direction::None if no path
fn find_path(start_x: u8, start_y: u8, target_x: u8, target_y: u8) -> u8 {
    // Initialize queue
    QUEUE_HEAD = 0;
    QUEUE_TAIL = 0;

    // Clear visited and direction maps
    clear_visited();
    clear_dir_map();

    // Check if already at target
    if start_x == target_x {
        if start_y == target_y {
            return Direction::None as u8;
        }
    }

    // Enqueue start position
    bfs_enqueue(start_x, start_y, 0);
    mark_visited(start_x, start_y);

    // BFS loop
    while QUEUE_HEAD < QUEUE_TAIL {
        // Dequeue front
        let ok @ A = bfs_dequeue();
        if A == 0 {
            break;
        }

        let curr_x: u8 = TEMP_X;
        let curr_y: u8 = TEMP_Y;
        let curr_dist: u8 = TEMP_DIST;

        // Try all 4 directions
        let mut dir: u8 = 1;  // Start with North
        while dir <= 4 {
            apply_direction(curr_x, curr_y, dir);
            let nx: u8 = TEMP_X;
            let ny: u8 = TEMP_Y;

            // Check if position changed (valid move)
            if nx != curr_x || ny != curr_y {
                // Check if walkable and not visited
                let walk @ A = is_walkable(nx, ny);
                if A != 0 {
                    let vis @ A = is_visited(nx, ny);
                    if A == 0 {
                        // Mark visited and store direction we came from
                        mark_visited(nx, ny);
                        let opp_dir @ A = opposite_direction(dir);
                        set_dir(nx, ny, A);

                        // Check if target reached
                        if nx == target_x {
                            if ny == target_y {
                                // Backtrack to find first move direction
                                return backtrack_path(start_x, start_y, target_x, target_y);
                            }
                        }

                        // Enqueue neighbor
                        let new_dist: u8 = curr_dist + 1;
                        bfs_enqueue(nx, ny, new_dist);
                    }
                }
            }

            dir++;
        }
    }

    // No path found
    return Direction::None as u8;
}

// Backtrack from target to start to find first direction to move
fn backtrack_path(start_x: u8, start_y: u8, target_x: u8, target_y: u8) -> u8 {
    let mut cx: u8 = target_x;
    let mut cy: u8 = target_y;
    let mut last_dir: u8 = Direction::None as u8;

    // Follow direction map back to start
    let mut steps: u8 = 0;
    while steps < 200 {  // Safety limit
        // Check if at start
        if cx == start_x {
            if cy == start_y {
                // Return opposite of last direction (direction to move forward)
                return opposite_direction(last_dir);
            }
        }

        // Get direction to previous cell
        let dir @ A = get_dir(cx, cy);
        if A == Direction::None as u8 {
            break;  // Lost path
        }

        last_dir = A;

        // Move to previous cell
        apply_direction(cx, cy, A);
        cx = TEMP_X;
        cy = TEMP_Y;

        steps++;
    }

    return Direction::None as u8;
}

// ============================================================================
// COLLISION DETECTION
// ============================================================================

// Check for entity collision at position (excluding entity at index exclude)
// Returns entity index if collision, 0xFF if none
fn check_entity_collision(x @ A: u8, y: u8, exclude: u8) -> u8 {
    let check_x: u8 = A;
    let check_y: u8 = y;

    let mut i: u8 = 0;
    while i < MAX_ENTITIES {
        // Skip excluded entity
        if i != exclude {
            X = i as u16;
            // Check if entity exists
            if ENTITIES[X].entity_type != EntityType::Empty as u8 {
                // Check position match
                if ENTITIES[X].x == check_x {
                    if ENTITIES[X].y == check_y {
                        return i;
                    }
                }
            }
        }
        i++;
    }

    return 0xFF;  // No collision
}

// Check if position is blocked (tile or entity)
fn is_blocked(x @ A: u8, y: u8, entity_idx: u8) -> u8 {
    let check_x: u8 = A;
    let check_y: u8 = y;

    // Check tile collision
    let walkable @ A = is_walkable(check_x, check_y);
    if A == 0 {
        return 1;  // Blocked by tile
    }

    // Check entity collision
    let col @ A = check_entity_collision(check_x, check_y, entity_idx);
    if A != 0xFF {
        return 1;  // Blocked by entity
    }

    return 0;  // Not blocked
}

// Try to move entity in direction, returns 1 if successful
fn try_move_entity(entity_idx @ A: u8, dir: u8) -> u8 {
    let idx: u8 = A;
    let move_dir: u8 = dir;

    // Get current position
    Y = idx as u16;
    let curr_x @ A = ENTITIES[Y].x;
    let curr_y: u8 = ENTITIES[Y].y;

    // Calculate new position
    apply_direction(A, curr_y, move_dir);
    let new_x: u8 = TEMP_X;
    let new_y: u8 = TEMP_Y;

    // Check if move is valid
    let blocked @ A = is_blocked(new_x, new_y, idx);
    if A != 0 {
        return 0;  // Move blocked
    }

    // Update position
    Y = idx as u16;
    ENTITIES[Y].x = new_x;
    ENTITIES[Y].y = new_y;

    return 1;
}

// ============================================================================
// AI STATE MACHINE
// ============================================================================

// Update entity AI for idle state
fn ai_idle(entity_idx @ A: u8) {
    X = A as u16;

    // Decrement timer
    if ENTITIES[X].timer > 0 {
        ENTITIES[X].timer--;
        return;
    }

    // Timer expired - transition to patrol
    ENTITIES[X].state = AIState::Patrol as u8;
    ENTITIES[X].timer = PATROL_TIMER;
}

// Update entity AI for patrol state
fn ai_patrol(entity_idx @ A: u8) {
    let idx: u8 = A;
    X = A as u16;

    // Check if player is in sight range
    let enemy_x: u8 = ENTITIES[X].x;
    let enemy_y: u8 = ENTITIES[X].y;
    let player_x: u8 = ENTITIES[0].x;
    let player_y: u8 = ENTITIES[0].y;

    let dist @ A = manhattan_distance(enemy_x, enemy_y, player_x, player_y);
    if A <= SIGHT_RANGE {
        // Player spotted - chase!
        X = idx as u16;
        ENTITIES[X].state = AIState::Chase as u8;
        return;
    }

    // Move in random direction
    let dir @ A = random_range(4);
    A = A + 1;  // Convert 0-3 to 1-4 (Direction enum)
    try_move_entity(idx, A);

    // Decrement timer
    X = idx as u16;
    if ENTITIES[X].timer > 0 {
        ENTITIES[X].timer--;
    } else {
        // Switch to idle
        ENTITIES[X].state = AIState::Idle as u8;
        ENTITIES[X].timer = IDLE_TIMER;
    }
}

// Update entity AI for chase state
fn ai_chase(entity_idx @ A: u8) {
    let idx: u8 = A;
    X = A as u16;

    // Get positions
    let enemy_x: u8 = ENTITIES[X].x;
    let enemy_y: u8 = ENTITIES[X].y;
    let player_x: u8 = ENTITIES[0].x;
    let player_y: u8 = ENTITIES[0].y;

    // Calculate distance to player
    let dist @ A = manhattan_distance(enemy_x, enemy_y, player_x, player_y);

    // Check attack range
    if A <= ATTACK_RANGE {
        X = idx as u16;
        ENTITIES[X].state = AIState::Attack as u8;
        return;
    }

    // Check if lost sight
    if A > SIGHT_RANGE {
        X = idx as u16;
        ENTITIES[X].state = AIState::Patrol as u8;
        ENTITIES[X].timer = PATROL_TIMER;
        return;
    }

    // Use pathfinding to move toward player
    let dir @ A = find_path(enemy_x, enemy_y, player_x, player_y);
    if A != Direction::None as u8 {
        try_move_entity(idx, A);
    }
}

// Update entity AI for attack state
fn ai_attack(entity_idx @ A: u8) {
    let idx: u8 = A;
    X = A as u16;

    // Check cooldown timer
    if ENTITIES[X].timer > 0 {
        ENTITIES[X].timer--;
        return;
    }

    // Deal damage to player
    if ENTITIES[0].health > 0 {
        ENTITIES[0].health--;
    }

    // Set attack cooldown
    X = idx as u16;
    ENTITIES[X].timer = ATTACK_COOLDOWN;

    // Check if player still in range
    let enemy_x: u8 = ENTITIES[X].x;
    let enemy_y: u8 = ENTITIES[X].y;
    let player_x: u8 = ENTITIES[0].x;
    let player_y: u8 = ENTITIES[0].y;

    let dist @ A = manhattan_distance(enemy_x, enemy_y, player_x, player_y);
    if A > ATTACK_RANGE {
        X = idx as u16;
        ENTITIES[X].state = AIState::Chase as u8;
    }
}

// Update entity AI for flee state
fn ai_flee(entity_idx @ A: u8) {
    let idx: u8 = A;
    X = A as u16;

    // Get positions
    let enemy_x: u8 = ENTITIES[X].x;
    let enemy_y: u8 = ENTITIES[X].y;
    let player_x: u8 = ENTITIES[0].x;
    let player_y: u8 = ENTITIES[0].y;

    // Calculate distance to player
    let dist @ A = manhattan_distance(enemy_x, enemy_y, player_x, player_y);

    // Check if escaped far enough
    if A > SIGHT_RANGE {
        X = idx as u16;
        ENTITIES[X].state = AIState::Idle as u8;
        ENTITIES[X].timer = IDLE_TIMER;
        return;
    }

    // Find path toward player, then go opposite direction
    let dir @ A = find_path(enemy_x, enemy_y, player_x, player_y);
    if A != Direction::None as u8 {
        let opp @ A = opposite_direction(A);
        try_move_entity(idx, A);
    }
}

// Main AI update dispatcher
fn update_entity_ai(entity_idx @ A: u8) {
    let idx: u8 = A;
    X = A as u16;

    // Only process enemies
    if ENTITIES[X].entity_type != EntityType::Enemy as u8 {
        return;
    }

    // Check if entity is alive
    if ENTITIES[X].health == 0 {
        return;
    }

    // Dispatch based on state
    let state @ A = ENTITIES[X].state;

    if A == AIState::Idle as u8 {
        ai_idle(idx);
    } else if A == AIState::Patrol as u8 {
        ai_patrol(idx);
    } else if A == AIState::Chase as u8 {
        ai_chase(idx);
    } else if A == AIState::Attack as u8 {
        ai_attack(idx);
    } else if A == AIState::Flee as u8 {
        ai_flee(idx);
    }
}

// ============================================================================
// ENTITY MANAGEMENT
// ============================================================================

// Initialize an entity at position
fn init_entity(idx @ A: u8, etype: u8, x: u8, y: u8, health: u8) {
    let entity_idx: u8 = A;

    Y = entity_idx as u16;
    ENTITIES[Y].x = x;
    ENTITIES[Y].y = y;
    ENTITIES[Y].entity_type = etype;
    ENTITIES[Y].state = AIState::Idle as u8;
    ENTITIES[Y].health = health;
    ENTITIES[Y].target_x = x;
    ENTITIES[Y].target_y = y;
    ENTITIES[Y].timer = IDLE_TIMER;
}

// Remove entity (mark as empty)
fn remove_entity(idx @ A: u8) {
    X = A as u16;
    ENTITIES[X].entity_type = EntityType::Empty as u8;
    ENTITIES[X].health = 0;
}

// Update all entities
fn update_all_entities() {
    let mut i: u8 = 1;  // Start from 1 to skip player
    while i < MAX_ENTITIES {
        update_entity_ai(i);
        i++;
    }
}

// ============================================================================
// MAP GENERATION
// ============================================================================

// Fill map with floor tiles
fn fill_floor() {
    for i in 0..192 {
        TILE_MAP[i] = TileType::Floor as u8;
    }
}

// Place walls around border
fn place_border_walls() {
    // Top and bottom rows
    for x in 0..16 {
        TILE_MAP[x] = TileType::Wall as u8;  // Top row (y=0)

        // Bottom row (y=11, index = 11*16 + x = 176 + x)
        Y = 176 + x;
        TILE_MAP[Y] = TileType::Wall as u8;
    }

    // Left and right columns
    for y in 0..12 {
        // Left column (x=0)
        X = y << 4;
        TILE_MAP[X] = TileType::Wall as u8;

        // Right column (x=15)
        X = X + 15;
        TILE_MAP[X] = TileType::Wall as u8;
    }
}

// Place some random interior walls
fn place_random_walls(count @ A: u8) {
    let mut remaining: u8 = A;

    while remaining > 0 {
        // Generate random position (avoiding borders)
        let x @ A = random_range(14);
        A = A + 1;  // Range 1-14
        let wall_x: u8 = A;

        let y @ A = random_range(10);
        A = A + 1;  // Range 1-10
        let wall_y: u8 = A;

        // Don't place walls on entities
        let col @ A = check_entity_collision(wall_x, wall_y, 0xFF);
        if A == 0xFF {
            set_tile(wall_x, wall_y, TileType::Wall as u8);
            remaining--;
        }
    }
}

// Generate the game map
fn generate_map() {
    fill_floor();
    place_border_walls();
    place_random_walls(10);  // Add 10 random walls
}

// ============================================================================
// GAME INITIALIZATION AND LOOP
// ============================================================================

// Initialize game state
fn game_init() {
    // Initialize player at position (2, 2)
    init_entity(0, EntityType::Player as u8, 2, 2, 10);

    // Initialize enemies at various positions
    init_entity(1, EntityType::Enemy as u8, 13, 9, 3);
    init_entity(2, EntityType::Enemy as u8, 8, 5, 3);
    init_entity(3, EntityType::Enemy as u8, 10, 3, 3);

    // Generate map
    generate_map();

    // Reset tick counter
    TICK_COUNT = 0;
}

// Game update tick
fn game_tick() {
    // Update all entity AI
    update_all_entities();

    // Increment tick counter
    TICK_COUNT++;
}

// ============================================================================
// ENTRY POINT
// ============================================================================

#[entry]
fn main() -> ! {
    // Initialize game
    game_init();

    // Run simulation for MAX_TICKS
    while TICK_COUNT < MAX_TICKS {
        game_tick();

        // Check if player died
        if ENTITIES[0].health == 0 {
            break;
        }
    }

    // Store final state in A, X, Y for verification
    A = TICK_COUNT;
    X = ENTITIES[0].health as u16;
    Y = ENTITIES[0].x as u16;

    // Halt
    loop {
        wai();
    }
}
