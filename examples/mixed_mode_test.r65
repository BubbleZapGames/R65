// Test mixed-mode calling with warnings

#[zeropage(0x20)]
static mut VALUE: u8 = 0;

// M8 mode function
#[mode(m8, x8)]
fn process_8bit() {
    A = 0x42;
    VALUE = A;
}

// M16 mode function with transition=none (default)
#[mode(m16, x16)]
fn process_16bit() {
    A = 0x1234;
}

// Caller in M8 mode calling M16 function
#[mode(m8, x8)]
fn caller_8bit() {
    process_8bit();   // OK: same mode
    process_16bit();  // WARNING: mixed mode (m8 → m16), transition=none
}

// Caller in M16 mode calling M8 function
#[mode(m16, x16)]
fn caller_16bit() {
    process_16bit();  // OK: same mode
    process_8bit();   // WARNING: mixed mode (m16 → m8), transition=none
}

// Complex case: call chain with mode changes
#[mode(m8, x8)]
fn main() -> ! {
    caller_8bit();    // OK: same mode
    caller_16bit();   // WARNING: mixed mode (m8 → m16), transition=none

    loop {
        process_8bit();   // OK: same mode
        process_16bit();  // WARNING: mixed mode (m8 → m16), transition=none
    }
}
