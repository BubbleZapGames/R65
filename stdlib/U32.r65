//! 32-bit unsigned integer (`U32`) for the 65816.
//!
//! `U32` is a 4-byte value held as two little-endian 16-bit words. It supports the
//! compound-assignment operators (`+=`, `-=`, `*=`, `/=`), the comparison
//! operators (`==`, `!=`, `<`, `<=`, `>`, `>=`), and `Clone`. Operations with a
//! plain `u16` are available through the `*_u16` methods. All methods avoid
//! explicit `A`-register use for correct m8-mode codegen.
//!
//! ```
//! include!("lib/U32.r65")
//!
//! #[ram] static mut SCORE: U32 = U32!(100000);
//! #[ram] static mut BONUS: U32 = U32!(500);
//!
//! fn award() { SCORE += BONUS; }
//! ```
//!
//! See also `I32` (signed) and `F32` (floating point).

include!("math.r65")

// ============================================================================
// U32 (32-bit Unsigned Integer) Support
// ============================================================================

/// A 32-bit unsigned integer (range `0` to `4294967295`).
///
/// Stored as two little-endian 16-bit words for a packed 4-byte layout.
/// Construct one with the `U32!` macro or `from_u16`.
struct U32 {
    /// Low 16 bits (byte offset 0).
    lo: u16,
    /// High 16 bits (byte offset 2).
    hi: u16
}

/// Builds a `U32` from a compile-time constant.
///
/// Splits the constant into its low and high 16-bit words at compile time, so it
/// can initialize a `static`.
///
/// # Example
/// ```
/// #[ram] static mut SCORE: U32 = U32!(100000);
/// ```
macro_rules! U32($value:expr) {
    U32 { lo: (($value) & 0xFFFF) as u16, hi: ((($value) >> 16) & 0xFFFF) as u16 }
}

// ============================================================================
// Internal Macros
// ============================================================================

// Shift 32-bit value left by 1 bit (no A register usage)
macro_rules! _u32_shl1($lo:expr, $hi:expr) {
    if ($lo & 0x8000) != 0 {
        $lo = $lo + $lo;
        $hi = $hi + $hi;
        $hi = $hi | 1;
    } else {
        $lo = $lo + $lo;
        $hi = $hi + $hi;
    }
}

// Shift 32-bit value right by 1 bit (no A register usage)
macro_rules! _u32_shr1($lo:expr, $hi:expr) {
    if ($hi & 1) != 0 {
        $hi = $hi >> 1;
        $lo = $lo >> 1;
        $lo = $lo | 0x8000;
    } else {
        $hi = $hi >> 1;
        $lo = $lo >> 1;
    }
}

// SNES hardware division step: divides (remainder:byte) by divisor
// Expects byte value already in A. Reads divisor from X.
// Only used within #[cfg(snes)] functions
macro_rules! _hwdiv_step($remainder:expr) {
    WRDIVL = A;
    A = $remainder;
    WRDIVH = A;
    WRDIVB = X;
    // 16 machine cycles after the WRDIVB write: seven NOPs is 14, and the
    // read's own operand fetch supplies the rest. Measured on Mesen against
    // U32::div_u8 -- six gives wrong quotients.
    NOP(7);
}

// First hardware division step (remainder starts at 0)
// Expects byte value already in A. Reads divisor from X.
// Only used within #[cfg(snes)] functions
macro_rules! _hwdiv_first() {
    WRDIVL = A;
    WRDIVH = 0;
    WRDIVB = X;
    // 16 machine cycles after the WRDIVB write: seven NOPs is 14, and the
    // read's own operand fetch supplies the rest. Measured on Mesen against
    // U32::div_u8 -- six gives wrong quotients.
    NOP(7);
}

// ============================================================================
// U32 Implementation
// ============================================================================

impl U32 {
    // ========================================================================
    // Conversion and Copy Methods
    // ========================================================================

    /// Copies `src` into `self`.
    #[inline(always)]
    far fn copy(far *self, src: far *U32) {
        self.lo = src.lo;
        self.hi = src.hi;
    }

    /// Sets `self` to a `u16` value, zero-extended to 32 bits.
    ///
    /// # Parameters
    /// - `value` — the 16-bit value (passed in `X`; `A` is clobbered by the far
    ///   prologue, so `X` is used instead)
    #[inline(always)]
    far fn from_u16(far *self, value @ X: u16) {
        self.lo = X;
        self.hi = 0;
    }

    /// Returns the low 16 bits of `self`, truncating the high word.
    #[inline(always)]
    far fn to_u16(far *self) -> u16 {
        return self.lo;
    }

    // ========================================================================
    // Arithmetic Methods (all modify self in-place)
    // ========================================================================

    /// Adds a `u16` to `self` in place (`self += value`).
    ///
    /// The value is zero-extended to 32 bits; the result wraps on overflow.
    ///
    /// # Parameters
    /// - `value` — amount to add (passed in `A`)
    ///
    /// # Example
    /// ```
    /// SCORE.add_u16(points);
    /// ```
    #[inline(always)]
    far fn add_u16(far *self, value @ A: u16) {
        let s_lo: u16 = self.lo;
        let r_lo: u16 = s_lo + A;
        let mut r_hi: u16 = self.hi;
        if r_lo < A {
            r_hi = r_hi + 1;
        }
        self.lo = r_lo;
        self.hi = r_hi;
    }

    /// Subtracts a `u16` from `self` in place (`self -= value`).
    ///
    /// The value is zero-extended to 32 bits; the result wraps on underflow.
    ///
    /// # Parameters
    /// - `value` — amount to subtract (passed in `A`)
    #[inline(always)]
    far fn sub_u16(far *self, value @ A: u16) {
        let s_lo: u16 = self.lo;
        let r_lo: u16 = s_lo - A;
        let mut r_hi: u16 = self.hi;
        if s_lo < A {
            r_hi = r_hi - 1;
        }
        self.lo = r_lo;
        self.hi = r_hi;
    }

    /// Multiplies `self` by a `u16` in place (`self *= value`).
    ///
    /// Keeps the low 32 bits of the product (wraps on overflow). Uses a software
    /// shift-and-add loop.
    ///
    /// # Parameters
    /// - `value` — multiplier (passed in `A`)
    far fn mul_u16(far *self, value @ A: u16) {
        let mut mplier: u16 = A;
        let mut result_lo: u16 = 0;
        let mut result_hi: u16 = 0;
        let mut mcand_lo: u16 = self.lo;
        let mut mcand_hi: u16 = self.hi;
        let mut new_lo: u16 = 0;
        let mut carry: bool = false;

        loop {
            if mplier == 0 {
                break;
            }
            if (mplier & 1) != 0 {
                new_lo = result_lo + mcand_lo;
                carry = false;
                if new_lo < result_lo {
                    carry = true;
                }
                result_lo = new_lo;
                result_hi = result_hi + mcand_hi;
                if carry {
                    result_hi = result_hi + 1;
                }
            }
            _u32_shl1!(mcand_lo, mcand_hi);
            mplier = mplier >> 1;
        }

        self.lo = result_lo;
        self.hi = result_hi;
    }

    /// Divides `self` by a `u16` in place (`self /= value`).
    ///
    /// # Parameters
    /// - `value` — divisor (passed in `A`)
    ///
    /// # Edge cases
    /// If `value` is `0`, `self` is set to `0xFFFFFFFF`.
    far fn div_u16(far *self, value @ A: u16) {
        if A == 0 {
            self.lo = 0xFFFF;
            self.hi = 0xFFFF;
            return;
        }

        let divisor: u16 = A;
        let mut rem_lo: u16 = 0;
        let mut rem_hi: u16 = 0;
        let mut div_lo: u16 = self.lo;
        let mut div_hi: u16 = self.hi;
        let mut quot_lo: u16 = 0;
        let mut quot_hi: u16 = 0;
        let mut bit_count: u8 = 32;
        let mut borrow: bool = false;

        loop {
            _u32_shl1!(rem_lo, rem_hi);
            if (div_hi & 0x8000) != 0 {
                rem_lo = rem_lo | 1;
            }
            _u32_shl1!(div_lo, div_hi);
            _u32_shl1!(quot_lo, quot_hi);

            // Divisor hi is always 0 (u16 zero-extended), so compare only lo
            if rem_hi > 0 {
                borrow = false;
                if rem_lo < divisor {
                    borrow = true;
                }
                rem_lo = rem_lo - divisor;
                if borrow {
                    rem_hi = rem_hi - 1;
                }
                quot_lo = quot_lo | 1;
            } else if rem_lo >= divisor {
                rem_lo = rem_lo - divisor;
                quot_lo = quot_lo | 1;
            }

            bit_count--;
            if bit_count == 0 {
                break;
            }
        }

        self.lo = quot_lo;
        self.hi = quot_hi;
    }

    /// Sets `self` to `self % value` for a `u16` divisor.
    ///
    /// # Parameters
    /// - `value` — divisor (passed in `A`)
    ///
    /// # Edge cases
    /// If `value` is `0`, `self` is left unchanged.
    far fn mod_u16(far *self, value @ A: u16) {
        if A == 0 {
            return;
        }

        let divisor: u16 = A;
        let mut rem_lo: u16 = 0;
        let mut rem_hi: u16 = 0;
        let mut div_lo: u16 = self.lo;
        let mut div_hi: u16 = self.hi;
        let mut bit_count: u8 = 32;
        let mut borrow: bool = false;

        loop {
            _u32_shl1!(rem_lo, rem_hi);
            if (div_hi & 0x8000) != 0 {
                rem_lo = rem_lo | 1;
            }
            _u32_shl1!(div_lo, div_hi);

            // Divisor hi is always 0 (u16 zero-extended), so compare only lo
            if rem_hi > 0 {
                borrow = false;
                if rem_lo < divisor {
                    borrow = true;
                }
                rem_lo = rem_lo - divisor;
                if borrow {
                    rem_hi = rem_hi - 1;
                }
            } else if rem_lo >= divisor {
                rem_lo = rem_lo - divisor;
            }

            bit_count--;
            if bit_count == 0 {
                break;
            }
        }

        self.lo = rem_lo;
        self.hi = rem_hi;
    }

    /// Sets `self` to `self % other` for a full `U32` divisor.
    ///
    /// Uses a long-division loop that keeps the remainder.
    ///
    /// # Edge cases
    /// If `other` is `0`, `self` is left unchanged.
    far fn mod(far *self, other: far *U32) {
        let o_lo: u16 = other.lo;
        let o_hi: u16 = other.hi;

        // Handle division by zero - leave self unchanged
        if o_lo == 0 {
            if o_hi == 0 {
                return;
            }
        }

        let mut rem_lo: u16 = 0;
        let mut rem_hi: u16 = 0;
        let mut div_lo: u16 = self.lo;
        let mut div_hi: u16 = self.hi;
        let mut bit_count: u8 = 32;
        let mut borrow: bool = false;

        loop {
            // Shift remainder left by 1
            _u32_shl1!(rem_lo, rem_hi);

            // Get MSB of dividend into remainder
            if (div_hi & 0x8000) != 0 {
                rem_lo = rem_lo | 1;
            }

            // Shift dividend left
            _u32_shl1!(div_lo, div_hi);

            // Compare remainder >= divisor
            if rem_hi > o_hi {
                borrow = false;
                if rem_lo < o_lo {
                    borrow = true;
                }
                rem_lo = rem_lo - o_lo;
                rem_hi = rem_hi - o_hi;
                if borrow {
                    rem_hi = rem_hi - 1;
                }
            } else if rem_hi == o_hi {
                if rem_lo >= o_lo {
                    rem_lo = rem_lo - o_lo;
                    rem_hi = rem_hi - o_hi;
                }
            }

            bit_count--;
            if bit_count == 0 {
                break;
            }
        }

        self.lo = rem_lo;
        self.hi = rem_hi;
    }

    // ========================================================================
    // Bitwise Shift Methods
    // ========================================================================

    /// Shifts `self` left by `count` bits in place.
    ///
    /// # Parameters
    /// - `count` — number of bit positions (passed in `X`)
    far fn shl(far *self, count @ X: u16) {
        let mut lo: u16 = self.lo;
        let mut hi: u16 = self.hi;
        loop {
            if X == 0 {
                break;
            }
            if (lo & 0x8000) != 0 {
                lo = lo + lo;
                hi = hi + hi;
                hi = hi | 1;
            } else {
                lo = lo + lo;
                hi = hi + hi;
            }
            X--;
        }
        self.lo = lo;
        self.hi = hi;
    }

    /// Shifts `self` right (logical) by `count` bits in place.
    ///
    /// # Parameters
    /// - `count` — number of bit positions (passed in `X`)
    far fn shr(far *self, count @ X: u16) {
        let mut lo: u16 = self.lo;
        let mut hi: u16 = self.hi;
        loop {
            if X == 0 {
                break;
            }
            if (hi & 1) != 0 {
                hi = hi >> 1;
                lo = lo >> 1;
                lo = lo | 0x8000;
            } else {
                hi = hi >> 1;
                lo = lo >> 1;
            }
            X--;
        }
        self.lo = lo;
        self.hi = hi;
    }

    // ========================================================================
    // SNES Hardware-Accelerated Division
    // ========================================================================

    /// Divides `self` by an 8-bit value in place using the SNES hardware divider,
    /// returning the remainder.
    ///
    /// Much faster than the software divide for small divisors. Available only on
    /// the `snes` target (`#[cfg(snes)]`).
    ///
    /// # Parameters
    /// - `divisor` — 8-bit divisor (passed in `X`)
    ///
    /// # Returns
    /// The remainder, `self % divisor`.
    ///
    /// # Edge cases
    /// If `divisor` is `0`, `self` is set to `0xFFFFFFFF` and `0` is returned.
    #[cfg(snes)]
    far fn div_u8(far *self, divisor @ X: u16) -> u8 {
        let mut remainder: u8;
        let mut q3: u8;
        let mut q2: u8;
        let mut q1: u8;
        let mut q0: u8;
        let mut hi_word: u16;
        let mut lo_word: u16;

        // Handle division by zero
        if X == 0 {
            self.lo = 0xFFFF;
            self.hi = 0xFFFF;
            A = 0;
            return A;
        }

        // Load words into locals
        hi_word = self.hi;
        lo_word = self.lo;

        // Process 4 bytes from MSB to LSB using hardware divider
        A = (hi_word >> 8) as u8;
        _hwdiv_first!();
        q3 = RDDIVL;
        remainder = RDMPYL;

        A = hi_word as u8;
        _hwdiv_step!(remainder);
        q2 = RDDIVL;
        remainder = RDMPYL;

        A = (lo_word >> 8) as u8;
        _hwdiv_step!(remainder);
        q1 = RDDIVL;
        remainder = RDMPYL;

        A = lo_word as u8;
        _hwdiv_step!(remainder);
        q0 = RDDIVL;
        remainder = RDMPYL;

        // Reassemble quotient into self
        self.lo = ((q1 as u16) << 8) | (q0 as u16);
        self.hi = ((q3 as u16) << 8) | (q2 as u16);

        A = remainder;
        return A;
    }

    /// Sets `self` to `self % divisor` for an 8-bit divisor, using the SNES
    /// hardware divider.
    ///
    /// The remainder fits in 8 bits, so the high word becomes `0`. Available only
    /// on the `snes` target (`#[cfg(snes)]`).
    ///
    /// # Parameters
    /// - `divisor` — 8-bit divisor (passed in `X`)
    #[cfg(snes)]
    far fn mod_u8(far *self, divisor @ X: u16) {
        let mut remainder: u8 = self.div_u8(X);
        self.lo = remainder as u16;
        self.hi = 0;
    }
}

/// Powers the `+=` operator — adds another `U32` into `self`, wrapping on overflow.
impl AddAssign for U32 {
    far fn add_assign(far *self, other: far *U32) {
        let s_lo: u16 = self.lo;
        let s_hi: u16 = self.hi;
        let o_lo: u16 = other.lo;
        let o_hi: u16 = other.hi;
        let r_lo: u16 = s_lo + o_lo;
        let mut r_hi: u16 = s_hi + o_hi;
        // Carry: unsigned addition overflowed if result < operand
        if r_lo < o_lo {
            r_hi = r_hi + 1;
        }
        self.lo = r_lo;
        self.hi = r_hi;
    }
}

/// Powers the `-=` operator — subtracts another `U32` from `self`, wrapping on underflow.
impl SubAssign for U32 {
    far fn sub_assign(far *self, other: far *U32) {
        let s_lo: u16 = self.lo;
        let s_hi: u16 = self.hi;
        let o_lo: u16 = other.lo;
        let o_hi: u16 = other.hi;
        let r_lo: u16 = s_lo - o_lo;
        let mut r_hi: u16 = s_hi - o_hi;
        // Borrow: underflow occurred if self.lo < other.lo
        if s_lo < o_lo {
            r_hi = r_hi - 1;
        }
        self.lo = r_lo;
        self.hi = r_hi;
    }
}

/// Powers the `*=` operator — multiplies `self` by another `U32`, keeping the low 32 bits.
impl MulAssign for U32 {
    far fn mul_assign(far *self, other: far *U32) {
        // Software shift-and-add: the hardware multiplier is 8x8, far too narrow
        // to help here.
        let mut result_lo: u16 = 0;
        let mut result_hi: u16 = 0;
        let mut mcand_lo: u16 = self.lo;
        let mut mcand_hi: u16 = self.hi;
        let mut mplier_lo: u16 = other.lo;
        let mut mplier_hi: u16 = other.hi;
        let mut new_lo: u16 = 0;
        let mut carry: bool = false;

        loop {
            if mplier_lo == 0 {
                if mplier_hi == 0 {
                    break;
                }
            }

            // Test lowest bit of multiplier
            if (mplier_lo & 1) != 0 {
                // 32-bit add: result += multiplicand
                new_lo = result_lo + mcand_lo;
                carry = false;
                if new_lo < result_lo {
                    carry = true;
                }
                result_lo = new_lo;
                result_hi = result_hi + mcand_hi;
                if carry {
                    result_hi = result_hi + 1;
                }
            }

            // Shift multiplicand left (32-bit)
            _u32_shl1!(mcand_lo, mcand_hi);

            // Shift multiplier right (32-bit)
            _u32_shr1!(mplier_lo, mplier_hi);
        }

        self.lo = result_lo;
        self.hi = result_hi;
    }
}

/// Powers the `/=` operator. A zero divisor sets `self` to `0xFFFFFFFF`.
impl DivAssign for U32 {
    far fn div_assign(far *self, other: far *U32) {
        // Restoring long division, one quotient bit per iteration.
        let o_lo: u16 = other.lo;
        let o_hi: u16 = other.hi;

        // Handle division by zero
        if o_lo == 0 {
            if o_hi == 0 {
                self.lo = 0xFFFF;
                self.hi = 0xFFFF;
                return;
            }
        }

        let mut rem_lo: u16 = 0;
        let mut rem_hi: u16 = 0;
        let mut div_lo: u16 = self.lo;
        let mut div_hi: u16 = self.hi;
        let mut quot_lo: u16 = 0;
        let mut quot_hi: u16 = 0;
        let mut bit_count: u8 = 32;
        let mut borrow: bool = false;

        loop {
            // Shift remainder left by 1
            _u32_shl1!(rem_lo, rem_hi);

            // Get MSB of dividend into remainder
            if (div_hi & 0x8000) != 0 {
                rem_lo = rem_lo | 1;
            }

            // Shift dividend left
            _u32_shl1!(div_lo, div_hi);

            // Shift quotient left
            _u32_shl1!(quot_lo, quot_hi);

            // Compare remainder >= divisor (32-bit compare)
            if rem_hi > o_hi {
                // remainder > divisor, subtract and set quotient bit
                borrow = false;
                if rem_lo < o_lo {
                    borrow = true;
                }
                rem_lo = rem_lo - o_lo;
                rem_hi = rem_hi - o_hi;
                if borrow {
                    rem_hi = rem_hi - 1;
                }
                quot_lo = quot_lo | 1;
            } else if rem_hi == o_hi {
                if rem_lo >= o_lo {
                    // remainder >= divisor
                    rem_lo = rem_lo - o_lo;
                    rem_hi = rem_hi - o_hi;
                    quot_lo = quot_lo | 1;
                }
            }

            bit_count--;
            if bit_count == 0 {
                break;
            }
        }

        self.lo = quot_lo;
        self.hi = quot_hi;
    }
}

/// Powers the ordering operators (`<`, `<=`, `>`, `>=`) through a three-way `cmp`.
impl PartialOrd for U32 {
    /// Compares `self` with `other`, returning `1` if `self > other`, `0` if
    /// equal, or `-1` if `self < other`.
    far fn cmp(far *self, other: far *U32) -> i8 {
        let s_hi: u16 = self.hi;
        let o_hi: u16 = other.hi;
        if s_hi > o_hi { A = 1; return A; }
        if s_hi < o_hi { A = 0xFF; return A; }
        let s_lo: u16 = self.lo;
        let o_lo: u16 = other.lo;
        if s_lo > o_lo { A = 1; return A; }
        if s_lo < o_lo { A = 0xFF; return A; }
        A = 0;
        return A;
    }
}

// ============================================================================
// U32 Operator Overloading: equality
// ============================================================================
// Arithmetic (`+=` `-=` `*=` `/=`) lives in the AddAssign/SubAssign/MulAssign/
// DivAssign impls above; ordering (`<` `<=` `>` `>=`) in PartialOrd::cmp. The
// methods *are* the implementation (no forwarders). PartialEq derives `==`/`!=`.

/// Powers the equality operators (`==`, `!=`) by comparing all 32 bits.
impl PartialEq for U32 { far fn eq(far *self, other: far *U32) -> bool { return self.cmp(other) == 0; } }

/// Enables `Clone` for `U32` — `let c = a.clone()` and `dst.clone_from(&src)` copy
/// all four bytes. The empty body selects the compiler's automatic bitwise copy.
impl Clone for U32 {}

// ============================================================================
// U32 ToString
// ============================================================================

/// Formats `self` as a decimal ASCII string (used by `format!`'s `{}`).
impl ToString for U32 {
    /// Writes the NUL-terminated decimal digits of `self` into `buf` and returns
    /// the digit count.
    ///
    /// # Parameters
    /// - `buf` — destination buffer (needs room for up to 10 digits + NUL)
    fn to_string(far *self, buf: far *u8) -> u16 {
        let mut __u32_tostr_tmp: U32;
        let mut __u32_tostr_digits: [u8; 11];
        __u32_tostr_tmp.lo = self.lo;
        __u32_tostr_tmp.hi = self.hi;
        if __u32_tostr_tmp.hi == 0 && __u32_tostr_tmp.lo == 0 {
            buf[0 as u16] = 0x30;
            return 1;
        }
        let mut count: u8 = 0;
        loop {
            let d: u8 = __u32_tostr_tmp.div_u8(10);
            __u32_tostr_digits[count as u16] = d + 0x30;
            count++;
            if __u32_tostr_tmp.hi == 0 && __u32_tostr_tmp.lo == 0 { break; }
        }
        let mut i: u8 = count;
        let mut j: u8 = 0;
        loop {
            if i == 0 { break; }
            i--;
            buf[j as u16] = __u32_tostr_digits[i as u16];
            j++;
        }
        return count as u16;
    }
}
