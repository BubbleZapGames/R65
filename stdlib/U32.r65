// R65 Standard Library - U32 (32-bit Unsigned Integer) Support
//
// Provides 32-bit unsigned integer arithmetic, comparisons, and conversions.
//
// Usage:
//   include!("lib/U32.r65")

include!("math.r65")

// ============================================================================
// U32 (32-bit Unsigned Integer) Support
// ============================================================================

// 32-bit unsigned integer (little-endian)
// Size: 4 bytes, packed
struct U32 {
    lo: u16,    // Offset 0-1: Low 16 bits
    hi: u16     // Offset 2-3: High 16 bits
}

// ============================================================================
// U32 Macros - Binary operations with destination (dest = a op b)
// ============================================================================

// dest = a + b
macro_rules! u32_add($dest:expr, $a:expr, $b:expr) {
    $dest.copy($a);
    $dest.add($b);
}

// dest = a - b
macro_rules! u32_sub($dest:expr, $a:expr, $b:expr) {
    $dest.copy($a);
    $dest.sub($b);
}

// dest = a * b
macro_rules! u32_mul($dest:expr, $a:expr, $b:expr) {
    $dest.copy($a);
    $dest.mul($b);
}

// dest = a / b
macro_rules! u32_div($dest:expr, $a:expr, $b:expr) {
    $dest.copy($a);
    $dest.div($b);
}

// dest = a % b
macro_rules! u32_mod($dest:expr, $a:expr, $b:expr) {
    $dest.copy($a);
    $dest.mod($b);
}

// ============================================================================
// Internal Macros (used to reduce code repetition)
// ============================================================================

// Shift 32-bit value left by 1 bit (lo/hi are u16 variables)
macro_rules! _u32_shl1($lo:expr, $hi:expr) {
    A = $lo;
    asm!("ASL A");
    $lo = A;
    A = $hi;
    asm!("ROL A");
    $hi = A;
}

// Shift 32-bit value right by 1 bit (lo/hi are u16 variables)
macro_rules! _u32_shr1($lo:expr, $hi:expr) {
    A = $hi;
    asm!("LSR A");
    $hi = A;
    A = $lo;
    asm!("ROR A");
    $lo = A;
}

// SNES hardware 8x8 multiply: result = a * b (switches to m16 for result)
// Only used within #[cfg(snes)] functions
macro_rules! _hwmul8x8($a:expr, $b:expr, $result:expr) {
    WRMPYA = $a;
    WRMPYB = $b;
    NOP(4);
    STATUS.A16 = true;
    A = RDMPYL;
    $result = A;
    STATUS.A16 = false;
}

// SNES hardware division step: divides (remainder:byte) by divisor
// Expects byte value already in A. Reads divisor from X.
// Only used within #[cfg(snes)] functions
macro_rules! _hwdiv_step($remainder:expr) {
    WRDIVL = A;
    A = $remainder;
    WRDIVH = A;
    WRDIVB = X;
    NOP(8);
}

// First hardware division step (remainder starts at 0)
// Expects byte value already in A. Reads divisor from X.
// Only used within #[cfg(snes)] functions
macro_rules! _hwdiv_first() {
    WRDIVL = A;
    WRDIVH = 0;
    WRDIVB = X;
    NOP(8);
}

// ============================================================================
// Internal 16x16 -> 32 bit multiplication
// ============================================================================

// 16x16 -> 32 bit multiplication using SNES hardware
// Uses four 8x8 multiplies: (a_hi*256 + a_lo) * (b_hi*256 + b_lo)
// Result stored in result_lo (low 16 bits) and result_hi (high 16 bits)
#[cfg(snes)]
far fn _mul16x16(a @ A: u16, b @ X: u16, *result_lo: u16, *result_hi: u16) {
    // Local temporaries for multiplication
    let mut a_val: u16 = A;  // Save 16-bit value before mode switch
    let mut a_lo: u8;
    let mut a_hi: u8;
    let mut b_lo: u8;
    let mut b_hi: u8;
    let mut p1: u16;
    let mut p2: u16;
    let mut p3: u16;

    // Switch to m8 for byte operations with hardware multiplier
    STATUS.A16 = false;

    // Extract bytes from saved a value
    A = a_val as u8;
    a_lo = A;
    A = (a_val >> 8) as u8;
    a_hi = A;

    // Extract bytes from b (in X)
    A = X;
    b_lo = A;
    A = X >> 8;
    b_hi = A;

    // Four partial products using hardware multiplier
    _hwmul8x8!(a_lo, b_lo, *result_lo);  // Product 0: bits 0-15
    A = 0;
    *result_hi = A;

    _hwmul8x8!(a_lo, b_hi, p1);          // Product 1: bits 8-23
    _hwmul8x8!(a_hi, b_lo, p2);          // Product 2: bits 8-23
    _hwmul8x8!(a_hi, b_hi, p3);          // Product 3: bits 16-31

    // Combine products:
    // result = result_lo + (p1 << 8) + (p2 << 8) + (p3 << 16)

    // Add p1 << 8 (p1_lo goes to result_lo high byte, p1_hi goes to result_hi low byte)
    A = p1;
    A = A << 8;
    STATUS.Carry = false;
    A = A + (*result_lo);
    *result_lo = A;
    A = p1;
    A = A >> 8;
    A = A + (*result_hi);
    *result_hi = A;

    // Add p2 << 8 (same pattern)
    A = p2;
    A = A << 8;
    STATUS.Carry = false;
    A = A + (*result_lo);
    *result_lo = A;
    A = p2;
    A = A >> 8;
    A = A + (*result_hi);
    *result_hi = A;

    // Add p3 << 16 (goes entirely to result_hi)
    STATUS.Carry = false;
    A = (*result_hi);
    A = A + p3;
    *result_hi = A;
}

// Software 16x16 -> 32 bit multiplication (shift-and-add)
#[cfg(not(snes))]
far fn _mul16x16(a @ A: u16, b @ X: u16, *result_lo: u16, *result_hi: u16) {
    let mut multiplicand_lo: u16 = A;
    let mut multiplicand_hi: u16 = 0;
    let mut multiplier: u16 = X;

    // Clear result
    A = 0;
    *result_lo = A;
    *result_hi = A;

    loop {
        if multiplier == 0 {
            break;
        }

        // Test lowest bit of multiplier
        A = multiplier;
        A = A & 1;
        if A != 0 {
            // Add multiplicand to result (32-bit add)
            STATUS.Carry = false;
            A = (*result_lo);
            A = A + multiplicand_lo;
            *result_lo = A;
            A = (*result_hi);
            A = A + multiplicand_hi;
            *result_hi = A;
        }

        // Shift multiplicand left (32-bit shift)
        _u32_shl1!(multiplicand_lo, multiplicand_hi);

        // Shift multiplier right
        A = multiplier;
        A = A >> 1;
        multiplier = A;
    }
}

// ============================================================================
// U32 Implementation
// ============================================================================

impl far U32 {
    // ========================================================================
    // Conversion and Copy Methods
    // ========================================================================

    // Copy another U32 into self
    far fn copy(far *self, src: far *U32) {
        A = src.lo;
        self.lo = A;
        A = src.hi;
        self.hi = A;
    }

    // Initialize from u16 (zero-extend)
    far fn from_u16(far *self, value @ A: u16) {
        self.lo = A;
        self.hi = 0;
    }

    // Convert to u16 (truncate, keeps low 16 bits)
    far fn to_u16(far *self) -> u16 {
        return self.lo;
    }

    // ========================================================================
    // Arithmetic Methods (all modify self in-place)
    // ========================================================================

    // Add: self += other (with overflow wrapping)
    far fn add(far *self, other: far *U32) {
        // Add low words with carry clear
        STATUS.Carry = false;
        A = self.lo;
        A = A + other.lo;
        self.lo = A;

        // Add high words with carry from low addition
        A = self.hi;
        A = A + other.hi;
        self.hi = A;
    }

    // Subtract: self -= other (with underflow wrapping)
    far fn sub(far *self, other: far *U32) {
        // Subtract low words with borrow clear (SEC for SBC)
        STATUS.Carry = true;
        A = self.lo;
        A = A - other.lo;
        self.lo = A;

        // Subtract high words with borrow from low subtraction
        A = self.hi;
        A = A - other.hi;
        self.hi = A;
    }

    // Multiply: self *= other (32x32 -> 32, lower 32 bits only)
    far fn mul(far *self, other: far *U32) {
        let mut self_lo: u16;
        let mut temp_lo: u16;
        let mut temp_hi: u16;

        // Save self.lo since we'll overwrite it
        A = self.lo;
        self_lo = A;

        // 32-bit multiply uses partial products:
        // self.lo = low16(self.lo * other.lo)
        // self.hi = high16(self.lo * other.lo) + low16(self.lo * other.hi) + low16(self.hi * other.lo)
        // (self.hi * other.hi contributes to bits 32-63, which we discard)

        // Compute self.lo * other.lo -> self.lo and temp_hi
        A = self_lo;
        X = other.lo;
        _mul16x16(A, X, &self.lo, &temp_hi);

        // Compute self.lo * other.hi (only need low 16 bits)
        A = self_lo;
        X = other.hi;
        _mul16x16(A, X, &temp_lo, &temp_lo);  // Discard high result

        // Add to temp_hi
        STATUS.Carry = false;
        A = temp_hi;
        A = A + temp_lo;
        temp_hi = A;

        // Compute self.hi * other.lo (only need low 16 bits)
        A = self.hi;
        X = other.lo;
        _mul16x16(A, X, &temp_lo, &temp_lo);  // Discard high result

        // Add to temp_hi and store in self.hi
        STATUS.Carry = false;
        A = temp_hi;
        A = A + temp_lo;
        self.hi = A;
    }

    // Divide: self /= other (returns 0xFFFFFFFF if other == 0)
    far fn div(far *self, other: far *U32) {
        let mut remainder_lo: u16;
        let mut remainder_hi: u16;
        let mut dividend_lo: u16;
        let mut dividend_hi: u16;
        let mut bit_count: u8;

        // Handle division by zero
        A = other.lo;
        if A == 0 {
            A = other.hi;
            if A == 0 {
                A = 0xFFFF;
                self.lo = A;
                self.hi = A;
                return;
            }
        }

        // Copy self to dividend before we overwrite self with quotient
        A = self.lo;
        dividend_lo = A;
        A = self.hi;
        dividend_hi = A;

        // Initialize remainder to 0
        A = 0;
        remainder_lo = A;
        remainder_hi = A;

        // Initialize quotient (self) to 0
        self.lo = A;
        self.hi = A;

        // Process 32 bits
        bit_count = 32;

        loop {
            // Shift remainder left by 1, bringing in MSB of dividend
            _u32_shl1!(remainder_lo, remainder_hi);

            // Get MSB of dividend into remainder
            A = dividend_hi;
            if A & 0x8000 != 0 {
                A = remainder_lo;
                A = A | 1;
                remainder_lo = A;
            }

            // Shift dividend left
            _u32_shl1!(dividend_lo, dividend_hi);

            // Shift quotient (self) left
            A = self.lo;
            asm!("ASL A");
            self.lo = A;
            A = self.hi;
            asm!("ROL A");
            self.hi = A;

            // Compare remainder >= divisor (32-bit compare)
            // First compare high words
            A = remainder_hi;
            if A > other.hi {
                // remainder > divisor, subtract and set quotient bit
                STATUS.Carry = true;
                A = remainder_lo;
                A = A - other.lo;
                remainder_lo = A;
                A = remainder_hi;
                A = A - other.hi;
                remainder_hi = A;
                A = self.lo;
                A = A | 1;
                self.lo = A;
            } else if A == other.hi {
                // High words equal, check low words
                A = remainder_lo;
                if A >= other.lo {
                    // remainder >= divisor
                    STATUS.Carry = true;
                    A = remainder_lo;
                    A = A - other.lo;
                    remainder_lo = A;
                    A = remainder_hi;
                    A = A - other.hi;
                    remainder_hi = A;
                    A = self.lo;
                    A = A | 1;
                    self.lo = A;
                }
            }
            // else remainder < divisor, quotient bit stays 0

            bit_count--;
            if bit_count == 0 {
                break;
            }
        }
    }

    // Modulo: self %= other (unchanged if other == 0)
    far fn mod(far *self, other: far *U32) {
        let mut dividend_lo: u16;
        let mut dividend_hi: u16;
        let mut bit_count: u8;

        // Handle division by zero - leave self unchanged
        A = other.lo;
        if A == 0 {
            A = other.hi;
            if A == 0 {
                return;
            }
        }

        // Copy self to dividend before we overwrite self with remainder
        A = self.lo;
        dividend_lo = A;
        A = self.hi;
        dividend_hi = A;

        // Initialize remainder (self) to 0
        A = 0;
        self.lo = A;
        self.hi = A;

        // Process 32 bits
        bit_count = 32;

        loop {
            // Shift remainder (self) left by 1, bringing in MSB of dividend
            A = self.lo;
            asm!("ASL A");
            self.lo = A;
            A = self.hi;
            asm!("ROL A");
            self.hi = A;

            // Get MSB of dividend into remainder
            A = dividend_hi;
            if A & 0x8000 != 0 {
                A = self.lo;
                A = A | 1;
                self.lo = A;
            }

            // Shift dividend left
            _u32_shl1!(dividend_lo, dividend_hi);

            // Compare remainder >= divisor (32-bit compare)
            A = self.hi;
            if A > other.hi {
                // remainder > divisor, subtract
                STATUS.Carry = true;
                A = self.lo;
                A = A - other.lo;
                self.lo = A;
                A = self.hi;
                A = A - other.hi;
                self.hi = A;
            } else if A == other.hi {
                A = self.lo;
                if A >= other.lo {
                    // remainder >= divisor
                    STATUS.Carry = true;
                    A = self.lo;
                    A = A - other.lo;
                    self.lo = A;
                    A = self.hi;
                    A = A - other.hi;
                    self.hi = A;
                }
            }

            bit_count--;
            if bit_count == 0 {
                break;
            }
        }
    }

    // ========================================================================
    // Comparison Method
    // ========================================================================

    // Compare self with other, setting STATUS flags like CMP instruction.
    // After calling:
    //   eq: STATUS.Zero == true
    //   ne: STATUS.Zero == false
    //   lt: STATUS.Carry == false
    //   ge: STATUS.Carry == true
    //   gt: STATUS.Carry == true && STATUS.Zero == false
    //   le: STATUS.Carry == false || STATUS.Zero == true
    far fn cmp(far *self, other: far *U32) -> u8 {
        // Compare high words first
        A = self.hi;
        if A != other.hi {
            // High words differ - compare them to set flags
            A = self.hi;
            asm!("CMP _U32__cmp_other_hi");
            return;
        }

        // High words equal - compare low words to set flags
        A = self.lo;
        asm!("CMP _U32__cmp_other_lo");
        return STATUS;
    }

    // ========================================================================
    // Bitwise Shift Methods
    // ========================================================================

    // Shift left by n bits (in place)
    far fn shl(far *self, count @ X: u8) {
        loop {
            if X == 0 {
                break;
            }
            A = self.lo;
            asm!("ASL A");
            self.lo = A;
            A = self.hi;
            asm!("ROL A");
            self.hi = A;
            X--;
        }
    }

    // Shift right by n bits (in place)
    far fn shr(far *self, count @ X: u8) {
        loop {
            if X == 0 {
                break;
            }
            A = self.hi;
            asm!("LSR A");
            self.hi = A;
            A = self.lo;
            asm!("ROR A");
            self.lo = A;
            X--;
        }
    }

    // ========================================================================
    // SNES Hardware-Accelerated Division
    // ========================================================================

    // Divide by 8-bit value using SNES hardware divider.
    // self /= divisor, returns remainder.
    // Much faster than software div when dividing by small values.
    // If divisor is 0, sets self to 0xFFFFFFFF and returns 0.
    #[cfg(snes)]
    far fn div_u8(far *self, divisor @ X: u8) -> u8 {
        let mut remainder: u8;
        let mut q3: u8;
        let mut q2: u8;
        let mut q1: u8;
        let mut q0: u8;
        let mut hi_word: u16;
        let mut lo_word: u16;

        // Handle division by zero
        if X == 0 {
            self.lo = 0xFFFF;
            self.hi = 0xFFFF;
            A = 0;
            return A;
        }

        // Load words into locals
        hi_word = self.hi;
        lo_word = self.lo;

        // Process 4 bytes from MSB to LSB using hardware divider
        // Each step: dividend = (remainder << 8) | byte, then divide by X

        // Byte 3 (MSB): high byte of hi word
        A = (hi_word >> 8) as u8;
        _hwdiv_first!();
        q3 = RDDIVL;
        remainder = RDMPYL;

        // Byte 2: low byte of hi word
        A = hi_word as u8;
        _hwdiv_step!(remainder);
        q2 = RDDIVL;
        remainder = RDMPYL;

        // Byte 1: high byte of lo word
        A = (lo_word >> 8) as u8;
        _hwdiv_step!(remainder);
        q1 = RDDIVL;
        remainder = RDMPYL;

        // Byte 0 (LSB): low byte of lo word
        A = lo_word as u8;
        _hwdiv_step!(remainder);
        q0 = RDDIVL;
        remainder = RDMPYL;

        // Reassemble quotient into self
        // self.lo = (q1 << 8) | q0, self.hi = (q3 << 8) | q2
        self.lo = ((q1 as u16) << 8) | (q0 as u16);
        self.hi = ((q3 as u16) << 8) | (q2 as u16);

        A = remainder;
        return A;
    }

    // Modulo by 8-bit value using SNES hardware divider.
    // self %= divisor (self becomes remainder, which fits in 8 bits).
    // If divisor is 0, self is unchanged.
    #[cfg(snes)]
    far fn mod_u8(far *self, divisor @ X: u8) {
        // div_u8 computes quotient (stored in self) and returns remainder
        // We discard the quotient and store only the remainder
        let mut remainder: u8 = self.div_u8(X);
        self.lo = remainder as u16;
        self.hi = 0;
    }
}
