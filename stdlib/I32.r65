//! 32-bit signed integer (`I32`) for the 65816.
//!
//! `I32` is a 4-byte value held as two little-endian 16-bit words in two's
//! complement (range `-2147483648` to `2147483647`). It supports the
//! compound-assignment operators (`+=`, `-=`, `*=`, `/=`), the comparison
//! operators (`==`, `!=`, `<`, `<=`, `>`, `>=`), and `Clone`. Operations with a
//! plain `i16` are available through the `*_i16` methods. All methods avoid
//! explicit `A`-register use for correct m8-mode codegen.
//!
//! ```
//! include!("lib/I32.r65")
//!
//! #[ram] static mut POSITION: I32 = I32!(10000);
//! #[ram] static mut VELOCITY: I32 = I32!(-256);
//!
//! fn step() { POSITION += VELOCITY; }
//! ```
//!
//! See also `U32` (unsigned) and `F32` (floating point).

include!("math.r65")

// ============================================================================
// I32 (32-bit Signed Integer) Support
// ============================================================================

/// A 32-bit signed integer in two's complement (range `-2147483648` to
/// `2147483647`).
///
/// Stored as two little-endian 16-bit words for a packed 4-byte layout; bit 15
/// of the high word is the sign bit. Construct one with the `I32!` macro,
/// `from_i16`, or `from_u16`.
struct I32 {
    /// Low 16 bits (byte offset 0).
    lo: u16,
    /// High 16 bits (byte offset 2); bit 15 is the sign bit.
    hi: u16
}

/// Builds an `I32` from a compile-time constant.
///
/// Splits the constant — including negatives, in two's complement — into its low
/// and high 16-bit words at compile time, so it can initialize a `static`.
///
/// # Example
/// ```
/// #[ram] static mut OFFSET: I32 = I32!(-42);
/// ```
macro_rules! I32($value:expr) {
    I32 { lo: (($value) & 0xFFFF) as u16, hi: ((($value) >> 16) & 0xFFFF) as u16 }
}

// ============================================================================
// Internal Macros
// ============================================================================

// Shift 32-bit value left by 1 bit (no A register usage)
macro_rules! _i32_shl1($lo:expr, $hi:expr) {
    if ($lo & 0x8000) != 0 {
        $lo = $lo + $lo;
        $hi = $hi + $hi;
        $hi = $hi | 1;
    } else {
        $lo = $lo + $lo;
        $hi = $hi + $hi;
    }
}

// Shift 32-bit value right by 1 bit (logical - zero fill, no A register usage)
macro_rules! _i32_shr1($lo:expr, $hi:expr) {
    if ($hi & 1) != 0 {
        $hi = $hi >> 1;
        $lo = $lo >> 1;
        $lo = $lo | 0x8000;
    } else {
        $hi = $hi >> 1;
        $lo = $lo >> 1;
    }
}

// Negate 32-bit value in place (two's complement: ~val + 1, no A register usage)
macro_rules! _i32_negate($lo:expr, $hi:expr) {
    $lo = $lo ^ 0xFFFF;
    $hi = $hi ^ 0xFFFF;
    $lo = $lo + 1;
    if $lo == 0 {
        $hi = $hi + 1;
    }
}

// SNES hardware division step: divides (remainder:byte) by divisor
// Expects byte value already in A. Reads divisor from X.
// Only used within #[cfg(snes)] functions
macro_rules! _hwdiv_step($remainder:expr) {
    WRDIVL = A;
    A = $remainder;
    WRDIVH = A;
    WRDIVB = X;
    NOP(8);
}

// First hardware division step (remainder starts at 0)
// Expects byte value already in A. Reads divisor from X.
// Only used within #[cfg(snes)] functions
macro_rules! _hwdiv_first() {
    WRDIVL = A;
    WRDIVH = 0;
    WRDIVB = X;
    NOP(8);
}

// ============================================================================
// I32 Implementation
// ============================================================================

impl I32 {
    // ========================================================================
    // Conversion and Copy Methods
    // ========================================================================

    /// Copies `src` into `self`.
    #[inline(always)]
    far fn copy(far *self, src: far *I32) {
        self.lo = src.lo;
        self.hi = src.hi;
    }

    /// Sets `self` to an `i16` value, sign-extended to 32 bits.
    ///
    /// A negative value fills the high word with `0xFFFF`.
    ///
    /// # Parameters
    /// - `value` — the signed 16-bit value
    #[inline(always)]
    far fn from_i16(far *self, value: u16) {
        self.lo = value;
        // Check sign bit (bit 15)
        if value & 0x8000 != 0 {
            // Negative: sign extend with 0xFFFF
            self.hi = 0xFFFF;
        } else {
            // Positive: zero extend
            self.hi = 0;
        }
    }

    /// Sets `self` to a `u16` value, zero-extended (positive values only).
    ///
    /// # Parameters
    /// - `value` — the unsigned 16-bit value
    #[inline(always)]
    far fn from_u16(far *self, value: u16) {
        self.lo = value;
        self.hi = 0;
    }

    /// Returns the low 16 bits of `self` as an `i16`, truncating the high word.
    #[inline(always)]
    far fn to_i16(far *self) -> i16 {
        return self.lo as i16;
    }

    // ========================================================================
    // Sign-Related Methods
    // ========================================================================

    /// Returns `true` if `self` is negative (sign bit set), `false` if zero or
    /// positive.
    #[inline(always)]
    far fn is_negative(far *self) -> bool {
        let mut hi: u16 = self.hi;
        if (hi & 0x8000) != 0 {
            return true;
        }
        return false;
    }

    /// Negates `self` in place (two's complement, `~self + 1`).
    #[inline(always)]
    far fn neg(far *self) {
        let mut lo: u16 = self.lo;
        let mut hi: u16 = self.hi;
        _i32_negate!(lo, hi);
        self.lo = lo;
        self.hi = hi;
    }

    /// Replaces `self` with its absolute value (negates if negative).
    #[inline(always)]
    far fn abs(far *self) {
        let mut hi: u16 = self.hi;
        if (hi & 0x8000) != 0 {
            self.neg();
        }
    }

    // ========================================================================
    // Arithmetic Methods (all modify self in-place)
    // ========================================================================

    /// Adds an `i16` to `self` in place (`self += value`).
    ///
    /// The value is sign-extended to 32 bits; the result wraps on overflow.
    ///
    /// # Parameters
    /// - `value` — signed amount to add (passed in `A`)
    far fn add_i16(far *self, value @ A: u16) {
        // Sign-extend: if bit 15 set, hi = 0xFFFF; else hi = 0
        let o_lo: u16 = A;
        let mut o_hi: u16 = 0;
        if (o_lo & 0x8000) != 0 {
            o_hi = 0xFFFF;
        }
        let s_lo: u16 = self.lo;
        let r_lo: u16 = s_lo + o_lo;
        let mut r_hi: u16 = self.hi + o_hi;
        if r_lo < o_lo {
            r_hi = r_hi + 1;
        }
        self.lo = r_lo;
        self.hi = r_hi;
    }

    /// Subtracts an `i16` from `self` in place (`self -= value`).
    ///
    /// The value is sign-extended to 32 bits; the result wraps on underflow.
    ///
    /// # Parameters
    /// - `value` — signed amount to subtract (passed in `A`)
    far fn sub_i16(far *self, value @ A: u16) {
        // Sign-extend: if bit 15 set, hi = 0xFFFF; else hi = 0
        let o_lo: u16 = A;
        let mut o_hi: u16 = 0;
        if (o_lo & 0x8000) != 0 {
            o_hi = 0xFFFF;
        }
        let s_lo: u16 = self.lo;
        let s_hi: u16 = self.hi;
        let r_lo: u16 = s_lo - o_lo;
        let mut r_hi: u16 = s_hi - o_hi;
        if s_lo < o_lo {
            r_hi = r_hi - 1;
        }
        self.lo = r_lo;
        self.hi = r_hi;
    }

    /// Multiplies `self` by an `i16` in place (`self *= value`).
    ///
    /// Signed multiply keeping the low 32 bits (wraps on overflow).
    ///
    /// # Parameters
    /// - `value` — signed multiplier (passed in `A`)
    far fn mul_i16(far *self, value @ A: u16) {
        let mut mplier: u16 = A;
        let mut negate_result: bool = false;

        let s_hi: u16 = self.hi;
        if (s_hi ^ mplier) & 0x8000 != 0 {
            negate_result = true;
        }

        // Make self positive
        if (s_hi & 0x8000) != 0 {
            self.neg();
        }

        // Get absolute value of value
        if (mplier & 0x8000) != 0 {
            mplier = mplier ^ 0xFFFF;
            mplier = mplier + 1;
        }

        let mut result_lo: u16 = 0;
        let mut result_hi: u16 = 0;
        let mut mcand_lo: u16 = self.lo;
        let mut mcand_hi: u16 = self.hi;
        let mut new_lo: u16 = 0;
        let mut carry: bool = false;

        loop {
            if mplier == 0 {
                break;
            }
            if (mplier & 1) != 0 {
                new_lo = result_lo + mcand_lo;
                carry = false;
                if new_lo < result_lo {
                    carry = true;
                }
                result_lo = new_lo;
                result_hi = result_hi + mcand_hi;
                if carry {
                    result_hi = result_hi + 1;
                }
            }
            _i32_shl1!(mcand_lo, mcand_hi);
            mplier = mplier >> 1;
        }

        self.lo = result_lo;
        self.hi = result_hi;

        if negate_result {
            self.neg();
        }
    }

    /// Divides `self` by an `i16` in place (`self /= value`), rounding toward zero.
    ///
    /// # Parameters
    /// - `value` — signed divisor (passed in `A`)
    ///
    /// # Edge cases
    /// If `value` is `0`, `self` is set to `MIN_I32` (`-2147483648`).
    far fn div_i16(far *self, value @ A: u16) {
        if A == 0 {
            self.lo = 0;
            self.hi = 0x8000;
            return;
        }

        let mut divisor: u16 = A;
        let mut negate_result: bool = false;

        let s_hi: u16 = self.hi;
        if (s_hi ^ divisor) & 0x8000 != 0 {
            negate_result = true;
        }

        // Take absolute value of self
        let mut dividend_lo: u16 = self.lo;
        let mut dividend_hi: u16 = self.hi;
        if (dividend_hi & 0x8000) != 0 {
            _i32_negate!(dividend_lo, dividend_hi);
        }

        // Get absolute value of divisor (u16 only)
        if (divisor & 0x8000) != 0 {
            divisor = divisor ^ 0xFFFF;
            divisor = divisor + 1;
        }

        let mut rem_lo: u16 = 0;
        let mut rem_hi: u16 = 0;
        let mut quot_lo: u16 = 0;
        let mut quot_hi: u16 = 0;
        let mut bit_count: u8 = 32;
        let mut borrow: bool = false;

        loop {
            _i32_shl1!(rem_lo, rem_hi);
            if (dividend_hi & 0x8000) != 0 {
                rem_lo = rem_lo | 1;
            }
            _i32_shl1!(dividend_lo, dividend_hi);
            _i32_shl1!(quot_lo, quot_hi);

            // Divisor hi is always 0 (sign-magnitude fits in u16)
            if rem_hi > 0 {
                borrow = false;
                if rem_lo < divisor {
                    borrow = true;
                }
                rem_lo = rem_lo - divisor;
                if borrow {
                    rem_hi = rem_hi - 1;
                }
                quot_lo = quot_lo | 1;
            } else if rem_lo >= divisor {
                rem_lo = rem_lo - divisor;
                quot_lo = quot_lo | 1;
            }

            bit_count--;
            if bit_count == 0 {
                break;
            }
        }

        self.lo = quot_lo;
        self.hi = quot_hi;

        if negate_result {
            self.neg();
        }
    }

    /// Sets `self` to `self % value` for an `i16` divisor.
    ///
    /// The remainder takes the sign of the dividend.
    ///
    /// # Parameters
    /// - `value` — signed divisor (passed in `A`)
    ///
    /// # Edge cases
    /// If `value` is `0`, `self` is left unchanged.
    far fn mod_i16(far *self, value @ A: u16) {
        let mut divisor_lo: u16 = A;
        if divisor_lo == 0 {
            return;
        }

        let mut negate_result: bool = false;

        // Remainder has same sign as dividend
        let s_hi: u16 = self.hi;
        if (s_hi & 0x8000) != 0 {
            negate_result = true;
        }

        // Take absolute value of dividend (self)
        let mut dividend_lo: u16 = self.lo;
        let mut dividend_hi: u16 = self.hi;
        if (dividend_hi & 0x8000) != 0 {
            _i32_negate!(dividend_lo, dividend_hi);
        }

        // Sign-extend divisor and take absolute value
        let mut divisor_hi: u16 = 0;
        if (divisor_lo & 0x8000) != 0 {
            divisor_hi = 0xFFFF;
            _i32_negate!(divisor_lo, divisor_hi);
        }

        let mut rem_lo: u16 = 0;
        let mut rem_hi: u16 = 0;
        let mut bit_count: u8 = 32;
        let mut borrow: bool = false;

        loop {
            _i32_shl1!(rem_lo, rem_hi);
            if (dividend_hi & 0x8000) != 0 {
                rem_lo = rem_lo | 1;
            }
            _i32_shl1!(dividend_lo, dividend_hi);

            if rem_hi > divisor_hi {
                borrow = false;
                if rem_lo < divisor_lo {
                    borrow = true;
                }
                rem_lo = rem_lo - divisor_lo;
                rem_hi = rem_hi - divisor_hi;
                if borrow {
                    rem_hi = rem_hi - 1;
                }
            } else if rem_hi == divisor_hi {
                if rem_lo >= divisor_lo {
                    rem_lo = rem_lo - divisor_lo;
                    rem_hi = rem_hi - divisor_hi;
                }
            }

            bit_count--;
            if bit_count == 0 {
                break;
            }
        }

        self.lo = rem_lo;
        self.hi = rem_hi;

        if negate_result {
            self.neg();
        }
    }

    /// Sets `self` to `self % other` for a full `I32` divisor.
    ///
    /// The remainder takes the sign of the dividend.
    ///
    /// # Edge cases
    /// If `other` is `0`, `self` is left unchanged.
    far fn mod(far *self, other: far *I32) {
        let o_lo: u16 = other.lo;
        let mut o_hi: u16 = other.hi;

        // Handle division by zero - leave self unchanged
        if o_lo == 0 {
            if o_hi == 0 {
                return;
            }
        }

        let mut negate_result: bool = false;

        // Remainder has same sign as dividend
        let s_hi: u16 = self.hi;
        if (s_hi & 0x8000) != 0 {
            negate_result = true;
        }

        // Copy dividend (self) and take absolute value
        let mut dividend_lo: u16 = self.lo;
        let mut dividend_hi: u16 = self.hi;
        if (dividend_hi & 0x8000) != 0 {
            _i32_negate!(dividend_lo, dividend_hi);
        }

        // Copy divisor (other) and take absolute value
        let mut divisor_lo: u16 = o_lo;
        let mut divisor_hi: u16 = o_hi;
        if (divisor_hi & 0x8000) != 0 {
            _i32_negate!(divisor_lo, divisor_hi);
        }

        // Long division on magnitudes, keeping remainder
        let mut rem_lo: u16 = 0;
        let mut rem_hi: u16 = 0;
        let mut bit_count: u8 = 32;
        let mut borrow: bool = false;

        loop {
            // Shift remainder left by 1
            _i32_shl1!(rem_lo, rem_hi);

            // Get MSB of dividend into remainder
            if (dividend_hi & 0x8000) != 0 {
                rem_lo = rem_lo | 1;
            }

            // Shift dividend left
            _i32_shl1!(dividend_lo, dividend_hi);

            // Compare remainder >= divisor
            if rem_hi > divisor_hi {
                borrow = false;
                if rem_lo < divisor_lo {
                    borrow = true;
                }
                rem_lo = rem_lo - divisor_lo;
                rem_hi = rem_hi - divisor_hi;
                if borrow {
                    rem_hi = rem_hi - 1;
                }
            } else if rem_hi == divisor_hi {
                if rem_lo >= divisor_lo {
                    rem_lo = rem_lo - divisor_lo;
                    rem_hi = rem_hi - divisor_hi;
                }
            }

            bit_count--;
            if bit_count == 0 {
                break;
            }
        }

        self.lo = rem_lo;
        self.hi = rem_hi;

        // Fix sign of result (remainder has same sign as dividend)
        if negate_result {
            self.neg();
        }
    }

    // ========================================================================
    // Bitwise Shift Methods
    // ========================================================================

    /// Shifts `self` left by `count` bits in place.
    ///
    /// # Parameters
    /// - `count` — number of bit positions (passed in `X`)
    far fn shl(far *self, count @ X: u16) {
        let mut lo: u16 = self.lo;
        let mut hi: u16 = self.hi;
        loop {
            if X == 0 {
                break;
            }
            if (lo & 0x8000) != 0 {
                lo = lo + lo;
                hi = hi + hi;
                hi = hi | 1;
            } else {
                lo = lo + lo;
                hi = hi + hi;
            }
            X--;
        }
        self.lo = lo;
        self.hi = hi;
    }

    /// Arithmetic-shifts `self` right by `count` bits in place, preserving the
    /// sign bit.
    ///
    /// # Parameters
    /// - `count` — number of bit positions (passed in `X`)
    far fn sar(far *self, count @ X: u16) {
        let mut lo: u16 = self.lo;
        let mut hi: u16 = self.hi;
        loop {
            if X == 0 {
                break;
            }
            // Save sign bit and low bit of hi
            let mut sign_bit: bool = false;
            if (hi & 0x8000) != 0 {
                sign_bit = true;
            }
            // Shift right: hi then lo with carry
            if (hi & 1) != 0 {
                hi = hi >> 1;
                lo = lo >> 1;
                lo = lo | 0x8000;
            } else {
                hi = hi >> 1;
                lo = lo >> 1;
            }
            // Restore sign bit
            if sign_bit {
                hi = hi | 0x8000;
            }
            X--;
        }
        self.lo = lo;
        self.hi = hi;
    }

    // ========================================================================
    // SNES Hardware-Accelerated Division
    // ========================================================================

    /// Divides `self` by a signed 8-bit value in place using the SNES hardware
    /// divider, returning the remainder.
    ///
    /// Handles sign conversion. Available only on the `snes` target
    /// (`#[cfg(snes)]`).
    ///
    /// # Parameters
    /// - `divisor` — signed 8-bit divisor (passed in `X`)
    ///
    /// # Returns
    /// The remainder, `self % divisor`.
    ///
    /// # Edge cases
    /// If `divisor` is `0`, `self` is set to `MIN_I32` and `0` is returned.
    #[cfg(snes)]
    far fn div_i8(far *self, divisor @ X: u16) -> i8 {
        let mut remainder: u8;
        let mut q3: u8;
        let mut q2: u8;
        let mut q1: u8;
        let mut q0: u8;
        let mut hi_word: u16;
        let mut lo_word: u16;
        let mut negate_result: bool = false;
        let mut negate_remainder: bool = false;
        let mut abs_divisor: u8;

        // Handle division by zero
        if X == 0 {
            self.lo = 0;
            self.hi = 0x8000;  // MIN_I32
            A = 0;
            return A as i8;
        }

        // Determine signs
        A = self.hi >> 8;  // Get high byte of hi word (sign byte)
        if A & 0x80 != 0 {
            negate_result = true;
            negate_remainder = true;
            // Negate self (make positive)
            self.neg();
        }

        // Get absolute value of divisor
        // NOTE: must save to local first — the if-condition (AND #$80) destroys A,
        // so we cannot rely on A after the branch.
        abs_divisor = X as u8;
        if abs_divisor >= 0x80 {
            negate_result = !negate_result;  // XOR sign flags
            // Negate divisor directly in local
            abs_divisor = abs_divisor ^ 0xFF;
            abs_divisor = abs_divisor + 1;
        }
        X = abs_divisor as u16;

        // Load words into locals
        hi_word = self.hi;
        lo_word = self.lo;

        // Process 4 bytes from MSB to LSB using hardware divider
        A = (hi_word >> 8) as u8;
        _hwdiv_first!();
        q3 = RDDIVL;
        remainder = RDMPYL;

        A = hi_word as u8;
        _hwdiv_step!(remainder);
        q2 = RDDIVL;
        remainder = RDMPYL;

        A = (lo_word >> 8) as u8;
        _hwdiv_step!(remainder);
        q1 = RDDIVL;
        remainder = RDMPYL;

        A = lo_word as u8;
        _hwdiv_step!(remainder);
        q0 = RDDIVL;
        remainder = RDMPYL;

        // Reassemble quotient into self
        self.lo = ((q1 as u16) << 8) | (q0 as u16);
        self.hi = ((q3 as u16) << 8) | (q2 as u16);

        // Fix signs
        if negate_result {
            self.neg();
        }
        if negate_remainder {
            A = remainder;
            A = A ^ 0xFF;
            A = A + 1;
            remainder = A;
        }

        A = remainder;
        return A as i8;
    }

    /// Sets `self` to `self % divisor` for a signed 8-bit divisor, using the SNES
    /// hardware divider.
    ///
    /// The remainder fits in 8 bits and takes the sign of the dividend. Available
    /// only on the `snes` target (`#[cfg(snes)]`).
    ///
    /// # Parameters
    /// - `divisor` — signed 8-bit divisor (passed in `X`)
    #[cfg(snes)]
    far fn mod_i8(far *self, divisor @ X: u16) {
        // Handle zero divisor
        if X == 0 {
            return;
        }

        // div_i8 computes quotient (stored in self) and returns remainder
        let mut remainder: i8 = self.div_i8(X);

        // Sign extend remainder to 32 bits
        A = remainder as u8;
        if A & 0x80 != 0 {
            // Negative: sign extend
            self.lo = (0xFF00 | (A as u16));
            self.hi = 0xFFFF;
        } else {
            // Positive: zero extend
            self.lo = A as u16;
            self.hi = 0;
        }
    }
}

/// Powers the `+=` operator — adds another `I32` into `self`, wrapping on overflow.
impl AddAssign for I32 {
    // Add: self += other (with overflow wrapping)
    // Two's complement addition is identical to unsigned
    far fn add_assign(far *self, other: far *I32) {
        let s_lo: u16 = self.lo;
        let s_hi: u16 = self.hi;
        let o_lo: u16 = other.lo;
        let mut o_hi: u16 = other.hi;
        let r_lo: u16 = s_lo + o_lo;
        let mut r_hi: u16 = s_hi + o_hi;
        // Carry: unsigned addition overflowed if result < operand
        if r_lo < o_lo {
            r_hi = r_hi + 1;
        }
        self.lo = r_lo;
        self.hi = r_hi;
    }
}

/// Powers the `-=` operator — subtracts another `I32` from `self`, wrapping on underflow.
impl SubAssign for I32 {
    // Subtract: self -= other (with underflow wrapping)
    // Two's complement subtraction is identical to unsigned
    far fn sub_assign(far *self, other: far *I32) {
        let s_lo: u16 = self.lo;
        let s_hi: u16 = self.hi;
        let o_lo: u16 = other.lo;
        let mut o_hi: u16 = other.hi;
        let r_lo: u16 = s_lo - o_lo;
        let mut r_hi: u16 = s_hi - o_hi;
        // Borrow: underflow occurred if self.lo < other.lo
        if s_lo < o_lo {
            r_hi = r_hi - 1;
        }
        self.lo = r_lo;
        self.hi = r_hi;
    }
}

/// Powers the `*=` operator — signed multiply of `self` by another `I32`, keeping the low 32 bits.
impl MulAssign for I32 {
    // Multiply: self *= other (32x32 -> 32, lower 32 bits only)
    // Signed multiplication: track signs, multiply magnitudes, fix sign
    far fn mul_assign(far *self, other: far *I32) {
        let mut negate_result: bool = false;

        // Determine if result should be negative (signs differ)
        let s_hi: u16 = self.hi;
        let mut o_hi: u16 = other.hi;
        if (s_hi ^ o_hi) & 0x8000 != 0 {
            negate_result = true;
        }

        // Make self positive
        if (s_hi & 0x8000) != 0 {
            self.neg();
        }

        // Copy other's magnitude into locals
        let mut other_lo: u16 = other.lo;
        let mut other_hi: u16 = other.hi;
        if (other_hi & 0x8000) != 0 {
            _i32_negate!(other_lo, other_hi);
        }

        // Software shift-and-add multiply (magnitudes)
        let mut result_lo: u16 = 0;
        let mut result_hi: u16 = 0;
        let mut mcand_lo: u16 = self.lo;
        let mut mcand_hi: u16 = self.hi;
        let mut mplier_lo: u16 = other_lo;
        let mut mplier_hi: u16 = other_hi;
        let mut new_lo: u16 = 0;
        let mut carry: bool = false;

        loop {
            if mplier_lo == 0 {
                if mplier_hi == 0 {
                    break;
                }
            }

            if (mplier_lo & 1) != 0 {
                // 32-bit add: result += multiplicand
                new_lo = result_lo + mcand_lo;
                carry = false;
                if new_lo < result_lo {
                    carry = true;
                }
                result_lo = new_lo;
                result_hi = result_hi + mcand_hi;
                if carry {
                    result_hi = result_hi + 1;
                }
            }

            _i32_shl1!(mcand_lo, mcand_hi);
            _i32_shr1!(mplier_lo, mplier_hi);
        }

        self.lo = result_lo;
        self.hi = result_hi;

        // Fix sign of result
        if negate_result {
            self.neg();
        }
    }
}

/// Powers the `/=` operator (rounds toward zero). A zero divisor sets `self` to `MIN_I32`.
impl DivAssign for I32 {
    // Divide: self /= other (rounds toward zero, returns MIN_I32 if other == 0)
    // Signed division: track signs, divide magnitudes, fix sign
    far fn div_assign(far *self, other: far *I32) {
        let o_lo: u16 = other.lo;
        let mut o_hi: u16 = other.hi;

        // Handle division by zero
        if o_lo == 0 {
            if o_hi == 0 {
                // Return MIN_I32 (0x80000000) for division by zero
                self.lo = 0;
                self.hi = 0x8000;
                return;
            }
        }

        let mut negate_result: bool = false;

        // Determine if result should be negative (signs differ)
        let s_hi: u16 = self.hi;
        if (s_hi ^ o_hi) & 0x8000 != 0 {
            negate_result = true;
        }

        // Copy dividend (self) and take absolute value
        let mut dividend_lo: u16 = self.lo;
        let mut dividend_hi: u16 = self.hi;
        if (dividend_hi & 0x8000) != 0 {
            _i32_negate!(dividend_lo, dividend_hi);
        }

        // Copy divisor (other) and take absolute value
        let mut divisor_lo: u16 = o_lo;
        let mut divisor_hi: u16 = o_hi;
        if (divisor_hi & 0x8000) != 0 {
            _i32_negate!(divisor_lo, divisor_hi);
        }

        // Long division on magnitudes
        let mut rem_lo: u16 = 0;
        let mut rem_hi: u16 = 0;
        let mut quot_lo: u16 = 0;
        let mut quot_hi: u16 = 0;
        let mut bit_count: u8 = 32;
        let mut borrow: bool = false;

        loop {
            // Shift remainder left by 1
            _i32_shl1!(rem_lo, rem_hi);

            // Get MSB of dividend into remainder
            if (dividend_hi & 0x8000) != 0 {
                rem_lo = rem_lo | 1;
            }

            // Shift dividend left
            _i32_shl1!(dividend_lo, dividend_hi);

            // Shift quotient left
            _i32_shl1!(quot_lo, quot_hi);

            // Compare remainder >= divisor (32-bit compare)
            if rem_hi > divisor_hi {
                borrow = false;
                if rem_lo < divisor_lo {
                    borrow = true;
                }
                rem_lo = rem_lo - divisor_lo;
                rem_hi = rem_hi - divisor_hi;
                if borrow {
                    rem_hi = rem_hi - 1;
                }
                quot_lo = quot_lo | 1;
            } else if rem_hi == divisor_hi {
                if rem_lo >= divisor_lo {
                    rem_lo = rem_lo - divisor_lo;
                    rem_hi = rem_hi - divisor_hi;
                    quot_lo = quot_lo | 1;
                }
            }

            bit_count--;
            if bit_count == 0 {
                break;
            }
        }

        self.lo = quot_lo;
        self.hi = quot_hi;

        // Fix sign of result
        if negate_result {
            self.neg();
        }
    }
}

/// Powers the ordering operators (`<`, `<=`, `>`, `>=`) through a signed three-way `cmp`.
impl PartialOrd for I32 {
    /// Compares `self` with `other` (signed), returning `1` if `self > other`,
    /// `0` if equal, or `-1` if `self < other`.
    far fn cmp(far *self, other: far *I32) -> i8 {
        let s_hi: u16 = self.hi;
        let mut o_hi: u16 = other.hi;

        // Check if signs differ
        if (s_hi ^ o_hi) & 0x8000 != 0 {
            // Signs differ - negative is less than positive
            if (s_hi & 0x8000) != 0 {
                A = 0xFF; return A;  // self negative, other positive: self < other
            }
            A = 1; return A;  // self positive, other negative: self > other
        }

        // Same sign - unsigned comparison gives correct signed ordering
        if s_hi > o_hi { A = 1; return A; }
        if s_hi < o_hi { A = 0xFF; return A; }
        let s_lo: u16 = self.lo;
        let o_lo: u16 = other.lo;
        if s_lo > o_lo { A = 1; return A; }
        if s_lo < o_lo { A = 0xFF; return A; }
        A = 0;
        return A;
    }
}

// ============================================================================
// I32 Operator Overloading: equality
// ============================================================================
// Arithmetic (`+=` `-=` `*=` `/=`) lives in the AddAssign/SubAssign/MulAssign/
// DivAssign impls above; ordering (`<` `<=` `>` `>=`) in PartialOrd::cmp. The
// methods *are* the implementation (no forwarders). PartialEq derives `==`/`!=`.

/// Powers the equality operators (`==`, `!=`) by comparing all 32 bits.
impl PartialEq for I32 { far fn eq(far *self, other: far *I32) -> bool { return self.cmp(other) == 0; } }

/// Enables `Clone` for `I32` — `let c = a.clone()` and `dst.clone_from(&src)` copy
/// all four bytes. The empty body selects the compiler's automatic bitwise copy.
impl Clone for I32 {}

// ============================================================================
// I32 ToString
// ============================================================================

/// Formats `self` as a signed decimal ASCII string (used by `format!`'s `{}`).
impl ToString for I32 {
    /// Writes the NUL-terminated decimal representation of `self` (with a leading
    /// `-` when negative) into `buf` and returns the character count.
    ///
    /// # Parameters
    /// - `buf` — destination buffer (needs room for sign + up to 10 digits + NUL)
    fn to_string(far *self, buf: far *u8) -> u16 {
        let mut __i32_tostr_tmp: I32;
        let mut __i32_tostr_digits: [u8; 11];
        // Special case: INT_MIN (-2147483648) cannot be negated
        if self.hi == 0x8000 && self.lo == 0 {
            buf[0 as u16] = '-' as u8;
            buf[1 as u16] = '2' as u8;
            buf[2 as u16] = '1' as u8;
            buf[3 as u16] = '4' as u8;
            buf[4 as u16] = '7' as u8;
            buf[5 as u16] = '4' as u8;
            buf[6 as u16] = '8' as u8;
            buf[7 as u16] = '3' as u8;
            buf[8 as u16] = '6' as u8;
            buf[9 as u16] = '4' as u8;
            buf[10 as u16] = '8' as u8;
            buf[11 as u16] = 0;
            return 11;
        }
        __i32_tostr_tmp.lo = self.lo;
        __i32_tostr_tmp.hi = self.hi;
        if __i32_tostr_tmp.hi == 0 && __i32_tostr_tmp.lo == 0 {
            buf[0 as u16] = 0x30;
            buf[1 as u16] = 0;
            return 1;
        }
        let mut pos: u8 = 0;
        if (__i32_tostr_tmp.hi & 0x8000) != 0 {
            buf[0 as u16] = '-' as u8;
            pos = 1;
            _i32_negate!(__i32_tostr_tmp.lo, __i32_tostr_tmp.hi);
        }
        let mut count: u8 = 0;
        loop {
            let d: i8 = __i32_tostr_tmp.div_i8(10);
            __i32_tostr_digits[count as u16] = (d as u8) + 0x30;
            count++;
            if __i32_tostr_tmp.hi == 0 && __i32_tostr_tmp.lo == 0 { break; }
        }
        let mut i: u8 = count;
        let mut j: u8 = pos;
        loop {
            if i == 0 { break; }
            i--;
            buf[j as u16] = __i32_tostr_digits[i as u16];
            j++;
        }
        let total: u8 = pos + count;
        buf[total as u16] = 0;
        return total as u16;
    }
}
