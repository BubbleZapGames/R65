// R65 Standard Library - I32 (32-bit Signed Integer) Support
//
// Provides 32-bit signed integer arithmetic, comparisons, and conversions.
// Uses two's complement representation.
// All methods avoid explicit A register usage for correct codegen in m8 mode.
//
// Usage:
//   include!("lib/I32.r65")

include!("math.r65")

// ============================================================================
// I32 (32-bit Signed Integer) Support
// ============================================================================

// 32-bit signed integer (little-endian, two's complement)
// Size: 4 bytes, packed
struct I32 {
    lo: u16,    // Offset 0-1: Low 16 bits
    hi: u16     // Offset 2-3: High 16 bits (bit 15 = sign bit)
}

// Initialize an I32 from a compile-time constant value.
// Usage: static mut OFFSET: I32 = I32!(-42);
macro_rules! I32($value:expr) {
    I32 { lo: (($value) & 0xFFFF) as u16, hi: ((($value) >> 16) & 0xFFFF) as u16 }
}

// ============================================================================
// Internal Macros
// ============================================================================

// Shift 32-bit value left by 1 bit (no A register usage)
macro_rules! _i32_shl1($lo:expr, $hi:expr) {
    if ($lo & 0x8000) != 0 {
        $lo = $lo + $lo;
        $hi = $hi + $hi;
        $hi = $hi | 1;
    } else {
        $lo = $lo + $lo;
        $hi = $hi + $hi;
    }
}

// Shift 32-bit value right by 1 bit (logical - zero fill, no A register usage)
macro_rules! _i32_shr1($lo:expr, $hi:expr) {
    if ($hi & 1) != 0 {
        $hi = $hi >> 1;
        $lo = $lo >> 1;
        $lo = $lo | 0x8000;
    } else {
        $hi = $hi >> 1;
        $lo = $lo >> 1;
    }
}

// Negate 32-bit value in place (two's complement: ~val + 1, no A register usage)
macro_rules! _i32_negate($lo:expr, $hi:expr) {
    $lo = $lo ^ 0xFFFF;
    $hi = $hi ^ 0xFFFF;
    $lo = $lo + 1;
    if $lo == 0 {
        $hi = $hi + 1;
    }
}

// SNES hardware division step: divides (remainder:byte) by divisor
// Expects byte value already in A. Reads divisor from X.
// Only used within #[cfg(snes)] functions
macro_rules! _hwdiv_step($remainder:expr) {
    WRDIVL = A;
    A = $remainder;
    WRDIVH = A;
    WRDIVB = X;
    NOP(8);
}

// First hardware division step (remainder starts at 0)
// Expects byte value already in A. Reads divisor from X.
// Only used within #[cfg(snes)] functions
macro_rules! _hwdiv_first() {
    WRDIVL = A;
    WRDIVH = 0;
    WRDIVB = X;
    NOP(8);
}

// ============================================================================
// I32 Implementation
// ============================================================================

impl far I32 {
    // ========================================================================
    // Binary operation macros: dest = self op b
    // Usage: a.add_to!(b, dest)  →  dest = a + b
    // ========================================================================

    // dest = self + b
    macro_rules! add_to($b:ident, $dest:ident) {
        $dest.copy(self);
        $dest.add($b);
    }

    // dest = self - b
    macro_rules! sub_to($b:ident, $dest:ident) {
        $dest.copy(self);
        $dest.sub($b);
    }

    // dest = self * b
    macro_rules! mul_to($b:ident, $dest:ident) {
        $dest.copy(self);
        $dest.mul($b);
    }

    // dest = self / b
    macro_rules! div_to($b:ident, $dest:ident) {
        $dest.copy(self);
        $dest.div($b);
    }

    // dest = self % b
    macro_rules! mod_to($b:ident, $dest:ident) {
        $dest.copy(self);
        $dest.mod($b);
    }

    // dest = -self
    macro_rules! neg_to($dest:ident) {
        $dest.copy(self);
        $dest.neg();
    }

    // dest = |self|
    macro_rules! abs_to($dest:ident) {
        $dest.copy(self);
        $dest.abs();
    }

    // ========================================================================
    // Conversion and Copy Methods
    // ========================================================================

    // Copy another I32 into self
    #[inline(always)]
    far fn copy(far *self, src: far *I32) {
        self.lo = src.lo;
        self.hi = src.hi;
    }

    // Initialize from i16 (sign-extend)
    // If value is negative, extends 0xFFFF to high word
    #[inline(always)]
    far fn from_i16(far *self, value: u16) {
        self.lo = value;
        // Check sign bit (bit 15)
        if value & 0x8000 != 0 {
            // Negative: sign extend with 0xFFFF
            self.hi = 0xFFFF;
        } else {
            // Positive: zero extend
            self.hi = 0;
        }
    }

    // Initialize from u16 (zero-extend, for positive values only)
    #[inline(always)]
    far fn from_u16(far *self, value: u16) {
        self.lo = value;
        self.hi = 0;
    }

    // Convert to i16 (truncate, keeps low 16 bits)
    #[inline(always)]
    far fn to_i16(far *self) -> i16 {
        return self.lo as i16;
    }

    // ========================================================================
    // Sign-Related Methods
    // ========================================================================

    // Check if the value is negative (sign bit set)
    // Returns true if negative, false if zero or positive
    #[inline(always)]
    far fn is_negative(far *self) -> bool {
        let hi: u16 = self.hi;
        if (hi & 0x8000) != 0 {
            return true;
        }
        return false;
    }

    // Negate the value (two's complement: ~self + 1)
    #[inline(always)]
    far fn neg(far *self) {
        let mut lo: u16 = self.lo;
        let mut hi: u16 = self.hi;
        _i32_negate!(lo, hi);
        self.lo = lo;
        self.hi = hi;
    }

    // Absolute value: if negative, negate
    #[inline(always)]
    far fn abs(far *self) {
        let hi: u16 = self.hi;
        if (hi & 0x8000) != 0 {
            self.neg();
        }
    }

    // ========================================================================
    // Arithmetic Methods (all modify self in-place)
    // ========================================================================

    // Add a i16 value: self += value (sign-extends value to 32 bits)
    far fn add_i16(far *self, value @ A: u16) {
        // Sign-extend: if bit 15 set, hi = 0xFFFF; else hi = 0
        let o_lo: u16 = A;
        let mut o_hi: u16 = 0;
        if (o_lo & 0x8000) != 0 {
            o_hi = 0xFFFF;
        }
        let s_lo: u16 = self.lo;
        let r_lo: u16 = s_lo + o_lo;
        let mut r_hi: u16 = self.hi + o_hi;
        if r_lo < o_lo {
            r_hi = r_hi + 1;
        }
        self.lo = r_lo;
        self.hi = r_hi;
    }

    // Subtract a i16 value: self -= value (sign-extends value to 32 bits)
    far fn sub_i16(far *self, value @ A: u16) {
        // Sign-extend: if bit 15 set, hi = 0xFFFF; else hi = 0
        let o_lo: u16 = A;
        let mut o_hi: u16 = 0;
        if (o_lo & 0x8000) != 0 {
            o_hi = 0xFFFF;
        }
        let s_lo: u16 = self.lo;
        let s_hi: u16 = self.hi;
        let r_lo: u16 = s_lo - o_lo;
        let mut r_hi: u16 = s_hi - o_hi;
        if s_lo < o_lo {
            r_hi = r_hi - 1;
        }
        self.lo = r_lo;
        self.hi = r_hi;
    }

    // Multiply by a i16 value: self *= value (sign-extends value to 32 bits)
    far fn mul_i16(far *self, value @ A: u16) {
        let mut mplier: u16 = A;
        let mut negate_result: bool = false;

        let s_hi: u16 = self.hi;
        if (s_hi ^ mplier) & 0x8000 != 0 {
            negate_result = true;
        }

        // Make self positive
        if (s_hi & 0x8000) != 0 {
            self.neg();
        }

        // Get absolute value of value
        if (mplier & 0x8000) != 0 {
            mplier = mplier ^ 0xFFFF;
            mplier = mplier + 1;
        }

        let mut result_lo: u16 = 0;
        let mut result_hi: u16 = 0;
        let mut mcand_lo: u16 = self.lo;
        let mut mcand_hi: u16 = self.hi;
        let mut new_lo: u16 = 0;
        let mut carry: bool = false;

        loop {
            if mplier == 0 {
                break;
            }
            if (mplier & 1) != 0 {
                new_lo = result_lo + mcand_lo;
                carry = false;
                if new_lo < result_lo {
                    carry = true;
                }
                result_lo = new_lo;
                result_hi = result_hi + mcand_hi;
                if carry {
                    result_hi = result_hi + 1;
                }
            }
            _i32_shl1!(mcand_lo, mcand_hi);
            mplier = mplier >> 1;
        }

        self.lo = result_lo;
        self.hi = result_hi;

        if negate_result {
            self.neg();
        }
    }

    // Divide by a i16 value: self /= value (rounds toward zero)
    // Returns MIN_I32 if value == 0.
    far fn div_i16(far *self, value @ A: u16) {
        if A == 0 {
            self.lo = 0;
            self.hi = 0x8000;
            return;
        }

        let mut divisor: u16 = A;
        let mut negate_result: bool = false;

        let s_hi: u16 = self.hi;
        if (s_hi ^ divisor) & 0x8000 != 0 {
            negate_result = true;
        }

        // Take absolute value of self
        let mut dividend_lo: u16 = self.lo;
        let mut dividend_hi: u16 = self.hi;
        if (dividend_hi & 0x8000) != 0 {
            _i32_negate!(dividend_lo, dividend_hi);
        }

        // Get absolute value of divisor (u16 only)
        if (divisor & 0x8000) != 0 {
            divisor = divisor ^ 0xFFFF;
            divisor = divisor + 1;
        }

        let mut rem_lo: u16 = 0;
        let mut rem_hi: u16 = 0;
        let mut quot_lo: u16 = 0;
        let mut quot_hi: u16 = 0;
        let mut bit_count: u8 = 32;
        let mut borrow: bool = false;

        loop {
            _i32_shl1!(rem_lo, rem_hi);
            if (dividend_hi & 0x8000) != 0 {
                rem_lo = rem_lo | 1;
            }
            _i32_shl1!(dividend_lo, dividend_hi);
            _i32_shl1!(quot_lo, quot_hi);

            // Divisor hi is always 0 (sign-magnitude fits in u16)
            if rem_hi > 0 {
                borrow = false;
                if rem_lo < divisor {
                    borrow = true;
                }
                rem_lo = rem_lo - divisor;
                if borrow {
                    rem_hi = rem_hi - 1;
                }
                quot_lo = quot_lo | 1;
            } else if rem_lo >= divisor {
                rem_lo = rem_lo - divisor;
                quot_lo = quot_lo | 1;
            }

            bit_count--;
            if bit_count == 0 {
                break;
            }
        }

        self.lo = quot_lo;
        self.hi = quot_hi;

        if negate_result {
            self.neg();
        }
    }

    // Modulo by a i16 value: self %= value (remainder has same sign as dividend)
    // Unchanged if value == 0.
    far fn mod_i16(far *self, value @ A: u16) {
        let mut divisor_lo: u16 = A;
        if divisor_lo == 0 {
            return;
        }

        let mut negate_result: bool = false;

        // Remainder has same sign as dividend
        let s_hi: u16 = self.hi;
        if (s_hi & 0x8000) != 0 {
            negate_result = true;
        }

        // Take absolute value of dividend (self)
        let mut dividend_lo: u16 = self.lo;
        let mut dividend_hi: u16 = self.hi;
        if (dividend_hi & 0x8000) != 0 {
            _i32_negate!(dividend_lo, dividend_hi);
        }

        // Sign-extend divisor and take absolute value
        let mut divisor_hi: u16 = 0;
        if (divisor_lo & 0x8000) != 0 {
            divisor_hi = 0xFFFF;
            _i32_negate!(divisor_lo, divisor_hi);
        }

        let mut rem_lo: u16 = 0;
        let mut rem_hi: u16 = 0;
        let mut bit_count: u8 = 32;
        let mut borrow: bool = false;

        loop {
            _i32_shl1!(rem_lo, rem_hi);
            if (dividend_hi & 0x8000) != 0 {
                rem_lo = rem_lo | 1;
            }
            _i32_shl1!(dividend_lo, dividend_hi);

            if rem_hi > divisor_hi {
                borrow = false;
                if rem_lo < divisor_lo {
                    borrow = true;
                }
                rem_lo = rem_lo - divisor_lo;
                rem_hi = rem_hi - divisor_hi;
                if borrow {
                    rem_hi = rem_hi - 1;
                }
            } else if rem_hi == divisor_hi {
                if rem_lo >= divisor_lo {
                    rem_lo = rem_lo - divisor_lo;
                    rem_hi = rem_hi - divisor_hi;
                }
            }

            bit_count--;
            if bit_count == 0 {
                break;
            }
        }

        self.lo = rem_lo;
        self.hi = rem_hi;

        if negate_result {
            self.neg();
        }
    }

    // Add: self += other (with overflow wrapping)
    // Two's complement addition is identical to unsigned
    far fn add(far *self, other: far *I32) {
        let s_lo: u16 = self.lo;
        let s_hi: u16 = self.hi;
        let o_lo: u16 = other.lo;
        let o_hi: u16 = other.hi;
        let r_lo: u16 = s_lo + o_lo;
        let mut r_hi: u16 = s_hi + o_hi;
        // Carry: unsigned addition overflowed if result < operand
        if r_lo < o_lo {
            r_hi = r_hi + 1;
        }
        self.lo = r_lo;
        self.hi = r_hi;
    }

    // Subtract: self -= other (with underflow wrapping)
    // Two's complement subtraction is identical to unsigned
    far fn sub(far *self, other: far *I32) {
        let s_lo: u16 = self.lo;
        let s_hi: u16 = self.hi;
        let o_lo: u16 = other.lo;
        let o_hi: u16 = other.hi;
        let r_lo: u16 = s_lo - o_lo;
        let mut r_hi: u16 = s_hi - o_hi;
        // Borrow: underflow occurred if self.lo < other.lo
        if s_lo < o_lo {
            r_hi = r_hi - 1;
        }
        self.lo = r_lo;
        self.hi = r_hi;
    }

    // Multiply: self *= other (32x32 -> 32, lower 32 bits only)
    // Signed multiplication: track signs, multiply magnitudes, fix sign
    far fn mul(far *self, other: far *I32) {
        let mut negate_result: bool = false;

        // Determine if result should be negative (signs differ)
        let s_hi: u16 = self.hi;
        let o_hi: u16 = other.hi;
        if (s_hi ^ o_hi) & 0x8000 != 0 {
            negate_result = true;
        }

        // Make self positive
        if (s_hi & 0x8000) != 0 {
            self.neg();
        }

        // Copy other's magnitude into locals
        let mut other_lo: u16 = other.lo;
        let mut other_hi: u16 = other.hi;
        if (other_hi & 0x8000) != 0 {
            _i32_negate!(other_lo, other_hi);
        }

        // Software shift-and-add multiply (magnitudes)
        let mut result_lo: u16 = 0;
        let mut result_hi: u16 = 0;
        let mut mcand_lo: u16 = self.lo;
        let mut mcand_hi: u16 = self.hi;
        let mut mplier_lo: u16 = other_lo;
        let mut mplier_hi: u16 = other_hi;
        let mut new_lo: u16 = 0;
        let mut carry: bool = false;

        loop {
            if mplier_lo == 0 {
                if mplier_hi == 0 {
                    break;
                }
            }

            if (mplier_lo & 1) != 0 {
                // 32-bit add: result += multiplicand
                new_lo = result_lo + mcand_lo;
                carry = false;
                if new_lo < result_lo {
                    carry = true;
                }
                result_lo = new_lo;
                result_hi = result_hi + mcand_hi;
                if carry {
                    result_hi = result_hi + 1;
                }
            }

            _i32_shl1!(mcand_lo, mcand_hi);
            _i32_shr1!(mplier_lo, mplier_hi);
        }

        self.lo = result_lo;
        self.hi = result_hi;

        // Fix sign of result
        if negate_result {
            self.neg();
        }
    }

    // Divide: self /= other (rounds toward zero, returns MIN_I32 if other == 0)
    // Signed division: track signs, divide magnitudes, fix sign
    far fn div(far *self, other: far *I32) {
        let o_lo: u16 = other.lo;
        let o_hi: u16 = other.hi;

        // Handle division by zero
        if o_lo == 0 {
            if o_hi == 0 {
                // Return MIN_I32 (0x80000000) for division by zero
                self.lo = 0;
                self.hi = 0x8000;
                return;
            }
        }

        let mut negate_result: bool = false;

        // Determine if result should be negative (signs differ)
        let s_hi: u16 = self.hi;
        if (s_hi ^ o_hi) & 0x8000 != 0 {
            negate_result = true;
        }

        // Copy dividend (self) and take absolute value
        let mut dividend_lo: u16 = self.lo;
        let mut dividend_hi: u16 = self.hi;
        if (dividend_hi & 0x8000) != 0 {
            _i32_negate!(dividend_lo, dividend_hi);
        }

        // Copy divisor (other) and take absolute value
        let mut divisor_lo: u16 = o_lo;
        let mut divisor_hi: u16 = o_hi;
        if (divisor_hi & 0x8000) != 0 {
            _i32_negate!(divisor_lo, divisor_hi);
        }

        // Long division on magnitudes
        let mut rem_lo: u16 = 0;
        let mut rem_hi: u16 = 0;
        let mut quot_lo: u16 = 0;
        let mut quot_hi: u16 = 0;
        let mut bit_count: u8 = 32;
        let mut borrow: bool = false;

        loop {
            // Shift remainder left by 1
            _i32_shl1!(rem_lo, rem_hi);

            // Get MSB of dividend into remainder
            if (dividend_hi & 0x8000) != 0 {
                rem_lo = rem_lo | 1;
            }

            // Shift dividend left
            _i32_shl1!(dividend_lo, dividend_hi);

            // Shift quotient left
            _i32_shl1!(quot_lo, quot_hi);

            // Compare remainder >= divisor (32-bit compare)
            if rem_hi > divisor_hi {
                borrow = false;
                if rem_lo < divisor_lo {
                    borrow = true;
                }
                rem_lo = rem_lo - divisor_lo;
                rem_hi = rem_hi - divisor_hi;
                if borrow {
                    rem_hi = rem_hi - 1;
                }
                quot_lo = quot_lo | 1;
            } else if rem_hi == divisor_hi {
                if rem_lo >= divisor_lo {
                    rem_lo = rem_lo - divisor_lo;
                    rem_hi = rem_hi - divisor_hi;
                    quot_lo = quot_lo | 1;
                }
            }

            bit_count--;
            if bit_count == 0 {
                break;
            }
        }

        self.lo = quot_lo;
        self.hi = quot_hi;

        // Fix sign of result
        if negate_result {
            self.neg();
        }
    }

    // Modulo: self %= other (remainder has same sign as dividend)
    // Unchanged if other == 0
    far fn mod(far *self, other: far *I32) {
        let o_lo: u16 = other.lo;
        let o_hi: u16 = other.hi;

        // Handle division by zero - leave self unchanged
        if o_lo == 0 {
            if o_hi == 0 {
                return;
            }
        }

        let mut negate_result: bool = false;

        // Remainder has same sign as dividend
        let s_hi: u16 = self.hi;
        if (s_hi & 0x8000) != 0 {
            negate_result = true;
        }

        // Copy dividend (self) and take absolute value
        let mut dividend_lo: u16 = self.lo;
        let mut dividend_hi: u16 = self.hi;
        if (dividend_hi & 0x8000) != 0 {
            _i32_negate!(dividend_lo, dividend_hi);
        }

        // Copy divisor (other) and take absolute value
        let mut divisor_lo: u16 = o_lo;
        let mut divisor_hi: u16 = o_hi;
        if (divisor_hi & 0x8000) != 0 {
            _i32_negate!(divisor_lo, divisor_hi);
        }

        // Long division on magnitudes, keeping remainder
        let mut rem_lo: u16 = 0;
        let mut rem_hi: u16 = 0;
        let mut bit_count: u8 = 32;
        let mut borrow: bool = false;

        loop {
            // Shift remainder left by 1
            _i32_shl1!(rem_lo, rem_hi);

            // Get MSB of dividend into remainder
            if (dividend_hi & 0x8000) != 0 {
                rem_lo = rem_lo | 1;
            }

            // Shift dividend left
            _i32_shl1!(dividend_lo, dividend_hi);

            // Compare remainder >= divisor
            if rem_hi > divisor_hi {
                borrow = false;
                if rem_lo < divisor_lo {
                    borrow = true;
                }
                rem_lo = rem_lo - divisor_lo;
                rem_hi = rem_hi - divisor_hi;
                if borrow {
                    rem_hi = rem_hi - 1;
                }
            } else if rem_hi == divisor_hi {
                if rem_lo >= divisor_lo {
                    rem_lo = rem_lo - divisor_lo;
                    rem_hi = rem_hi - divisor_hi;
                }
            }

            bit_count--;
            if bit_count == 0 {
                break;
            }
        }

        self.lo = rem_lo;
        self.hi = rem_hi;

        // Fix sign of result (remainder has same sign as dividend)
        if negate_result {
            self.neg();
        }
    }

    // ========================================================================
    // Comparison Method
    // ========================================================================

    // Compare self with other (signed comparison).
    // Returns: 1 if self > other, 0 if equal, -1 if self < other
    far fn cmp(far *self, other: far *I32) -> i8 {
        let s_hi: u16 = self.hi;
        let o_hi: u16 = other.hi;

        // Check if signs differ
        if (s_hi ^ o_hi) & 0x8000 != 0 {
            // Signs differ - negative is less than positive
            if (s_hi & 0x8000) != 0 {
                A = 0xFF; return A;  // self negative, other positive: self < other
            }
            A = 1; return A;  // self positive, other negative: self > other
        }

        // Same sign - unsigned comparison gives correct signed ordering
        if s_hi > o_hi { A = 1; return A; }
        if s_hi < o_hi { A = 0xFF; return A; }
        let s_lo: u16 = self.lo;
        let o_lo: u16 = other.lo;
        if s_lo > o_lo { A = 1; return A; }
        if s_lo < o_lo { A = 0xFF; return A; }
        A = 0;
        return A;
    }

    // ========================================================================
    // Bitwise Shift Methods
    // ========================================================================

    // Shift left by n bits (in place) - identical to unsigned
    far fn shl(far *self, count @ X: u16) {
        let mut lo: u16 = self.lo;
        let mut hi: u16 = self.hi;
        loop {
            if X == 0 {
                break;
            }
            if (lo & 0x8000) != 0 {
                lo = lo + lo;
                hi = hi + hi;
                hi = hi | 1;
            } else {
                lo = lo + lo;
                hi = hi + hi;
            }
            X--;
        }
        self.lo = lo;
        self.hi = hi;
    }

    // Arithmetic shift right by n bits (in place) - preserves sign bit
    far fn sar(far *self, count @ X: u16) {
        let mut lo: u16 = self.lo;
        let mut hi: u16 = self.hi;
        loop {
            if X == 0 {
                break;
            }
            // Save sign bit and low bit of hi
            let mut sign_bit: bool = false;
            if (hi & 0x8000) != 0 {
                sign_bit = true;
            }
            // Shift right: hi then lo with carry
            if (hi & 1) != 0 {
                hi = hi >> 1;
                lo = lo >> 1;
                lo = lo | 0x8000;
            } else {
                hi = hi >> 1;
                lo = lo >> 1;
            }
            // Restore sign bit
            if sign_bit {
                hi = hi | 0x8000;
            }
            X--;
        }
        self.lo = lo;
        self.hi = hi;
    }

    // ========================================================================
    // SNES Hardware-Accelerated Division
    // ========================================================================

    // Divide by signed 8-bit value using SNES hardware divider.
    // self /= divisor, returns remainder.
    // Signed version: handles sign conversion.
    // If divisor is 0, sets self to MIN_I32 and returns 0.
    #[cfg(snes)]
    far fn div_i8(far *self, divisor @ X: u16) -> i8 {
        let mut remainder: u8;
        let mut q3: u8;
        let mut q2: u8;
        let mut q1: u8;
        let mut q0: u8;
        let mut hi_word: u16;
        let mut lo_word: u16;
        let mut negate_result: bool = false;
        let mut negate_remainder: bool = false;
        let mut abs_divisor: u8;

        // Handle division by zero
        if X == 0 {
            self.lo = 0;
            self.hi = 0x8000;  // MIN_I32
            A = 0;
            return A as i8;
        }

        // Determine signs
        A = self.hi >> 8;  // Get high byte of hi word (sign byte)
        if A & 0x80 != 0 {
            negate_result = true;
            negate_remainder = true;
            // Negate self (make positive)
            self.neg();
        }

        // Get absolute value of divisor
        A = X as u8;
        if A & 0x80 != 0 {
            negate_result = !negate_result;  // XOR sign flags
            // Negate divisor
            A = A ^ 0xFF;
            A = A + 1;
        }
        abs_divisor = A;
        X = A;

        // Load words into locals
        hi_word = self.hi;
        lo_word = self.lo;

        // Process 4 bytes from MSB to LSB using hardware divider
        A = (hi_word >> 8) as u8;
        _hwdiv_first!();
        q3 = RDDIVL;
        remainder = RDMPYL;

        A = hi_word as u8;
        _hwdiv_step!(remainder);
        q2 = RDDIVL;
        remainder = RDMPYL;

        A = (lo_word >> 8) as u8;
        _hwdiv_step!(remainder);
        q1 = RDDIVL;
        remainder = RDMPYL;

        A = lo_word as u8;
        _hwdiv_step!(remainder);
        q0 = RDDIVL;
        remainder = RDMPYL;

        // Reassemble quotient into self
        self.lo = ((q1 as u16) << 8) | (q0 as u16);
        self.hi = ((q3 as u16) << 8) | (q2 as u16);

        // Fix signs
        if negate_result {
            self.neg();
        }
        if negate_remainder {
            A = remainder;
            A = A ^ 0xFF;
            A = A + 1;
            remainder = A;
        }

        A = remainder;
        return A as i8;
    }

    // Modulo by signed 8-bit value using SNES hardware divider.
    // self %= divisor (self becomes remainder, which fits in 8 bits).
    // If divisor is 0, self is unchanged.
    #[cfg(snes)]
    far fn mod_i8(far *self, divisor @ X: u16) {
        // Handle zero divisor
        if X == 0 {
            return;
        }

        // div_i8 computes quotient (stored in self) and returns remainder
        let mut remainder: i8 = self.div_i8(X);

        // Sign extend remainder to 32 bits
        A = remainder as u8;
        if A & 0x80 != 0 {
            // Negative: sign extend
            self.lo = (0xFF00 | (A as u16));
            self.hi = 0xFFFF;
        } else {
            // Positive: zero extend
            self.lo = A as u16;
            self.hi = 0;
        }
    }
}
