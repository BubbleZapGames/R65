// ============================================================================
// R65 Standard Library - Console (Text Output via Background Tiles)
//
// Provides a reusable Console struct for formatted text output on SNES.
// Renders text by writing tile indices into a RAM nametable buffer,
// which the caller DMA-transfers to VRAM each frame.
//
// Dependencies (include before this file):
//   - stdlib/string.r65  (strlen, format!)
//   - stdlib/sneslib.r65  (VRAM registers, DMA macros)
//
// Usage:
//   include!("lib/sneslib.r65")
//   include!("lib/string.r65")
//   include!("lib/console.r65")
// ============================================================================

// ============================================================================
// Alignment Constants
// ============================================================================

const CONSOLE_ALIGN_LEFT: u8 = 0;
const CONSOLE_ALIGN_CENTER: u8 = 1;
const CONSOLE_ALIGN_RIGHT: u8 = 2;

// ============================================================================
// Console Struct (14 bytes, packed)
// ============================================================================

struct Console {
    nametable: far *u16,   // 3 bytes - pointer to caller's nametable buffer
    cursor_x: u8,          // current column (relative to area)
    cursor_y: u8,          // current row (relative to area)
    area_x: u8,            // left column of text area (0-31)
    area_y: u8,            // top row of text area (0-31)
    area_w: u8,            // width in tiles (1-32)
    area_h: u8,            // height in tiles (1-32)
    tile_attr: u16,        // attribute bits OR'd into each entry (palette, priority, flip)
    tile_base: u16,        // base tile index for ASCII mapping (char 32 -> tile_base + 0)
    align: u8              // CONSOLE_ALIGN_LEFT / CENTER / RIGHT
}

// ============================================================================
// Console Implementation
// ============================================================================

impl far Console {

    // ========================================================================
    // Initialization
    // ========================================================================

    // Initialize console with nametable pointer, tile base, and tile attributes.
    // Defaults: cursor (0,0), area (0,0,32,28), align left.
    far fn init(far *self, nametable: far *u16, tile_base: u16, tile_attr: u16) {
        self.nametable = nametable;
        self.tile_base = tile_base;
        self.tile_attr = tile_attr;
        self.cursor_x = 0;
        self.cursor_y = 0;
        self.area_x = 0;
        self.area_y = 0;
        self.area_w = 32;
        self.area_h = 28;
        self.align = CONSOLE_ALIGN_LEFT;
    }

    // ========================================================================
    // Configuration
    // ========================================================================

    // Set text area bounds and reset cursor to (0,0).
    far fn set_area(far *self, x: u8, y: u8, w: u8, h: u8) {
        self.area_x = x;
        self.area_y = y;
        self.area_w = w;
        self.area_h = h;
        self.cursor_x = 0;
        self.cursor_y = 0;
    }

    // Set cursor position (relative to text area).
    far fn set_cursor(far *self, x: u8, y: u8) {
        self.cursor_x = x;
        self.cursor_y = y;
    }

    // Set text alignment mode.
    far fn set_align(far *self, align: u8) {
        self.align = align;
    }

    // Change font tile base index.
    far fn set_tile_base(far *self, base: u16) {
        self.tile_base = base;
    }

    // Change tile attribute bits.
    far fn set_attr(far *self, attr: u16) {
        self.tile_attr = attr;
    }

    // ========================================================================
    // Output
    // ========================================================================

    // Write a single character at the cursor position and advance cursor.
    far fn putc(far *self, ch: u8) {
        let c: u8 = ch;
        let nt: far *u16 = self.nametable;
        let attr: u16 = self.tile_attr;
        let base: u16 = self.tile_base;
        let aw: u8 = self.area_w;
        let ah: u8 = self.area_h;

        // Handle newline
        if c == 0x0A {
            self.cursor_x = 0;
            let mut cy: u8 = self.cursor_y + 1;
            if cy >= ah {
                cy = 0;
            }
            self.cursor_y = cy;
            return;
        }

        // Compute nametable offset: (area_y + cursor_y) * 32 + area_x + cursor_x
        let row: u16 = (self.area_y + self.cursor_y) as u16;
        let col: u16 = (self.area_x + self.cursor_x) as u16;
        let offset: u16 = (row << 5) + col;

        // Compute tile entry: (ch - 32 + tile_base) | tile_attr
        let tile: u16 = ((c as u16) - 32 + base) | attr;
        nt[offset] = tile;

        // Advance cursor
        let mut cx: u8 = self.cursor_x + 1;
        if cx >= aw {
            cx = 0;
            let mut cy: u8 = self.cursor_y + 1;
            if cy >= ah {
                cy = 0;
            }
            self.cursor_y = cy;
        }
        self.cursor_x = cx;
    }

    // Move cursor to start of next row.
    far fn newline(far *self) {
        self.cursor_x = 0;
        let ah: u8 = self.area_h;
        let mut cy: u8 = self.cursor_y + 1;
        if cy >= ah {
            cy = 0;
        }
        self.cursor_y = cy;
    }

    // Streaming write: walk null-terminated string, convert each ASCII char
    // to tile entry, write to nametable. Supports \n (0x0A) as newline.
    far fn print(far *self, str: far *u8) {
        let s: far *u8 = str;
        let nt: far *u16 = self.nametable;
        let attr: u16 = self.tile_attr;
        let base: u16 = self.tile_base;
        let aw: u8 = self.area_w;
        let ah: u8 = self.area_h;
        let ax: u8 = self.area_x;
        let ay: u8 = self.area_y;
        let mut cx: u8 = self.cursor_x;
        let mut cy: u8 = self.cursor_y;
        let mut i: u16 = 0;

        loop {
            let c: u8 = s[i];
            if c == 0 { break; }

            if c == 0x0A {
                // Newline
                cx = 0;
                cy++;
                if cy >= ah {
                    cy = 0;
                }
            } else {
                // Compute nametable offset
                let row: u16 = (ay + cy) as u16;
                let col: u16 = (ax + cx) as u16;
                let offset: u16 = (row << 5) + col;

                // Write tile
                let tile: u16 = ((c as u16) - 32 + base) | attr;
                nt[offset] = tile;

                // Advance cursor
                cx++;
                if cx >= aw {
                    cx = 0;
                    cy++;
                    if cy >= ah {
                        cy = 0;
                    }
                }
            }

            i++;
        }

        // Write back cursor state
        self.cursor_x = cx;
        self.cursor_y = cy;
    }

    // Set cursor to (x, y) then print string.
    far fn print_at(far *self, x: u8, y: u8, str: far *u8) {
        self.cursor_x = x;
        self.cursor_y = y;
        self.print(str);
    }

    // Alignment-aware print: compute starting X from alignment mode,
    // clear the current row, write string at computed offset, advance to next row.
    far fn print_line(far *self, str: far *u8) {
        let s: far *u8 = str;
        let nt: far *u16 = self.nametable;
        let attr: u16 = self.tile_attr;
        let base: u16 = self.tile_base;
        let aw: u8 = self.area_w;
        let ah: u8 = self.area_h;
        let ax: u8 = self.area_x;
        let ay: u8 = self.area_y;
        let cy: u8 = self.cursor_y;
        let alignment: u8 = self.align;

        // Compute string length (capped at area width)
        let mut len: u8 = strlen(s) as u8;
        if len > aw {
            len = aw;
        }

        // Compute start_x from alignment
        let mut start_x: u8 = 0;
        if alignment == CONSOLE_ALIGN_CENTER {
            start_x = (aw - len) >> 1;
        } else if alignment == CONSOLE_ALIGN_RIGHT {
            start_x = aw - len;
        }

        // Clear the row with space tiles
        let row_base: u16 = ((ay + cy) as u16) << 5;
        let space_tile: u16 = base | attr;
        let mut col: u8 = 0;
        loop {
            if col >= aw { break; }
            let off: u16 = row_base + (ax + col) as u16;
            nt[off] = space_tile;
            col++;
        }

        // Write string at computed offset
        let mut si: u16 = 0;
        let mut wx: u8 = start_x;
        loop {
            if si >= len as u16 { break; }
            let c: u8 = s[si];
            if c == 0 { break; }

            let off: u16 = row_base + (ax + wx) as u16;
            let tile: u16 = ((c as u16) - 32 + base) | attr;
            nt[off] = tile;

            wx++;
            si++;
        }

        // Advance to next row
        self.cursor_x = 0;
        let mut ny: u8 = cy + 1;
        if ny >= ah {
            ny = 0;
        }
        self.cursor_y = ny;
    }

    // ========================================================================
    // Method Macros - Formatted Output
    // ========================================================================

    // Format + streaming print.
    // Usage: my_console.print!("Score: {u16}", score);
    macro_rules! print($fmt:literal, $($args:expr),*) {
        format!(__console_fmt_buf, $fmt, $($args),*);
        self.print(&__console_fmt_buf as far *u8);
    }

    // Format + aligned print + advance to next row.
    // Usage: my_console.println!("Level: {u8}", level);
    macro_rules! println($fmt:literal, $($args:expr),*) {
        format!(__console_fmt_buf, $fmt, $($args),*);
        self.print_line(&__console_fmt_buf as far *u8);
    }

    // Format + print at position.
    // Usage: my_console.print_at!(5, 3, "HP: {u8}", hp);
    macro_rules! print_at($x:expr, $y:expr, $fmt:literal, $($args:expr),*) {
        format!(__console_fmt_buf, $fmt, $($args),*);
        self.print_at($x, $y, &__console_fmt_buf as far *u8);
    }

    // ========================================================================
    // Clearing
    // ========================================================================

    // Fill entire text area with space tiles, reset cursor to (0,0).
    far fn clear(far *self) {
        let nt: far *u16 = self.nametable;
        let space_tile: u16 = self.tile_base | self.tile_attr;
        let aw: u8 = self.area_w;
        let ah: u8 = self.area_h;
        let ax: u8 = self.area_x;
        let ay: u8 = self.area_y;

        let mut row: u8 = 0;
        loop {
            if row >= ah { break; }
            let row_base: u16 = ((ay + row) as u16) << 5;
            let mut col: u8 = 0;
            loop {
                if col >= aw { break; }
                let off: u16 = row_base + (ax + col) as u16;
                nt[off] = space_tile;
                col++;
            }
            row++;
        }

        self.cursor_x = 0;
        self.cursor_y = 0;
    }

    // Fill one row within the text area with space tiles.
    far fn clear_row(far *self, row: u8) {
        let nt: far *u16 = self.nametable;
        let space_tile: u16 = self.tile_base | self.tile_attr;
        let aw: u8 = self.area_w;
        let ax: u8 = self.area_x;
        let ay: u8 = self.area_y;

        let row_base: u16 = ((ay + row) as u16) << 5;
        let mut col: u8 = 0;
        loop {
            if col >= aw { break; }
            let off: u16 = row_base + (ax + col) as u16;
            nt[off] = space_tile;
            col++;
        }
    }

    // ========================================================================
    // Font Upload
    // ========================================================================

    // Upload 1bpp font data to VRAM, converting to 2bpp.
    // Each source byte is written to both VMDATAL and VMDATAH so that
    // set pixels appear as color 3 (both bitplanes set).
    // vram_addr: VRAM word address for character data.
    // num_tiles: number of 8x8 tiles (each tile = 8 source bytes).
    far fn upload_font_1bpp(far *self, vram_addr: u16, data: far *u8, num_tiles: u16) {
        set_vram_addr!(vram_addr);
        let d: far *u8 = data;
        let total: u16 = num_tiles << 3;  // num_tiles * 8 bytes per tile
        let mut i: u16 = 0;
        loop {
            if i >= total { break; }
            A = d[i];
            VMDATAL = A;  // Bitplane 0
            VMDATAH = A;  // Bitplane 1
            i++;
        }
    }

    // Upload the built-in CONSOLE_FONT (95 tiles) to VRAM.
    far fn upload_default_font(far *self, vram_addr: u16) {
        self.upload_font_1bpp(vram_addr, &CONSOLE_FONT as far *u8, 95);
    }
}

// ============================================================================
// Format Buffer (global, used by method macros)
// ============================================================================

#[ram]
static mut __console_fmt_buf: [u8; 128];

// ============================================================================
// Default Font Data - CP437/IBM BIOS Style 8x8 Monospace
// ============================================================================
// 95 tiles covering ASCII 32 (space) through 126 (~)
// Each tile is 8 bytes (1bpp: 8 rows of 8 pixels)
// Total: 95 * 8 = 760 bytes

static CONSOLE_FONT: [u8; 760] = [
    // Tile  0: ' ' (space, 0x20)
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    // Tile  1: '!' (0x21)
    0x18, 0x18, 0x18, 0x18, 0x18, 0x00, 0x18, 0x00,
    // Tile  2: '"' (0x22)
    0x6C, 0x6C, 0x6C, 0x00, 0x00, 0x00, 0x00, 0x00,
    // Tile  3: '#' (0x23)
    0x6C, 0x6C, 0xFE, 0x6C, 0xFE, 0x6C, 0x6C, 0x00,
    // Tile  4: '$' (0x24)
    0x18, 0x3E, 0x60, 0x3C, 0x06, 0x7C, 0x18, 0x00,
    // Tile  5: '%' (0x25)
    0x62, 0x66, 0x0C, 0x18, 0x30, 0x66, 0x46, 0x00,
    // Tile  6: '&' (0x26)
    0x3C, 0x66, 0x3C, 0x38, 0x67, 0x66, 0x3F, 0x00,
    // Tile  7: ''' (0x27)
    0x18, 0x18, 0x30, 0x00, 0x00, 0x00, 0x00, 0x00,
    // Tile  8: '(' (0x28)
    0x0C, 0x18, 0x30, 0x30, 0x30, 0x18, 0x0C, 0x00,
    // Tile  9: ')' (0x29)
    0x30, 0x18, 0x0C, 0x0C, 0x0C, 0x18, 0x30, 0x00,
    // Tile 10: '*' (0x2A)
    0x00, 0x66, 0x3C, 0xFF, 0x3C, 0x66, 0x00, 0x00,
    // Tile 11: '+' (0x2B)
    0x00, 0x18, 0x18, 0x7E, 0x18, 0x18, 0x00, 0x00,
    // Tile 12: ',' (0x2C)
    0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x30,
    // Tile 13: '-' (0x2D)
    0x00, 0x00, 0x00, 0x7E, 0x00, 0x00, 0x00, 0x00,
    // Tile 14: '.' (0x2E)
    0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x00,
    // Tile 15: '/' (0x2F)
    0x02, 0x06, 0x0C, 0x18, 0x30, 0x60, 0x40, 0x00,
    // Tile 16: '0' (0x30)
    0x3C, 0x66, 0x6E, 0x76, 0x66, 0x66, 0x3C, 0x00,
    // Tile 17: '1' (0x31)
    0x18, 0x38, 0x18, 0x18, 0x18, 0x18, 0x7E, 0x00,
    // Tile 18: '2' (0x32)
    0x3C, 0x66, 0x06, 0x0C, 0x18, 0x30, 0x7E, 0x00,
    // Tile 19: '3' (0x33)
    0x3C, 0x66, 0x06, 0x1C, 0x06, 0x66, 0x3C, 0x00,
    // Tile 20: '4' (0x34)
    0x0C, 0x1C, 0x3C, 0x6C, 0x7E, 0x0C, 0x0C, 0x00,
    // Tile 21: '5' (0x35)
    0x7E, 0x60, 0x7C, 0x06, 0x06, 0x66, 0x3C, 0x00,
    // Tile 22: '6' (0x36)
    0x1C, 0x30, 0x60, 0x7C, 0x66, 0x66, 0x3C, 0x00,
    // Tile 23: '7' (0x37)
    0x7E, 0x06, 0x0C, 0x18, 0x30, 0x30, 0x30, 0x00,
    // Tile 24: '8' (0x38)
    0x3C, 0x66, 0x66, 0x3C, 0x66, 0x66, 0x3C, 0x00,
    // Tile 25: '9' (0x39)
    0x3C, 0x66, 0x66, 0x3E, 0x06, 0x0C, 0x38, 0x00,
    // Tile 26: ':' (0x3A)
    0x00, 0x18, 0x18, 0x00, 0x18, 0x18, 0x00, 0x00,
    // Tile 27: ';' (0x3B)
    0x00, 0x18, 0x18, 0x00, 0x18, 0x18, 0x30, 0x00,
    // Tile 28: '<' (0x3C)
    0x0C, 0x18, 0x30, 0x60, 0x30, 0x18, 0x0C, 0x00,
    // Tile 29: '=' (0x3D)
    0x00, 0x00, 0x7E, 0x00, 0x7E, 0x00, 0x00, 0x00,
    // Tile 30: '>' (0x3E)
    0x30, 0x18, 0x0C, 0x06, 0x0C, 0x18, 0x30, 0x00,
    // Tile 31: '?' (0x3F)
    0x3C, 0x66, 0x06, 0x0C, 0x18, 0x00, 0x18, 0x00,
    // Tile 32: '@' (0x40)
    0x3C, 0x66, 0x6E, 0x6A, 0x6E, 0x60, 0x3E, 0x00,
    // Tile 33: 'A' (0x41)
    0x18, 0x3C, 0x66, 0x66, 0x7E, 0x66, 0x66, 0x00,
    // Tile 34: 'B' (0x42)
    0x7C, 0x66, 0x66, 0x7C, 0x66, 0x66, 0x7C, 0x00,
    // Tile 35: 'C' (0x43)
    0x3C, 0x66, 0x60, 0x60, 0x60, 0x66, 0x3C, 0x00,
    // Tile 36: 'D' (0x44)
    0x78, 0x6C, 0x66, 0x66, 0x66, 0x6C, 0x78, 0x00,
    // Tile 37: 'E' (0x45)
    0x7E, 0x60, 0x60, 0x7C, 0x60, 0x60, 0x7E, 0x00,
    // Tile 38: 'F' (0x46)
    0x7E, 0x60, 0x60, 0x7C, 0x60, 0x60, 0x60, 0x00,
    // Tile 39: 'G' (0x47)
    0x3C, 0x66, 0x60, 0x6E, 0x66, 0x66, 0x3E, 0x00,
    // Tile 40: 'H' (0x48)
    0x66, 0x66, 0x66, 0x7E, 0x66, 0x66, 0x66, 0x00,
    // Tile 41: 'I' (0x49)
    0x3C, 0x18, 0x18, 0x18, 0x18, 0x18, 0x3C, 0x00,
    // Tile 42: 'J' (0x4A)
    0x1E, 0x0C, 0x0C, 0x0C, 0x0C, 0x6C, 0x38, 0x00,
    // Tile 43: 'K' (0x4B)
    0x66, 0x6C, 0x78, 0x70, 0x78, 0x6C, 0x66, 0x00,
    // Tile 44: 'L' (0x4C)
    0x60, 0x60, 0x60, 0x60, 0x60, 0x60, 0x7E, 0x00,
    // Tile 45: 'M' (0x4D)
    0x63, 0x77, 0x7F, 0x6B, 0x63, 0x63, 0x63, 0x00,
    // Tile 46: 'N' (0x4E)
    0x66, 0x76, 0x7E, 0x7E, 0x6E, 0x66, 0x66, 0x00,
    // Tile 47: 'O' (0x4F)
    0x3C, 0x66, 0x66, 0x66, 0x66, 0x66, 0x3C, 0x00,
    // Tile 48: 'P' (0x50)
    0x7C, 0x66, 0x66, 0x7C, 0x60, 0x60, 0x60, 0x00,
    // Tile 49: 'Q' (0x51)
    0x3C, 0x66, 0x66, 0x66, 0x6A, 0x6C, 0x36, 0x00,
    // Tile 50: 'R' (0x52)
    0x7C, 0x66, 0x66, 0x7C, 0x6C, 0x66, 0x66, 0x00,
    // Tile 51: 'S' (0x53)
    0x3C, 0x66, 0x60, 0x3C, 0x06, 0x66, 0x3C, 0x00,
    // Tile 52: 'T' (0x54)
    0x7E, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x00,
    // Tile 53: 'U' (0x55)
    0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x3C, 0x00,
    // Tile 54: 'V' (0x56)
    0x66, 0x66, 0x66, 0x66, 0x66, 0x3C, 0x18, 0x00,
    // Tile 55: 'W' (0x57)
    0x63, 0x63, 0x63, 0x6B, 0x7F, 0x77, 0x63, 0x00,
    // Tile 56: 'X' (0x58)
    0x66, 0x66, 0x3C, 0x18, 0x3C, 0x66, 0x66, 0x00,
    // Tile 57: 'Y' (0x59)
    0x66, 0x66, 0x66, 0x3C, 0x18, 0x18, 0x18, 0x00,
    // Tile 58: 'Z' (0x5A)
    0x7E, 0x06, 0x0C, 0x18, 0x30, 0x60, 0x7E, 0x00,
    // Tile 59: '[' (0x5B)
    0x3C, 0x30, 0x30, 0x30, 0x30, 0x30, 0x3C, 0x00,
    // Tile 60: '\' (0x5C)
    0x40, 0x60, 0x30, 0x18, 0x0C, 0x06, 0x02, 0x00,
    // Tile 61: ']' (0x5D)
    0x3C, 0x0C, 0x0C, 0x0C, 0x0C, 0x0C, 0x3C, 0x00,
    // Tile 62: '^' (0x5E)
    0x18, 0x3C, 0x66, 0x00, 0x00, 0x00, 0x00, 0x00,
    // Tile 63: '_' (0x5F)
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x7E, 0x00,
    // Tile 64: '`' (0x60)
    0x18, 0x18, 0x0C, 0x00, 0x00, 0x00, 0x00, 0x00,
    // Tile 65: 'a' (0x61)
    0x00, 0x00, 0x3C, 0x06, 0x3E, 0x66, 0x3E, 0x00,
    // Tile 66: 'b' (0x62)
    0x60, 0x60, 0x7C, 0x66, 0x66, 0x66, 0x7C, 0x00,
    // Tile 67: 'c' (0x63)
    0x00, 0x00, 0x3C, 0x60, 0x60, 0x60, 0x3C, 0x00,
    // Tile 68: 'd' (0x64)
    0x06, 0x06, 0x3E, 0x66, 0x66, 0x66, 0x3E, 0x00,
    // Tile 69: 'e' (0x65)
    0x00, 0x00, 0x3C, 0x66, 0x7E, 0x60, 0x3C, 0x00,
    // Tile 70: 'f' (0x66)
    0x1C, 0x30, 0x30, 0x7C, 0x30, 0x30, 0x30, 0x00,
    // Tile 71: 'g' (0x67)
