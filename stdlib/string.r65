// R65 Standard Library - String Functions
//
// Provides memory operations, string manipulation, character classification,
// and number formatting for null-terminated ASCII strings.
//
// All string functions work with far *u8 pointers and assume null-terminated
// strings unless otherwise noted. No bounds checking is performed.
//
// Usage:
//   include!("stdlib/string.r65")

// ============================================================================
// Memory Primitives
// ============================================================================

// Length of null-terminated string.
// Returns number of bytes before first null byte.
far fn strlen(s: far *u8) -> u16 {
    let mut len: u16 = 0;
    loop {
        if s[len] == 0 {
            return len;
        }
        len++;
    }
}

// Copy n bytes from src to dst.
// Does not handle overlapping regions.
far fn memcpy(dst: far *u8, src: far *u8, n: u16) {
    if n == 0 { return; }
    let mut i: u16 = 0;
    loop {
        dst[i] = src[i];
        i++;
        if i >= n { break; }
    }
}

// Fill n bytes of dst with value.
far fn memset(dst: far *u8, value: u8, n: u16) {
    if n == 0 { return; }
    let mut i: u16 = 0;
    loop {
        dst[i] = value;
        i++;
        if i >= n { break; }
    }
}

// Compare n bytes of a and b.
// Returns 0 if equal, -1 if a < b, 1 if a > b.
far fn memcmp(a: far *u8, b: far *u8, n: u16) -> i8 {
    if n == 0 { return 0; }
    let mut i: u16 = 0;
    loop {
        let ca: u8 = a[i];
        let cb: u8 = b[i];
        if ca < cb { return -1; }
        if ca > cb { return 1; }
        i++;
        if i >= n { break; }
    }
    return 0;
}

// ============================================================================
// String Operations (null-terminated)
// ============================================================================

// Copy src to dst including null terminator.
// Returns number of bytes copied (excluding null).
far fn strcpy(dst: far *u8, src: far *u8) -> u16 {
    let mut i: u16 = 0;
    loop {
        let ch: u8 = src[i];
        dst[i] = ch;
        if ch == 0 { break; }
        i++;
    }
    return i;
}

// Copy at most max-1 bytes from src to dst.
// Always null-terminates dst. Returns bytes written (excluding null).
far fn strncpy(dst: far *u8, src: far *u8, max: u16) -> u16 {
    if max == 0 {
        return 0;
    }
    let mut i: u16 = 0;
    let end: u16 = max - 1;
    loop {
        if i >= end { break; }
        let ch: u8 = src[i];
        if ch == 0 { break; }
        dst[i] = ch;
        i++;
    }
    dst[i] = 0;
    return i;
}

// Append src after dst's null terminator.
// Returns new total length of dst (excluding null).
far fn strcat(dst: far *u8, src: far *u8) -> u16 {
    // Two single-index loops: one loop walking both strings needs a second
    // index register, and the compiler keeps that one on the stack.
    let len: u16 = strlen(dst);
    return len + strcpy(dst + len, src);
}

// Lexicographic comparison of two null-terminated strings.
// Returns 0 if equal, -1 if a < b, 1 if a > b.
far fn strcmp(a: far *u8, b: far *u8) -> i8 {
    let mut i: u16 = 0;
    loop {
        let ca: u8 = a[i];
        let cb: u8 = b[i];
        if ca < cb { return -1; }
        if ca > cb { return 1; }
        if ca == 0 { return 0; }
        i++;
    }
}

// Find first occurrence of ch in null-terminated string s.
// Returns index, or 0xFFFF if not found. ch = 0 finds the terminator.
far fn strchr(s: far *u8, ch: u8) -> u16 {
    let mut i: u16 = 0;
    loop {
        let c: u8 = s[i];
        if c == ch {
            return i;
        }
        if c == 0 {
            return 0xFFFF;
        }
        i++;
    }
}

// ============================================================================
// Character Classification and Conversion
// ============================================================================

// The classifiers are one wrapping subtract and one compare: anything below
// the range wraps to a large u8, so `ch - LO < N` is the range check. The
// short body is also small enough for the compiler to inline.

// Returns true if ch is '0'-'9' (0x30-0x39)
far fn is_digit(ch @ A: u8) -> bool {
    return ch - 0x30 < 10;
}

// Returns true if ch is 'A'-'Z' (0x41-0x5A)
far fn is_upper(ch @ A: u8) -> bool {
    return ch - 0x41 < 26;
}

// Returns true if ch is 'a'-'z' (0x61-0x7A)
far fn is_lower(ch @ A: u8) -> bool {
    return ch - 0x61 < 26;
}

// Returns true if ch is a letter (A-Z or a-z)
far fn is_alpha(ch @ A: u8) -> bool {
    // Setting bit 5 folds 'A'-'Z' onto 'a'-'z'; nothing else lands there.
    return (ch | 0x20) - 0x61 < 26;
}

// Convert lowercase letter to uppercase. Non-letters unchanged.
far fn to_upper(ch @ A: u8) -> u8 {
    if ch >= 0x61 {
        if ch <= 0x7A {
            ch = ch - 32;
        }
    }
    return ch;
}

// Convert uppercase letter to lowercase. Non-letters unchanged.
far fn to_lower(ch @ A: u8) -> u8 {
    if ch >= 0x41 {
        if ch <= 0x5A {
            ch = ch + 32;
        }
    }
    return ch;
}

// ============================================================================
// Number Formatting
//
// All functions write into a caller-provided buffer, null-terminate,
// and return the number of characters written (excluding null).
//
// Decimal digits come from binary-weighted subtraction: each digit is built
// from compare-subtract steps of 8, 4, 2 and 1 times its power of ten, so the
// time per digit is constant (no loop) and the SNES divider is never touched -
// these are safe to call while an interrupt handler uses $4204-$4216.
// ============================================================================

// Write decimal representation of u8 value to buf.
// Null-terminates. Returns number of characters written (1-3).
far fn u8_to_dec(buf: far *u8, value @ A: u8) -> u8 {
    let mut v: u8 = value;
    let mut pos: u16 = 0;
    let mut d: u8 = 0;

    // A place runs once a digit has been written or its power fits; until
    // then it would be a leading zero, so small values skip it entirely.

    // 100s place (1-2)
    if v >= 100 {
        d = 1;
        v -= 100;
        if v >= 100 { v -= 100; d = 2; }
        buf[pos] = d + 0x30;
        pos++;
    }

    // 10s place
    if pos != 0 || v >= 10 {
        d = 0;
        if v >= 80 { v -= 80; d = 8; }
        if v >= 40 { v -= 40; d += 4; }
        if v >= 20 { v -= 20; d += 2; }
        if v >= 10 { v -= 10; d += 1; }
        buf[pos] = d + 0x30;
        pos++;
    }

    // 1s place (always written, so 0 prints as "0")
    buf[pos] = v + 0x30;
    pos++;

    buf[pos] = 0;
    return pos as u8;
}

// Write decimal representation of u16 value to buf.
// Null-terminates. Returns number of characters written (1-5).
far fn u16_to_dec(buf: far *u8, value @ A: u16) -> u8 {
    let mut v: u16 = value;
    let mut pos: u16 = 0;
    let mut d: u16 = 0;

    // A place runs once a digit has been written or its power fits; until
    // then it would be a leading zero, so small values skip it entirely.

    // 10000s place (1-6)
    if v >= 10000 {
        if v >= 40000 { v -= 40000; d = 4; }
        if v >= 20000 { v -= 20000; d += 2; }
        if v >= 10000 { v -= 10000; d += 1; }
        buf[pos] = (d as u8) + 0x30;
        pos++;
    }

    // 1000s place
    if pos != 0 || v >= 1000 {
        d = 0;
        if v >= 8000 { v -= 8000; d = 8; }
        if v >= 4000 { v -= 4000; d += 4; }
        if v >= 2000 { v -= 2000; d += 2; }
        if v >= 1000 { v -= 1000; d += 1; }
        buf[pos] = (d as u8) + 0x30;
        pos++;
    }

    // 100s place
    if pos != 0 || v >= 100 {
        d = 0;
        if v >= 800 { v -= 800; d = 8; }
        if v >= 400 { v -= 400; d += 4; }
        if v >= 200 { v -= 200; d += 2; }
        if v >= 100 { v -= 100; d += 1; }
        buf[pos] = (d as u8) + 0x30;
        pos++;
    }

    // v < 100 now: the last two digits are u8 work
    let mut w: u8 = v as u8;
    if pos != 0 || w >= 10 {
        let mut e: u8 = 0;
        if w >= 80 { w -= 80; e = 8; }
        if w >= 40 { w -= 40; e += 4; }
        if w >= 20 { w -= 20; e += 2; }
        if w >= 10 { w -= 10; e += 1; }
        buf[pos] = e + 0x30;
        pos++;
    }

    // 1s place (always written, so 0 prints as "0")
    buf[pos] = w + 0x30;
    pos++;

    buf[pos] = 0;
    return pos as u8;
}

// Write right-aligned, padded decimal u8 to buf.
// fill = 0x20 for space padding, 0x30 for zero padding.
// Always writes exactly 'width' characters plus null terminator.
// Returns width (or count if number exceeds width).
far fn u8_to_dec_pad(buf: far *u8, value @ A: u8, width: u8, fill: u8) -> u8 {
    let mut count: u8 = 1;
    if value >= 100 { count = 3; } else if value >= 10 { count = 2; }

    // At or over width: no padding, the digits are the whole field
    if count >= width {
        return u8_to_dec(buf, value);
    }

    // Fill the left, then format into the rest (u8_to_dec writes the NUL)
    let shift: u16 = (width - count) as u16;
    let mut i: u16 = 0;
    while i < shift { buf[i] = fill; i++; }
    u8_to_dec(buf + shift, value);
    return width;
}

// Write right-aligned, padded decimal u16 to buf.
// fill = 0x20 for space padding, 0x30 for zero padding.
// Always writes exactly 'width' characters plus null terminator.
// Returns width (or count if number exceeds width).
far fn u16_to_dec_pad(buf: far *u8, value @ A: u16, width: u8, fill: u8) -> u8 {
    let mut count: u8 = 1;
    if value >= 10000 { count = 5; }
    else if value >= 1000 { count = 4; }
    else if value >= 100 { count = 3; }
    else if value >= 10 { count = 2; }

    // At or over width: no padding, the digits are the whole field
    if count >= width {
        return u16_to_dec(buf, value);
    }

    // Fill the left, then format into the rest (u16_to_dec writes the NUL)
    let shift: u16 = (width - count) as u16;
    let mut i: u16 = 0;
    while i < shift { buf[i] = fill; i++; }
    u16_to_dec(buf + shift, value);
    return width;
}

static HEX_DIGITS: [u8; 16] = "0123456789ABCDEF";

// Write 2-char hex representation of u8 value to buf.
// Always writes exactly 2 characters plus null. Example: 0xAB -> "AB"
far fn u8_to_hex(buf: far *u8, value @ A: u8) {
    buf[0] = HEX_DIGITS[(value >> 4) as u16];
    buf[1] = HEX_DIGITS[(value & 0x0F) as u16];
    buf[2] = 0;
}

// Write 4-char hex representation of u16 value to buf.
// Always writes exactly 4 characters plus null. Example: 0x1234 -> "1234"
far fn u16_to_hex(buf: far *u8, value @ A: u16) {
    // Nibbles extracted in 16 bits are already valid indices; u8 nibbles
    // would each need a zero-extend before indexing.
    buf[0] = HEX_DIGITS[value >> 12];
    buf[1] = HEX_DIGITS[(value >> 8) & 0x0F];
    buf[2] = HEX_DIGITS[(value >> 4) & 0x0F];
    buf[3] = HEX_DIGITS[value & 0x0F];
    buf[4] = 0;
}

// ============================================================================
// Formatted Output
//
// format!(buf, "fmt string {u8} {u16:x}", arg1, arg2)
//
// Writes formatted text into a caller-provided buffer with indexed stores
// and the formatting functions above. Null-terminates the result.
//
// Specifiers:
//   {u8}      - decimal u8         (u8_to_dec, 1-3 chars)
//   {u16}     - decimal u16        (u16_to_dec, 1-5 chars)
//   {i8}      - signed decimal i8  (inline sign + u8_to_dec, 1-4 chars)
//   {i16}     - signed decimal i16 (inline sign + u16_to_dec, 1-6 chars)
//   {bool}    - boolean as "1"/"0" (inline, 1 char)
//   {u8:x}    - hex u8, 2 chars    (u8_to_hex)
//   {u16:x}   - hex u16, 4 chars   (u16_to_hex)
//   {u8:Nd}   - space-padded u8    (u8_to_dec_pad, N = width 1-10)
//   {u16:Nd}  - space-padded u16   (u16_to_dec_pad, N = width 1-10)
//   {u8:0Nd}  - zero-padded u8     (u8_to_dec_pad, N = width 1-10)
//   {u16:0Nd} - zero-padded u16    (u16_to_dec_pad, N = width 1-10)
//   {s}       - string copy        (strcpy)
//   {c}       - single byte
//   {{  }}    - literal braces
//
// N is a minimum, as in Rust: a value wider than N is written whole. A field
// at least as wide as the type's largest value (3 for u8, 5 for u16) keeps
// the write offset known at compile time; a narrower one advances by the
// length actually written.
// ============================================================================

macro_rules! format($target_buffer:ident, $format_string:literal, $($args:expr),*) {
    __format!($target_buffer, $format_string, $($args),*);
}

// ============================================================================
// ToString Trait
//
// Built-in trait — always available without include.
// See r65/compiler/main.py _inject_builtin_traits().
//
//   trait ToString {
//       fn to_string(far *self, buf: far *u8) -> u16;
//   }
//
// Types implementing ToString write their string representation into a
// caller-provided buffer and return the number of characters written.
//
// **No terminator is written.** The returned count is what delimits the string.
// `format!` appends a single NUL once the whole result is assembled, so a
// per-fragment terminator would be a redundant store one byte past the count
// just returned — and would need a buffer byte the caller never asked for. A
// direct caller wanting a C string writes the NUL itself at the returned offset.
// ============================================================================
