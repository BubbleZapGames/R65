//! 32-bit floating point (`F32`) for the 65816.
//!
//! `F32` uses the Woz/Rankin format (Dr. Dobb's Journal, 1976): a 1-byte
//! excess-128 exponent plus a 24-bit two's-complement mantissa, packed into
//! 4 bytes. Precision is ~6–7 significant decimal digits over a range of roughly
//! 10^-38 to 10^38; zero is represented by an exponent byte of `0`.
//!
//! Arithmetic is exposed through the operators (`+=`, `-=`, `*=`, `/=`) and the
//! comparison operators — there are no named `add`/`sub` methods. Values come
//! from `from_i16`, the predefined constants (`F32_ONE`, `F32_PI`, …), or the
//! `F32_RAW!` macro.
//!
//! ```
//! include!("lib/F32.r65")
//!
//! #[ram] static mut V: F32 = F32_RAW!(0x00, 0x00, 0x0000);   // 0.0
//!
//! fn step() { V.from_i16(3 as i16); V *= F32_TWO; }
//! ```
//!
//! See also `U32` (unsigned) and `I32` (signed integer).

include!("math.r65")

// ============================================================================
// F32 (32-bit Floating Point) Support
// ============================================================================

/// A 32-bit floating-point number in Woz/Rankin format.
///
/// Packed into 4 bytes: a low mantissa word plus a high word holding the
/// mantissa's high byte (sign + 7 bits) and the excess-128 exponent. Build one
/// with `from_i16`, a predefined constant, or the `F32_RAW!` macro.
struct F32 {
    /// Mantissa low 16 bits (byte offset 0).
    mant_lo: u16,
    /// Low byte holds the mantissa high byte (sign in bit 7); high byte holds the
    /// excess-128 exponent (byte offset 2).
    exp_hi: u16
}

/// Builds an `F32` from its raw encoded components.
///
/// The low-level constructor — `F32` has no decimal-literal macro. Every
/// predefined constant is defined with it, and it can initialize a `static`.
///
/// # Parameters
/// - `exp` — excess-128 exponent byte
/// - `mant_hi` — mantissa high byte (sign in bit 7, normalized bit in bit 6)
/// - `mant_lo_word` — mantissa low 16 bits
///
/// # Example
/// ```
/// #[ram] static mut HALF: F32 = F32_RAW!(0x80, 0x40, 0x0000);   // 0.5
/// ```
macro_rules! F32_RAW($exp:expr, $mant_hi:expr, $mant_lo_word:expr) {
    F32 {
        mant_lo: ($mant_lo_word) as u16,
        exp_hi: ((($exp) as u16) << 8) | ((($mant_hi) as u16) & 0xFF)
    }
}

// ============================================================================
// Pre-computed Constants
// ============================================================================
// Encoding: value = (mantissa_24bit_signed / 2^23) * 2^(exp - 128)
// For positive normalized: mantissa high byte = 0x40..0x7F (bit 6 set, bit 7 clear)
// Derived with: fraction = value / 2^(exp-128), mantissa = round(fraction * 2^23)

/// The constant `0.0`.
const F32_ZERO:    F32 = F32_RAW!(0x00, 0x00, 0x0000);
/// The constant `1.0`.
const F32_ONE:     F32 = F32_RAW!(0x81, 0x40, 0x0000);
/// The constant `-1.0`.
const F32_NEG_ONE: F32 = F32_RAW!(0x81, 0xC0, 0x0000);
/// The constant `0.5`.
const F32_HALF:    F32 = F32_RAW!(0x80, 0x40, 0x0000);
/// The constant `2.0`.
const F32_TWO:     F32 = F32_RAW!(0x82, 0x40, 0x0000);
/// The constant `10.0`.
const F32_TEN:     F32 = F32_RAW!(0x84, 0x50, 0x0000);
/// The constant `100.0`.
const F32_HUNDRED: F32 = F32_RAW!(0x87, 0x64, 0x0000);
/// Pi, approximately `3.14159`.
const F32_PI:      F32 = F32_RAW!(0x82, 0x64, 0x87ED);
/// Euler's number, approximately `2.71828`.
const F32_E:       F32 = F32_RAW!(0x82, 0x56, 0xFC2A);

// ============================================================================
// Internal Macros
// ============================================================================

// Shift 24-bit mantissa left by 1. hi uses only low 8 bits (upper byte is don't-care).
// Bit 15 of lo carries into bit 0 of hi.
macro_rules! _f32_shl24($lo:expr, $hi:expr) {
    if ($lo & 0x8000) != 0 {
        $lo = $lo + $lo;
        $hi = $hi + $hi;
        $hi = $hi | 1;
    } else {
        $lo = $lo + $lo;
        $hi = $hi + $hi;
    }
}

// Shift 24-bit mantissa right by 1 (logical - zero fill).
// Bit 0 of hi carries into bit 15 of lo.
macro_rules! _f32_shr24($lo:expr, $hi:expr) {
    if ($hi & 1) != 0 {
        $hi = $hi >> 1;
        $lo = $lo >> 1;
        $lo = $lo | 0x8000;
    } else {
        $hi = $hi >> 1;
        $lo = $lo >> 1;
    }
}

// Arithmetic shift right 24-bit mantissa by 1 (preserves sign in bit 7 of hi).
macro_rules! _f32_asr24($lo:expr, $hi:expr) {
    if ($hi & 1) != 0 {
        $hi = ($hi >> 1) | ($hi & 0x80);
        $lo = ($lo >> 1) | 0x8000;
    } else {
        $hi = ($hi >> 1) | ($hi & 0x80);
        $lo = $lo >> 1;
    }
}

// Negate 24-bit mantissa (two's complement: ~val + 1).
// hi uses only low 8 bits.
macro_rules! _f32_negate24($lo:expr, $hi:expr) {
    $lo = $lo ^ 0xFFFF;
    $hi = ($hi ^ 0xFF) & 0xFF;
    $lo = $lo + 1;
    if $lo == 0 {
        $hi = $hi + 1;
    }
}

// Normalize a 24-bit two's complement mantissa.
// After normalization: bits 7 and 6 of hi differ (01=positive, 10=negative).
// Adjusts exp accordingly. Sets exp=0 if mantissa is zero.
macro_rules! _f32_normalize($lo:expr, $hi:expr, $exp:expr) {
    if ($hi & 0xFF) == 0 {
        if $lo == 0 {
            $exp = 0;
        }
    }
    if $exp != 0 {
        loop {
            if ($hi & 0xC0) == 0x40 {
                break;
            }
            if ($hi & 0xC0) == 0x80 {
                break;
            }
            _f32_shl24!($lo, $hi);
            $exp = $exp - 1;
            if $exp == 0 {
                break;
            }
        }
    }
}

// ============================================================================
// F32 Implementation
// ============================================================================

impl F32 {
    // ========================================================================
    // Copy and Query Methods
    // ========================================================================

    /// Copies `src` into `self`.
    #[inline(always)]
    far fn copy(far *self, src: far *F32) {
        self.mant_lo = src.mant_lo;
        self.exp_hi = src.exp_hi;
    }

    /// Returns `true` if `self` is zero (its exponent byte is `0`).
    #[inline(always)]
    far fn is_zero(far *self) -> bool {
        if (self.exp_hi & 0xFF00) == 0 {
            return true;
        }
        return false;
    }

    /// Returns `true` if `self` is negative (the mantissa sign bit is set).
    #[inline(always)]
    far fn is_negative(far *self) -> bool {
        if (self.exp_hi & 0x0080) != 0 {
            return true;
        }
        return false;
    }

    // ========================================================================
    // Sign Operations
    // ========================================================================

    /// Negates `self` in place, flipping the mantissa sign and preserving the
    /// exponent.
    #[inline(always)]
    far fn neg(far *self) {
        let eh: u16 = self.exp_hi;
        if (eh & 0xFF00) == 0 {
            return;
        }
        let mut ml: u16 = self.mant_lo;
        let mut mhi: u16 = eh & 0xFF;
        let exp_byte: u16 = eh & 0xFF00;
        _f32_negate24!(ml, mhi);
        self.mant_lo = ml;
        self.exp_hi = exp_byte | (mhi & 0xFF);
    }

    /// Replaces `self` with its absolute value (negates if negative).
    #[inline(always)]
    far fn abs(far *self) {
        if (self.exp_hi & 0x0080) != 0 {
            self.neg();
        }
    }

    // ========================================================================
    // Conversion Methods
    // ========================================================================

    /// Sets `self` to the floating-point value of a signed 16-bit integer.
    ///
    /// # Parameters
    /// - `value` — the signed 16-bit integer to convert
    far fn from_i16(far *self, value: u16) {
        if value == 0 {
            self.mant_lo = 0;
            self.exp_hi = 0;
            return;
        }

        let mut negative: bool = false;
        let mut val: u16 = value;
        if (val & 0x8000) != 0 {
            negative = true;
            val = val ^ 0xFFFF;
            val = val + 1;
        }

        // Place absolute value in 24-bit mantissa: hi=0, lo=val
        // Starting exponent: 128 + 23 = 151 (if mantissa were at bit 22)
        let mut mant_hi: u16 = 0;
        let mut mant_lo: u16 = val;
        let mut exp: u16 = 151;

        // Normalize: shift left until bit 6 of mant_hi is set, bit 7 clear.
        // Use == 0x40 (generates CMP+BEQ) not != 0 (generates buggy BVC).
        loop {
            if (mant_hi & 0xC0) == 0x40 {
                break;
            }
            _f32_shl24!(mant_lo, mant_hi);
            exp = exp - 1;
        }

        // Apply two's complement if negative
        if negative {
            _f32_negate24!(mant_lo, mant_hi);
        }

        self.mant_lo = mant_lo;
        self.exp_hi = (exp << 8) | (mant_hi & 0xFF);
    }

    /// Converts `self` to a signed 16-bit integer, truncating toward zero.
    ///
    /// # Returns
    /// The integer value. A magnitude `< 1.0` returns `0`; results outside the
    /// `i16` range are clamped to `-32768`/`32767`.
    far fn to_i16(far *self) -> i16 {
        let eh: u16 = self.exp_hi;
        let mut exp: u16 = eh >> 8;

        // Zero or exponent too small (value < 0.5)
        if exp == 0 {
            A = 0;
            return A;
        }

        // Value magnitude < 1.0
        if exp < 129 {
            A = 0;
            return A;
        }

        // Exponent too large: any mantissa at exp >= 151 produces value >= 2^22
        if exp > 150 {
            if (eh & 0x80) != 0 {
                A = 0x8000;
                return A;
            }
            A = 0x7FFF;
            return A;
        }

        // Extract mantissa and determine sign
        let mut mant_hi: u16 = eh & 0xFF;
        let mut mant_lo: u16 = self.mant_lo;
        let mut negative: bool = (mant_hi & 0x80) != 0;

        // Work with magnitude
        if negative {
            _f32_negate24!(mant_lo, mant_hi);
        }

        // Shift right by (151 - exp) to convert fraction to integer
        let mut shifts: u16 = 151 - exp;
        loop {
            if shifts == 0 {
                break;
            }
            _f32_shr24!(mant_lo, mant_hi);
            shifts = shifts - 1;
        }

        // After shifting, result should be in mant_lo (mant_hi should be 0)
        let mut result: u16 = mant_lo;

        // Clamp to i16 range
        if !negative {
            if result > 0x7FFF {
                result = 0x7FFF;
            }
        } else {
            if result > 0x8000 {
                result = 0x8000;
            }
            // Apply sign (two's complement)
            result = result ^ 0xFFFF;
            result = result + 1;
        }

        return result as i16;
    }

    // ========================================================================
    // Arithmetic Methods (all modify self in-place)
    // ========================================================================

    // Internal addition core. Adds a mantissa/exponent pair to self.
    // Both add() and sub() delegate to this.
    // o_lo: other mantissa low 16 bits
    // o_hi: other mantissa high byte (in low 8 bits of u16)
    // o_exp: other exponent (biased)
    far fn add_raw(far *self, o_lo: u16, o_hi: u16, o_exp: u16) {
        let s_eh: u16 = self.exp_hi;
        let s_exp: u16 = s_eh >> 8;

        // If self is zero, just store the other value
        if s_exp == 0 {
            self.mant_lo = o_lo;
            self.exp_hi = (o_exp << 8) | (o_hi & 0xFF);
            return;
        }

        let mut s_mhi: u16 = s_eh & 0xFF;
        let mut s_mlo: u16 = self.mant_lo;
        let mut o_mhi: u16 = o_hi;
        let mut o_mlo: u16 = o_lo;
        let mut exp: u16 = s_exp;

        // Align exponents by arithmetic-shifting the smaller mantissa right.
        if s_exp > o_exp {
            let mut diff: u16 = s_exp - o_exp;
            if diff > 23 {
                // Other is too small to matter
                return;
            }
            loop {
                if diff == 0 { break; }
                _f32_asr24!(o_mlo, o_mhi);
                diff = diff - 1;
            }
            exp = s_exp;
        } else if o_exp > s_exp {
            let mut diff: u16 = o_exp - s_exp;
            if diff > 23 {
                // Self is too small, result is other
                self.mant_lo = o_lo;
                self.exp_hi = (o_exp << 8) | (o_hi & 0xFF);
                return;
            }
            loop {
                if diff == 0 { break; }
                _f32_asr24!(s_mlo, s_mhi);
                diff = diff - 1;
            }
            exp = o_exp;
        }

        // Add 24-bit mantissas (two's complement).
        let r_lo: u16 = s_mlo + o_mlo;
        let mut carry: u16 = 0;
        if r_lo < s_mlo {
            carry = 1;
        }
        let mut r_hi: u16 = ((s_mhi & 0xFF) + (o_mhi & 0xFF) + carry) & 0xFF;
        let mut norm_lo: u16 = r_lo;
        let mut norm_hi: u16 = r_hi;

        // Check for zero result
        if norm_hi == 0 {
            if norm_lo == 0 {
                self.mant_lo = 0;
                self.exp_hi = 0;
                return;
            }
        }

        // Same-sign overflow: adding two equal-sign mantissas carried into the
        // sign bit (e.g. x + x). Shift right one, reinsert the operands' common
        // sign, and bump the exponent to renormalize.
        let s_sign: u16 = s_mhi & 0x80;
        if s_sign == (o_mhi & 0x80) {
            if (norm_hi & 0x80) != s_sign {
                _f32_shr24!(norm_lo, norm_hi);
                if s_sign != 0 {
                    norm_hi = norm_hi | 0x80;
                } else {
                    norm_hi = norm_hi & 0x7F;
                }
                exp = exp + 1;
            }
        }

        _f32_normalize!(norm_lo, norm_hi, exp);
        self.mant_lo = norm_lo;
        self.exp_hi = (exp << 8) | (norm_hi & 0xFF);
    }
}

/// Powers the `+=` operator — adds another `F32` into `self`.
impl AddAssign for F32 {
    // self += other
    far fn add_assign(far *self, other: far *F32) {
        let o_eh: u16 = other.exp_hi;
        let o_exp: u16 = o_eh >> 8;
        if o_exp == 0 { return; }
        self.add_raw(other.mant_lo, o_eh & 0xFF, o_exp);
    }
}

/// Powers the `-=` operator — subtracts another `F32` from `self`.
impl SubAssign for F32 {
    // self -= other
    far fn sub_assign(far *self, other: far *F32) {
        let o_eh: u16 = other.exp_hi;
        let o_exp: u16 = o_eh >> 8;
        if o_exp == 0 { return; }
        // Negate other's mantissa locally, then add
        let mut neg_lo: u16 = other.mant_lo;
        let mut neg_hi: u16 = o_eh & 0xFF;
        _f32_negate24!(neg_lo, neg_hi);
        self.add_raw(neg_lo, neg_hi, o_exp);
    }
}

/// Powers the `*=` operator — multiplies `self` by another `F32`.
impl MulAssign for F32 {
    // self *= other (SNES hardware multiply, 9 partial products)
    far fn mul_assign(far *self, other: far *F32) {
        let s_eh: u16 = self.exp_hi;
        let o_eh: u16 = other.exp_hi;
        let s_exp: u16 = s_eh >> 8;
        let o_exp: u16 = o_eh >> 8;

        if s_exp == 0 { return; }
        if o_exp == 0 {
            self.mant_lo = 0;
            self.exp_hi = 0;
            return;
        }

        let mut r_exp: u16 = s_exp + o_exp;
        if r_exp < 129 {
            self.mant_lo = 0;
            self.exp_hi = 0;
            return;
        }
        r_exp = r_exp - 128;
        if r_exp > 255 {
            self.mant_lo = 0xFFFF;
            self.exp_hi = 0xFF7F;
            return;
        }

        let result_neg: bool = ((s_eh ^ o_eh) & 0x80) != 0;

        let mut s_hi: u16 = s_eh & 0xFF;
        let mut s_lo: u16 = self.mant_lo;
        if (s_hi & 0x80) != 0 {
            _f32_negate24!(s_lo, s_hi);
        }

        let mut o_hi: u16 = o_eh & 0xFF;
        let mut o_lo: u16 = other.mant_lo;
        if (o_hi & 0x80) != 0 {
            _f32_negate24!(o_lo, o_hi);
        }

        let s_l: u8 = s_lo as u8;
        let s_m: u8 = (s_lo >> 8) as u8;
        let s_h: u8 = s_hi as u8;
        let o_l: u8 = o_lo as u8;
        let o_m: u8 = (o_lo >> 8) as u8;
        let o_h: u8 = o_hi as u8;

        WRMPYA = s_l;
        WRMPYB = o_l; NOP(4);
        let p_ll_hi: u16 = RDMPYH as u16;

        WRMPYB = o_m; NOP(4);
        let p_lm: u16 = (RDMPYH as u16) << 8 | (RDMPYL as u16);

        WRMPYB = o_h; NOP(4);
        let p_lh: u16 = (RDMPYH as u16) << 8 | (RDMPYL as u16);

        WRMPYA = s_m;
        WRMPYB = o_l; NOP(4);
        let p_ml: u16 = (RDMPYH as u16) << 8 | (RDMPYL as u16);

        WRMPYB = o_m; NOP(4);
        let p_mm: u16 = (RDMPYH as u16) << 8 | (RDMPYL as u16);

        WRMPYB = o_h; NOP(4);
        let p_mh: u16 = (RDMPYH as u16) << 8 | (RDMPYL as u16);

        WRMPYA = s_h;
        WRMPYB = o_l; NOP(4);
        let p_hl: u16 = (RDMPYH as u16) << 8 | (RDMPYL as u16);

        WRMPYB = o_m; NOP(4);
        let p_hm: u16 = (RDMPYH as u16) << 8 | (RDMPYL as u16);

        WRMPYB = o_h; NOP(4);
        let p_hh: u16 = (RDMPYH as u16) << 8 | (RDMPYL as u16);

        // Accumulate top 32 bits of the 48-bit product into res_hi:res_mid
        let mut carry_count: u16 = 0;
        let mut old: u16 = 0;

        let mid1: u16 = p_lm + p_ml;
        let mut mid1_carry: u16 = 0;
        if mid1 < p_lm { mid1_carry = 1; }

        let mut res_mid: u16 = p_lh;

        old = res_mid;
        res_mid = res_mid + p_mm;
        if res_mid < old { carry_count = carry_count + 1; }

        old = res_mid;
        res_mid = res_mid + p_hl;
        if res_mid < old { carry_count = carry_count + 1; }

        old = res_mid;
        res_mid = res_mid + (mid1 >> 8);
        if res_mid < old { carry_count = carry_count + 1; }

        old = res_mid;
        res_mid = res_mid + p_ll_hi;
        if res_mid < old { carry_count = carry_count + 1; }

        let mid2: u16 = p_mh + p_hm;
        let mut mid2_carry: u16 = 0;
        if mid2 < p_mh { mid2_carry = 1; }

        old = res_mid;
        res_mid = res_mid + (mid2 << 8);
        if res_mid < old { carry_count = carry_count + 1; }

        let res_hi: u16 = p_hh + (mid2 >> 8) + carry_count + mid1_carry + mid2_carry;

        let mut r_mhi: u16 = (res_hi >> 7) & 0x7F;
        let mut r_mlo: u16 = (res_mid >> 7) | ((res_hi & 0x7F) << 9);

        _f32_normalize!(r_mlo, r_mhi, r_exp);

        if result_neg {
            _f32_negate24!(r_mlo, r_mhi);
        }

        self.mant_lo = r_mlo;
        self.exp_hi = (r_exp << 8) | (r_mhi & 0xFF);
    }
}

/// Powers the `/=` operator. Divide-by-zero or overflow yields the maximum magnitude.
impl DivAssign for F32 {
    // self /= other
    // Uses 23-iteration binary long division for full 23-bit quotient precision.
    // Result exponent: r_exp = s_exp - o_exp + 128 (+ 1 if pre-norm halves dvnd).
    // Returns max magnitude on divide-by-zero or overflow.
    far fn div_assign(far *self, other: far *F32) {
        let s_eh: u16 = self.exp_hi;
        let o_eh: u16 = other.exp_hi;
        let s_exp: u16 = s_eh >> 8;
        let o_exp: u16 = o_eh >> 8;

        // Division by zero
        if o_exp == 0 {
            self.mant_lo = 0xFFFF;
            self.exp_hi = 0xFF7F;
            return;
        }

        // Zero / anything = zero
        if s_exp == 0 { return; }

        // Result sign
        let result_neg: bool = ((s_eh ^ o_eh) & 0x80) != 0;

        // Get absolute mantissas
        let mut dvnd_hi: u16 = s_eh & 0xFF;
        let mut dvnd_lo: u16 = self.mant_lo;
        if (dvnd_hi & 0x80) != 0 {
            _f32_negate24!(dvnd_lo, dvnd_hi);
        }

        let mut dvsr_hi: u16 = o_eh & 0xFF;
        let mut dvsr_lo: u16 = other.mant_lo;
        if (dvsr_hi & 0x80) != 0 {
            _f32_negate24!(dvsr_lo, dvsr_hi);
        }

        // Compute result exponent: s_exp - o_exp + 128.
        // The 23-iteration algorithm produces Q = (dvnd_norm / dvsr) * 2^23,
        // which is already normalized (bit 22 set). The +128 accounts for the
        // 2^23 factor (23 bits) minus the F32 bias correction (151-128=23). Wait
        // actually: result_value = dvnd_norm/dvsr * 2^(s_exp-o_exp); we store
        // as mant_Q * 2^(r_exp-151); mant_Q = Q/2^23 * dvsr/dvnd... see formula.
        let mut r_exp: u16 = s_exp + 128;
        if r_exp < o_exp {
            // Underflow: result too small to represent
            self.mant_lo = 0;
            self.exp_hi = 0;
            return;
        }
        r_exp = r_exp - o_exp;

        // Pre-normalize: ensure dvnd < dvsr so the quotient is in [0.5, 1).
        // If dvnd >= dvsr, halve dvnd and increment r_exp to compensate.
        // This guarantees bit 22 of Q is always 1 (normalized result, no _f32_normalize! needed).
        let dvnd_hi8: u16 = dvnd_hi & 0xFF;
        let dvsr_hi8: u16 = dvsr_hi & 0xFF;
        if dvnd_hi8 > dvsr_hi8 {
            _f32_shr24!(dvnd_lo, dvnd_hi);
            r_exp = r_exp + 1;
        } else if dvnd_hi8 == dvsr_hi8 {
            if dvnd_lo >= dvsr_lo {
                _f32_shr24!(dvnd_lo, dvnd_hi);
                r_exp = r_exp + 1;
            }
        }

        if r_exp > 255 {
            self.mant_lo = 0xFFFF;
            self.exp_hi = 0xFF7F;
            return;
        }
        if r_exp == 0 {
            self.mant_lo = 0;
            self.exp_hi = 0;
            return;
        }

        // 23-iteration binary long division.
        // Each iteration: shift dvnd left, if dvnd >= dvsr subtract and set Q bit.
        // After 23 iterations Q is normalized: bit 22 set, 23-bit precision.
        // dvnd_hi & 0xFF is safe (invariant: dvnd < dvsr <= 0x7FFFFF before each shl,
        // so dvnd_hi <= 0x7F; after shl dvnd_hi <= 0xFF, fits in masked byte).
        let mut q_hi: u16 = 0;
        let mut q_lo: u16 = 0;
        let mut count: u8 = 23;

        loop {
            _f32_shl24!(dvnd_lo, dvnd_hi);
            _f32_shl24!(q_lo, q_hi);

            let dh8: u16 = dvnd_hi & 0xFF;
            if dh8 > dvsr_hi8 {
                let mut borrow: bool = false;
                if dvnd_lo < dvsr_lo { borrow = true; }
                dvnd_lo = dvnd_lo - dvsr_lo;
                dvnd_hi = dvnd_hi - dvsr_hi;
                if borrow { dvnd_hi = dvnd_hi - 1; }
                q_lo = q_lo | 1;
            } else if dh8 == dvsr_hi8 {
                if dvnd_lo >= dvsr_lo {
                    dvnd_lo = dvnd_lo - dvsr_lo;
                    dvnd_hi = dvnd_hi - dvsr_hi;
                    q_lo = q_lo | 1;
                }
            }

            count--;
            if count == 0 { break; }
        }

        // Round up (ceiling) if any remainder remains.
        // This prevents to_string from producing "41.9999" instead of "42.0"
        // for integer values whose quotient is non-terminating in binary.
        if (dvnd_hi & 0xFF) != 0 || dvnd_lo != 0 {
            q_lo = q_lo + 1;
            if q_lo == 0 {
                q_hi = q_hi + 1;
            }
        }

        // Apply sign (no normalize needed: Q is already in normalized form)
        if result_neg {
            _f32_negate24!(q_lo, q_hi);
        }

        self.mant_lo = q_lo;
        self.exp_hi = (r_exp << 8) | (q_hi & 0xFF);
    }
}

// ========================================================================
// Comparison
// ========================================================================

/// Powers the ordering operators (`<`, `<=`, `>`, `>=`) through a three-way `cmp`.
impl PartialOrd for F32 {
    /// Compares `self` with `other`, returning `1` if `self > other`, `0` if
    /// equal, or `-1` if `self < other`.
    far fn cmp(far *self, other: far *F32) -> i8 {
        let s_eh: u16 = self.exp_hi;
        let o_eh: u16 = other.exp_hi;
        let s_exp: u16 = s_eh >> 8;
        let o_exp: u16 = o_eh >> 8;

        // Handle zeros
        if s_exp == 0 {
            if o_exp == 0 {
                A = 0;
                return A;
            }
            if (o_eh & 0x80) != 0 {
                A = 1;
                return A;
            }
            A = 0xFF;
            return A;
        }
        if o_exp == 0 {
            if (s_eh & 0x80) != 0 {
                A = 0xFF;
                return A;
            }
            A = 1;
            return A;
        }

        // Check sign difference
        let s_neg: bool = (s_eh & 0x80) != 0;
        let o_neg: bool = (o_eh & 0x80) != 0;
        if s_neg {
            if !o_neg {
                A = 0xFF;
                return A;
            }
        }
        if !s_neg {
            if o_neg {
                A = 1;
                return A;
            }
        }

        // Same sign: compare exponents
        if !s_neg {
            if s_exp > o_exp { A = 1; return A; }
            if s_exp < o_exp { A = 0xFF; return A; }
        } else {
            if s_exp > o_exp { A = 0xFF; return A; }
            if s_exp < o_exp { A = 1; return A; }
        }

        // Same sign, same exponent: compare mantissa bytes
        let s_hi: u16 = s_eh & 0xFF;
        let o_hi: u16 = o_eh & 0xFF;
        if s_hi > o_hi { A = 1; return A; }
        if s_hi < o_hi { A = 0xFF; return A; }

        if self.mant_lo > other.mant_lo { A = 1; return A; }
        if self.mant_lo < other.mant_lo { A = 0xFF; return A; }

        A = 0;
        return A;
    }
}

// ============================================================================
// F32 Operator Overloading: equality
// ============================================================================
// Arithmetic (`+=` `-=` `*=` `/=`) lives in the AddAssign/SubAssign/MulAssign/
// DivAssign impls above; ordering (`<` `<=` `>` `>=`) in PartialOrd::cmp. The
// methods *are* the implementation (no forwarders). PartialEq derives `==`/`!=`
// from cmp.

/// Powers the equality operators (`==`, `!=`) by comparing the encoded values.
impl PartialEq for F32 { far fn eq(far *self, other: far *F32) -> bool { return self.cmp(other) == 0; } }

/// Enables `Clone` for `F32` — `let c = a.clone()` and `dst.clone_from(&src)` copy
/// all four bytes. The empty body selects the compiler's automatic bitwise copy.
impl Clone for F32 {}

// ============================================================================
// F32 ToString
// ============================================================================

/// Formats `self` as a decimal ASCII string (used by `format!`'s `{}`).
impl ToString for F32 {
    /// Writes the NUL-terminated decimal representation of `self` into `buf` and
    /// returns the character count.
    ///
    /// # Parameters
    /// - `buf` — destination buffer for the formatted digits
    fn to_string(far *self, buf: far *u8) -> u16 {
        let mut __f32_tostr_work: F32;
        let mut __f32_tostr_ten: F32;
        let mut __f32_tostr_int: F32;
        let mut __f32_tostr_digits: [u8; 6];
        // Zero
        if (self.exp_hi & 0xFF00) == 0 {
            buf[0 as u16] = '0' as u8;
            buf[1 as u16] = '.' as u8;
            buf[2 as u16] = '0' as u8;
            buf[3 as u16] = 0;
            return 3;
        }

        // Copy to work, make absolute
        let negative: bool = (self.exp_hi & 0x0080) != 0;
        __f32_tostr_work.mant_lo = self.mant_lo;
        __f32_tostr_work.exp_hi = self.exp_hi;
        if negative {
            __f32_tostr_work.neg();
        }

        // Init 10.0 constant
        __f32_tostr_ten.mant_lo = 0;
        __f32_tostr_ten.exp_hi = 0x8450;

        // Normalize work to [1.0, 10.0), track decimal exponent n
        let mut n: i8 = 0;
        loop {
            let cmp_result: i8 = __f32_tostr_work.cmp(&__f32_tostr_ten);
            if cmp_result < 0 { break; }
            __f32_tostr_work /= __f32_tostr_ten;
            n++;
        }
        loop {
            if (__f32_tostr_work.exp_hi & 0xFF00) == 0 { break; }  // zero guard
            if (__f32_tostr_work.exp_hi >> 8) >= 0x81 { break; }
            __f32_tostr_work *= __f32_tostr_ten;
            n--;
        }

        // Extract 6 significant digits (values 0-9)
        let mut k: u8 = 0;
        loop {
            if k == 6 { break; }
            let digit_val: i16 = __f32_tostr_work.to_i16();
            let digit: u8 = digit_val as u8;
            __f32_tostr_digits[k as u16] = digit;
            __f32_tostr_int.from_i16(digit as u16);
            __f32_tostr_work -= __f32_tostr_int;
            __f32_tostr_work *= __f32_tostr_ten;
            k++;
        }

        // Strip trailing zeros, keep at least 1
        let mut sig_end: u8 = 6;
        loop {
            if sig_end == 1 { break; }
            if __f32_tostr_digits[(sig_end - 1) as u16] != 0 { break; }
            sig_end--;
        }

        // Write formatted output
        let mut pos: u8 = 0;
        if negative {
            buf[pos as u16] = '-' as u8;
            pos++;
        }

        if n < 0 {
            // "0." + (-n-1) leading zeros + sig digits
            buf[pos as u16] = '0' as u8; pos++;
            buf[pos as u16] = '.' as u8; pos++;
            let mut lz: i8 = 0 - n - 1;
            loop {
                if lz <= 0 { break; }
                buf[pos as u16] = '0' as u8; pos++;
                lz--;
            }
            let mut k2: u8 = 0;
            loop {
                if k2 == sig_end { break; }
                buf[pos as u16] = __f32_tostr_digits[k2 as u16] + 0x30;
                pos++;
                k2++;
            }
        } else if n <= 5 {
            // (n+1) integer digits + "." + fractional digits
            let int_digits: u8 = (n as u8) + 1;
            let mut k3: u8 = 0;
            loop {
                if k3 == int_digits { break; }
                buf[pos as u16] = __f32_tostr_digits[k3 as u16] + 0x30;
                pos++;
                k3++;
            }
            buf[pos as u16] = '.' as u8; pos++;
            if int_digits >= sig_end {
                buf[pos as u16] = '0' as u8; pos++;
            } else {
                let mut k4: u8 = int_digits;
                loop {
                    if k4 == sig_end { break; }
                    buf[pos as u16] = __f32_tostr_digits[k4 as u16] + 0x30;
                    pos++;
                    k4++;
                }
            }
        } else {
            // n >= 6: 6 sig digits + (n-5) trailing zeros + ".0"
            let mut k5: u8 = 0;
            loop {
                if k5 == 6 { break; }
                buf[pos as u16] = __f32_tostr_digits[k5 as u16] + 0x30;
                pos++;
                k5++;
            }
            let mut tz: u8 = (n as u8) - 5;
            loop {
                if tz == 0 { break; }
                buf[pos as u16] = '0' as u8; pos++;
                tz--;
            }
            buf[pos as u16] = '.' as u8; pos++;
            buf[pos as u16] = '0' as u8; pos++;
        }

        buf[pos as u16] = 0;
        return pos as u16;
    }
}
