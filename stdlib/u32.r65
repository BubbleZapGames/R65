// R65 Standard Library - U32 (32-bit Unsigned Integer) Support
//
// Provides 32-bit unsigned integer arithmetic, comparisons, and conversions.
//
// Usage:
//   include!("lib/u32.r65")

include!("math.r65")

// ============================================================================
// U32 (32-bit Unsigned Integer) Support
// ============================================================================

// 32-bit unsigned integer (little-endian)
// Size: 4 bytes, packed
struct U32 {
    lo: u16,    // Offset 0-1: Low 16 bits
    hi: u16     // Offset 2-3: High 16 bits
}

// ============================================================================
// Internal 16x16 -> 32 bit multiplication
// ============================================================================

// 16x16 -> 32 bit multiplication using SNES hardware
// Uses four 8x8 multiplies: (a_hi*256 + a_lo) * (b_hi*256 + b_lo)
// Result stored in result_lo (low 16 bits) and result_hi (high 16 bits)
#[cfg(snes)]
#[mode(m8, transition=caller)]
far fn _mul16x16(a @ A: u16, b @ X: u16, *result_lo: u16, *result_hi: u16) {
    // Local temporaries for multiplication
    let mut a_lo: u8;
    let mut a_hi: u8;
    let mut b_lo: u8;
    let mut b_hi: u8;
    let mut p0: u16;
    let mut p1: u16;
    let mut p2: u16;
    let mut p3: u16;

    // Extract bytes from a (already in A)
    a_lo = A;
    STATUS.A16 = false;
    xba();
    a_hi = A;

    // Extract bytes from b (in X)
    A = X;
    b_lo = A;
    A = X >> 8;
    b_hi = A;

    // Product 0: a_lo * b_lo (contributes to bits 0-15)
    WRMPYA = a_lo;
    WRMPYB = b_lo;
    NOP(4);
    STATUS.A16 = true;
    A = RDMPYL;
    p0 = A;

    // Product 1: a_lo * b_hi (contributes to bits 8-23)
    STATUS.A16 = false;
    WRMPYA = a_lo;
    WRMPYB = b_hi;
    NOP(4);
    STATUS.A16 = true;
    A = RDMPYL;
    p1 = A;

    // Product 2: a_hi * b_lo (contributes to bits 8-23)
    STATUS.A16 = false;
    WRMPYA = a_hi;
    WRMPYB = b_lo;
    NOP(4);
    STATUS.A16 = true;
    A = RDMPYL;
    p2 = A;

    // Product 3: a_hi * b_hi (contributes to bits 16-31)
    STATUS.A16 = false;
    WRMPYA = a_hi;
    WRMPYB = b_hi;
    NOP(4);
    STATUS.A16 = true;
    A = RDMPYL;
    p3 = A;

    // Combine products:
    // result = p0 + (p1 << 8) + (p2 << 8) + (p3 << 16)

    // Start with p0 as base
    A = p0;
    (*result_lo) = A;
    A = 0;
    (*result_hi) = A;

    // Add p1 << 8 (p1_lo goes to result_lo high byte, p1_hi goes to result_hi low byte)
    A = p1;
    A = A << 8;
    STATUS.Carry = false;
    A = A + (*result_lo);
    (*result_lo) = A;
    A = p1;
    A = A >> 8;
    A = A + (*result_hi);
    (*result_hi) = A;

    // Add p2 << 8 (same pattern)
    A = p2;
    A = A << 8;
    STATUS.Carry = false;
    A = A + (*result_lo);
    (*result_lo) = A;
    A = p2;
    A = A >> 8;
    A = A + (*result_hi);
    (*result_hi) = A;

    // Add p3 << 16 (goes entirely to result_hi)
    STATUS.Carry = false;
    A = (*result_hi);
    A = A + p3;
    (*result_hi) = A;
}

// Software 16x16 -> 32 bit multiplication (shift-and-add)
#[cfg(not(snes))]
#[mode(m16, transition=caller)]
far fn _mul16x16(a @ A: u16, b @ X: u16, *result_lo: u16, *result_hi: u16) {
    let mut multiplicand_lo: u16 = A;
    let mut multiplicand_hi: u16 = 0;
    let mut multiplier: u16 = X;

    // Clear result
    A = 0;
    (*result_lo) = A;
    (*result_hi) = A;

    loop {
        if multiplier == 0 {
            break;
        }

        // Test lowest bit of multiplier
        A = multiplier;
        A = A & 1;
        if A != 0 {
            // Add multiplicand to result (32-bit add)
            STATUS.Carry = false;
            A = (*result_lo);
            A = A + multiplicand_lo;
            (*result_lo) = A;
            A = (*result_hi);
            A = A + multiplicand_hi;
            (*result_hi) = A;
        }

        // Shift multiplicand left (32-bit shift)
        A = multiplicand_lo;
        asm!("ASL A");
        multiplicand_lo = A;
        A = multiplicand_hi;
        asm!("ROL A");
        multiplicand_hi = A;

        // Shift multiplier right
        A = multiplier;
        A = A >> 1;
        multiplier = A;
    }
}

// ============================================================================
// U32 Implementation
// ============================================================================

impl far U32 {
    // ========================================================================
    // Conversion Methods
    // ========================================================================

    // Initialize from u16 (zero-extend)
    #[mode(m16, transition=caller)]
    fn from_u16(far *self, value @ A: u16) {
        self.lo = A;
        A = 0;
        self.hi = A;
    }

    // Convert to u16 (truncate, keeps low 16 bits)
    #[mode(m16, transition=caller)]
    fn to_u16(far *self) -> u16 {
        A = self.lo;
        return A;
    }

    // ========================================================================
    // Arithmetic Methods
    // ========================================================================

    // Add: result = self + other (with overflow wrapping)
    #[mode(m16, transition=caller)]
    fn add(far *self, far *other: U32, far *result: U32) {
        // Add low words with carry clear
        STATUS.Carry = false;
        A = self.lo;
        A = A + other.lo;
        result.lo = A;

        // Add high words with carry from low addition
        A = self.hi;
        A = A + other.hi;
        result.hi = A;
    }

    // Subtract: result = self - other (with underflow wrapping)
    #[mode(m16, transition=caller)]
    fn sub(far *self, far *other: U32, far *result: U32) {
        // Subtract low words with borrow clear (SEC for SBC)
        STATUS.Carry = true;
        A = self.lo;
        A = A - other.lo;
        result.lo = A;

        // Subtract high words with borrow from low subtraction
        A = self.hi;
        A = A - other.hi;
        result.hi = A;
    }

    // Multiply: result = self * other (32x32 -> 32, lower 32 bits only)
    #[mode(m16, transition=caller)]
    fn mul(far *self, far *other: U32, far *result: U32) {
        let mut temp_lo: u16;
        let mut temp_hi: u16;

        // 32-bit multiply uses partial products:
        // result.lo = low16(self.lo * other.lo)
        // result.hi = high16(self.lo * other.lo) + low16(self.lo * other.hi) + low16(self.hi * other.lo)
        // (self.hi * other.hi contributes to bits 32-63, which we discard)

        // Compute self.lo * other.lo -> 32-bit result
        A = self.lo;
        X = other.lo;
        _mul16x16(A, X, &result.lo, &temp_hi);

        // result.lo is already set, temp_hi has the high 16 bits
        // Now add contributions to high word

        // Compute self.lo * other.hi (only need low 16 bits)
        A = self.lo;
        X = other.hi;
        _mul16x16(A, X, &temp_lo, &temp_lo);  // Discard high result

        // Add to result.hi
        STATUS.Carry = false;
        A = temp_hi;
        A = A + temp_lo;
        temp_hi = A;

        // Compute self.hi * other.lo (only need low 16 bits)
        A = self.hi;
        X = other.lo;
        _mul16x16(A, X, &temp_lo, &temp_lo);  // Discard high result

        // Add to result.hi (ignore overflow - wraps)
        STATUS.Carry = false;
        A = temp_hi;
        A = A + temp_lo;
        result.hi = A;
    }

    // Divide: result = self / other (returns 0xFFFFFFFF if other == 0)
    #[mode(m16, transition=caller)]
    fn div(far *self, far *other: U32, far *result: U32) {
        let mut remainder_lo: u16;
        let mut remainder_hi: u16;
        let mut quotient_lo: u16;
        let mut quotient_hi: u16;
        let mut dividend_lo: u16;
        let mut dividend_hi: u16;
        let mut bit_count: u8;

        // Handle division by zero
        A = other.lo;
        if A == 0 {
            A = other.hi;
            if A == 0 {
                A = 0xFFFF;
                result.lo = A;
                result.hi = A;
                return;
            }
        }

        // Initialize remainder to 0
        A = 0;
        remainder_lo = A;
        remainder_hi = A;

        // Initialize quotient to 0
        quotient_lo = A;
        quotient_hi = A;

        // Copy dividend
        A = self.lo;
        dividend_lo = A;
        A = self.hi;
        dividend_hi = A;

        // Process 32 bits
        bit_count = 32;

        loop {
            // Shift remainder left by 1, bringing in MSB of dividend
            A = remainder_lo;
            asm!("ASL A");
            remainder_lo = A;
            A = remainder_hi;
            asm!("ROL A");
            remainder_hi = A;

            // Get MSB of dividend into remainder
            A = dividend_hi;
            if A & 0x8000 != 0 {
                A = remainder_lo;
                A = A | 1;
                remainder_lo = A;
            }

            // Shift dividend left
            A = dividend_lo;
            asm!("ASL A");
            dividend_lo = A;
            A = dividend_hi;
            asm!("ROL A");
            dividend_hi = A;

            // Shift quotient left
            A = quotient_lo;
            asm!("ASL A");
            quotient_lo = A;
            A = quotient_hi;
            asm!("ROL A");
            quotient_hi = A;

            // Compare remainder >= divisor (32-bit compare)
            // First compare high words
            A = remainder_hi;
            if A > other.hi {
                // remainder > divisor, subtract and set quotient bit
                STATUS.Carry = true;
                A = remainder_lo;
                A = A - other.lo;
                remainder_lo = A;
                A = remainder_hi;
                A = A - other.hi;
                remainder_hi = A;
                A = quotient_lo;
                A = A | 1;
                quotient_lo = A;
            } else if A == other.hi {
                // High words equal, check low words
                A = remainder_lo;
                if A >= other.lo {
                    // remainder >= divisor
                    STATUS.Carry = true;
                    A = remainder_lo;
                    A = A - other.lo;
                    remainder_lo = A;
                    A = remainder_hi;
                    A = A - other.hi;
                    remainder_hi = A;
                    A = quotient_lo;
                    A = A | 1;
                    quotient_lo = A;
                }
            }
            // else remainder < divisor, quotient bit stays 0

            bit_count--;
            if bit_count == 0 {
                break;
            }
        }

        // Copy quotient to result
        A = quotient_lo;
        result.lo = A;
        A = quotient_hi;
        result.hi = A;
    }

    // Modulo: result = self % other (returns self if other == 0)
    #[mode(m16, transition=caller)]
    fn mod(far *self, far *other: U32, far *result: U32) {
        let mut remainder_lo: u16;
        let mut remainder_hi: u16;
        let mut dividend_lo: u16;
        let mut dividend_hi: u16;
        let mut bit_count: u8;

        // Handle division by zero - return original value
        A = other.lo;
        if A == 0 {
            A = other.hi;
            if A == 0 {
                A = self.lo;
                result.lo = A;
                A = self.hi;
                result.hi = A;
                return;
            }
        }

        // Initialize remainder to 0
        A = 0;
        remainder_lo = A;
        remainder_hi = A;

        // Copy dividend
        A = self.lo;
        dividend_lo = A;
        A = self.hi;
        dividend_hi = A;

        // Process 32 bits
        bit_count = 32;

        loop {
            // Shift remainder left by 1, bringing in MSB of dividend
            A = remainder_lo;
            asm!("ASL A");
            remainder_lo = A;
            A = remainder_hi;
            asm!("ROL A");
            remainder_hi = A;

            // Get MSB of dividend into remainder
            A = dividend_hi;
            if A & 0x8000 != 0 {
                A = remainder_lo;
                A = A | 1;
                remainder_lo = A;
            }

            // Shift dividend left
            A = dividend_lo;
            asm!("ASL A");
            dividend_lo = A;
            A = dividend_hi;
            asm!("ROL A");
            dividend_hi = A;

            // Compare remainder >= divisor (32-bit compare)
            A = remainder_hi;
            if A > other.hi {
                // remainder > divisor, subtract
                STATUS.Carry = true;
                A = remainder_lo;
                A = A - other.lo;
                remainder_lo = A;
                A = remainder_hi;
                A = A - other.hi;
                remainder_hi = A;
            } else if A == other.hi {
                A = remainder_lo;
                if A >= other.lo {
                    // remainder >= divisor
                    STATUS.Carry = true;
                    A = remainder_lo;
                    A = A - other.lo;
                    remainder_lo = A;
                    A = remainder_hi;
                    A = A - other.hi;
                    remainder_hi = A;
                }
            }

            bit_count--;
            if bit_count == 0 {
                break;
            }
        }

        // Copy remainder to result
        A = remainder_lo;
        result.lo = A;
        A = remainder_hi;
        result.hi = A;
    }

    // ========================================================================
    // Comparison Method
    // ========================================================================

    // Compare self with other, setting STATUS flags like CMP instruction.
    // After calling:
    //   eq: STATUS.Zero == true
    //   ne: STATUS.Zero == false
    //   lt: STATUS.Carry == false
    //   ge: STATUS.Carry == true
    //   gt: STATUS.Carry == true && STATUS.Zero == false
    //   le: STATUS.Carry == false || STATUS.Zero == true
    #[mode(m16, transition=caller)]
    fn cmp(far *self, far *other: U32) -> u8 {
        // Compare high words first
        A = self.hi;
        if A != other.hi {
            // High words differ - compare them to set flags
            A = self.hi;
            asm!("CMP _U32__cmp_other_hi");
            return;
        }

        // High words equal - compare low words to set flags
        A = self.lo;
        asm!("CMP _U32__cmp_other_lo");
        return STATUS;
    }

    // ========================================================================
    // Bitwise Shift Methods
    // ========================================================================

    // Shift left by n bits (in place)
    #[mode(m16, transition=caller)]
    fn shl(far *self, count @ X: u8) {
        loop {
            if X == 0 {
                break;
            }
            A = self.lo;
            asm!("ASL A");
            self.lo = A;
            A = self.hi;
            asm!("ROL A");
            self.hi = A;
            X--;
        }
    }

    // Shift right by n bits (in place)
    #[mode(m16, transition=caller)]
    fn shr(far *self, count @ X: u8) {
        loop {
            if X == 0 {
                break;
            }
            A = self.hi;
            asm!("LSR A");
            self.hi = A;
            A = self.lo;
            asm!("ROR A");
            self.lo = A;
            X--;
        }
    }
}
