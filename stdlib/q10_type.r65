// Q10.6 Fixed-Point Type Library
// 16-bit signed: 10 integer bits (-512 to +511), 6 fractional bits (1/64 precision)
//
// Q10 is a newtype over i16: a distinct type at compile time, an ordinary
// 16-bit value at runtime. The generated code is identical to using a bare i16.
//
// The distinction is one-directional. A Q10 will not pass where an i16 is
// wanted, and will not mix with another newtype — so a scaled value cannot
// silently be consumed as a raw count. An i16 flowing the other way, *into* a
// Q10, is still accepted: `q10_mul(raw, x)` compiles. Wrap deliberately at the
// point a raw number becomes a fixed-point one.
//
// Example usage:
//
//   include!("lib/q10_type.r65")
//
//   #[zeropage]
//   static mut VELOCITY: Q10;
//
//   fn update() {
//       // Create fixed-point values
//       let player_x: Q10 = Q10::from_int(100);  // 100.0
//       VELOCITY = Q10::from(0, 32);            // 0.5 (32/64)
//
//       // Addition and comparison are inherited from i16
//       let next: Q10 = player_x + VELOCITY;
//
//       // Extract integer for screen position
//       let screen_x: i16 = player_x.to_int();  // 100
//
//       // Extract fractional part (0-63)
//       let frac: i16 = player_x.to_frac();     // 0
//
//       // Interpolate a quarter of the way from here to the target
//       player_x = Q10::lerp(player_x, TARGET_X, Q10(16));
//
//       // Keep it on screen
//       player_x = player_x.clamp!(Q10(0), SCREEN_RIGHT);
//
//       // Print it: "100.00", n = 6. No terminator is written.
//       let n: u16 = player_x.to_string(&BUF as far *u8);
//   }
//
// Scaling multiply is `q10_mul`, not `*`: `a * b` on two Q10 values would be a
// raw integer multiply, off by a factor of 64. It stays a named function
// because the operator traits cannot yet be implemented for a newtype.
//
// `to_string` is likewise an inherent method rather than `impl ToString for Q10`,
// for the same reason a newtype cannot implement any trait: dispatch stores a
// TypeId byte at offset 0, which would overlap the value. `format!` resolves
// `to_string` by name, so `format!("{s}", q)` still works — and statically.

struct Q10(i16);

const Q10_ONE: Q10 = 64;
const Q10_HALF: Q10 = 32;
const Q10_1_64TH: Q10 = 1;

// Mask for the fractional bits. Plain i16 — it selects bits, it is not a value
// on the Q10.6 scale.
const Q10_FRAC_MASK: i16 = 0x3F;

impl Q10 {
    // Whole number to Q10.6
    fn from_int(n: i16) -> Q10 {
        return Q10(n << 6);
    }

    // Whole and fractional parts to Q10.6, where `f` is in 1/64 units (0-63).
    // `f` is u8 because a fractional numerator is never negative and never
    // exceeds 63 — the narrower type rejects `Q10::from(1, -5)` outright rather
    // than masking it into 59. Values above 63 still wrap, as the mask implies.
    fn from(n: i16, f: u8) -> Q10 {
        return Q10((n << 6) | ((f as i16) & Q10_FRAC_MASK));
    }

    // Integer part, rounding toward negative infinity (floor).
    //
    // The negative branch is not decoration: `>>` is a logical shift for signed
    // types too (see docs/operators.md), so a bare `self.0 >> 6` shifts the sign
    // bit down and turns -2.0 into 1022. Floor of a negative is
    // -ceil(|x| / 64), hence the +63 before shifting the magnitude.
    fn to_int(self) -> i16 {
        if self.0 < 0 {
            return 0 - (((0 - self.0) + 63) >> 6);
        }
        return self.0 >> 6;
    }

    // Fractional part, in 1/64 units (0-63)
    fn to_frac(self) -> i16 {
        return self.0 & Q10_FRAC_MASK;
    }

    // Nearest whole number, ties rounding up (toward positive infinity).
    // Differs from `to_int`, which floors: 1.5 rounds to 2 but floors to 1,
    // and -1.5 rounds to -1 but floors to -2. Screen positions usually want
    // this one; tile indices usually want `to_int`.
    //
    // Same signed-shift correction as `to_int` — this is floor(x + 0.5).
    //
    // Precondition: values above 511.48 (raw 32735) overflow the +32 bias and
    // come back negative. The top of the Q10 range has no room for it.
    fn round(self) -> i16 {
        let biased: i16 = self.0 + 32;
        if biased < 0 {
            return 0 - (((0 - biased) + 63) >> 6);
        }
        return biased >> 6;
    }

    // Linear interpolation from `a` toward `b`. `t` of Q10_ONE yields `b`
    // exactly, `t` of 0 yields `a`.
    //
    //     result = a + (b - a) * t
    //
    // One multiply, not the two of `a*(1-t) + b*t`: q10_mul drives the hardware
    // unit four times, so halving the multiplies outweighs the wider
    // intermediate range the two-multiply form would tolerate.
    //
    // `t` is not clamped — above Q10_ONE it extrapolates past `b`, below zero
    // past `a`. That is often what you want for easing; clamp at the call site
    // if not.
    //
    // Precondition: `b - a` must fit the Q10 range (|b - a| < 512.0).
    // Endpoints spanning more than the whole range wrap.
    // Requires: include!("lib/sneslib.r65")
    #[cfg(snes)]
    fn lerp(a: Q10, b: Q10, t: Q10) -> Q10 {
        return a + q10_mul(b - a, t);
    }

    // Absolute value
    fn abs(self) -> Q10 {
        if self.0 < 0 {
            return Q10(0 - self.0);
        }
        return self;
    }

    // Decimal text, two places after the point: "100.00", "-12.75", "0.02".
    // Returns the character count. This is what `format!("{s}", q)` calls.
    //
    // Writes exactly that many bytes and **no terminator**: `format!` writes one
    // itself once the whole string is assembled, so a per-fragment NUL would be
    // a redundant store one byte past the returned length. A direct caller that
    // wants a C string terminates it with the returned count.
    //
    // Note this differs from the U32/I32/F32 ToString impls, which do write a
    // NUL.
    //
    // Q10 is a newtype, so this is an inherent method rather than
    // `impl ToString for Q10`: trait dispatch stores a TypeId byte at offset 0,
    // which would overlap the value. `format!` resolves `to_string` by name, so
    // it finds this and calls it statically — no vtable, and `self` arrives in a
    // register.
    //
    // Two places is lossy: the scale is 1/64 = 0.015625, so 0.984375 prints as
    // "0.98". Exact output would need six places and a 32-bit multiply.
    //
    // `buf` needs 7 bytes for the widest result, "-511.98".
    //
    // Precondition: raw -32768 (exactly -512.0) negates to itself in 16 bits and
    // prints as garbage. Same limit as `abs`.
    fn to_string(self, buf: far *u8) -> u16 {
        let mut n: u16 = 0;
        let mut v: i16 = self.0;
        if v < 0 {
            buf[n] = 0x2D;                  // '-'
            n = n + 1;
            v = 0 - v;
        }

        // v is non-negative from here, so `>>` may be used directly — for a
        // signed negative it would shift the sign bit down (see to_int).
        let mut rem: i16 = v >> 6;
        let mut digits: [u8; 5];
        let mut count: u8 = 0;
        // Divide by ten by repeated subtraction rather than calling div8: the
        // integer part is at most 511, so this is a handful of iterations and it
        // keeps this file free of the math.r65 dependency (and its snes cfg).
        loop {
            let mut q: i16 = 0;
            loop {
                if rem < 10 { break; }
                rem = rem - 10;
                q = q + 1;
            }
            digits[count as u16] = (rem as u8) + 0x30;
            count = count + 1;
            rem = q;
            if rem == 0 { break; }
        }
        loop {
            count = count - 1;
            buf[n] = digits[count as u16];
            n = n + 1;
            if count == 0 { break; }
        }

        buf[n] = 0x2E;                      // '.'
        n = n + 1;

        // Hundredths = round(frac * 100 / 64), frac being in 1/64 units (0-63).
        // `*` takes only power-of-two constants, so 100 is built from shifts:
        // 64 + 32 + 4. The result is at most 98, never 100, so it can never
        // carry into the integer part already written above.
        let frac: i16 = v & Q10_FRAC_MASK;
        let scaled: i16 = (frac << 6) + (frac << 5) + (frac << 2);
        let mut r2: i16 = (scaled + 32) >> 6;
        let mut tens: u8 = 0;
        loop {
            if r2 < 10 { break; }
            r2 = r2 - 10;
            tens = tens + 1;
        }
        buf[n] = tens + 0x30;
        n = n + 1;
        buf[n] = (r2 as u8) + 0x30;
        n = n + 1;
        return n;
    }

    // Constrain a value to [$lo, $hi], yielding the result.
    //
    //     VELOCITY = VELOCITY.clamp!(Q10(0 - 256), Q10(256));
    //     let y: Q10 = player_y.clamp!(Q10(0), SCREEN_BOTTOM);
    //
    // A block expression, so it expands inline with no call. The receiver is
    // bound once inside the block rather than read once per comparison — `self`
    // is substituted textually, so naming it three times would evaluate the
    // receiver three times.
    //
    // The binding is `_q10_clamp` rather than something plainer because R65
    // macros are not hygienic: a common name would capture a caller's variable.
    macro_rules! clamp($lo:expr, $hi:expr) {
        {
            let _q10_clamp: Q10 = self;
            if _q10_clamp < $lo {
                $lo
            } else {
                if _q10_clamp > $hi { $hi } else { _q10_clamp }
            }
        }
    }
}

// Multiply two Q10.6 values: result = (a * b) >> 6
// Uses SNES hardware 8x8 multiply unit (4 partial products)
// Requires: include!("lib/sneslib.r65")
#[cfg(snes)]
fn q10_mul(a @ A: Q10, b: Q10) -> Q10 {
    // Unwrap once: each `.0` is free at runtime but materializes its own
    // temporary, and this function is already frame-heavy.
    let av: i16 = a.0;
    let bv: i16 = b.0;

    let mut ua: u16 = av as u16;
    let mut ub: u16 = bv as u16;
    let mut neg: u8 = 0;

    if av < 0 {
        ua = (0 - av) as u16;
        neg = 1;
    }
    if bv < 0 {
        ub = (0 - bv) as u16;
        neg = neg ^ 1;
    }

    let a_lo: u8 = ua as u8;
    let a_hi: u8 = (ua >> 8) as u8;
    let b_lo: u8 = ub as u8;
    let b_hi: u8 = (ub >> 8) as u8;

    // p0 = a_lo * b_lo
    WRMPYA = a_lo;
    WRMPYB = b_lo;
    NOP(4);
    let mut p0: u16 = (RDMPYH as u16) << 8 | (RDMPYL as u16);

    // p1 = a_lo * b_hi (a_lo still in WRMPYA)
    WRMPYB = b_hi;
    NOP(4);
    let mut mid: u16 = (RDMPYH as u16) << 8 | (RDMPYL as u16);

    // p2 = a_hi * b_lo
    WRMPYA = a_hi;
    WRMPYB = b_lo;
    NOP(4);
    mid = mid + ((RDMPYH as u16) << 8 | (RDMPYL as u16));

    // p3 = a_hi * b_hi (a_hi still in WRMPYA)
    WRMPYB = b_hi;
    NOP(4);
    let mut p3: u16 = (RDMPYH as u16) << 8 | (RDMPYL as u16);

    // Accumulate 32-bit product as hi:lo
    let lo: u16 = p0 + (mid << 8);
    let mut hi: u16 = p3 + (mid >> 8);
    if lo < p0 {
        hi = hi + 1;
    }

    // Extract bits [6:21] of 32-bit product
    let mut result: u16 = (lo >> 6) | (hi << 10);

    if neg != 0 {
        return Q10(0 - (result as i16));
    }
    return Q10(result as i16);
}
