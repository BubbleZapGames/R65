// R65 Standard Library - Math Functions
//
// Provides multiplication, division, modulo, and variable shift operations.
//
// Usage:
//   include!("lib/sneslib.r65")  // Required: provides hardware registers
//   include!("lib/math.r65")
//
// Hardware registers used (defined in sneslib.r65):
//   WRMPYA, WRMPYB, RDMPYL, RDMPYH - Multiplication unit
//   WRDIVL, WRDIVH, WRDIVB, RDDIVL, RDDIVH - Division unit

// ============================================================================
// Multiplication Functions
// ============================================================================

// Hardware 8x8 -> 8 unsigned multiply (widening)
#[cfg(snes)]
far fn mul8(multA @ A: u8, multB @ B: u8) -> (u8, u8) {
    // Write multiplicand
    WRMPYA = multA;

    // Write multiplier (starts multiplication)
    WRMPYB = multB;

    // Wait 8 machine cycles for multiplication to complete
    // NOP is 2 cycles, so 4 NOPs = 8 cycles
    NOP(4);

    // Return low byte (caller can read RDMPYH for high byte)
    return RDMPYL, RDMPYH;
}

// Hardware 8x8 -> 16 unsigned multiply
// Uses SNES $4202-$4203 multiplication unit
// Result: 16-bit widening product
#[cfg(snes)]
far fn mul16(multA @ A: u8, multB: u16) -> u16 {
    // Write multiplicand in 8-bit mode
    WRMPYA = multA;

    // Write multiplier (starts multiplication)
    WRMPYB = multB;

    // Wait 8 machine cycles for multiplication to complete
    // REP is 3 cycles, NOP is 2 cycles, so 3 + 2 + 2 + 1 = 8 cycles
    STATUS.A16 = true;  // REP #$20 - switch back to 16-bit
    NOP(2);

    // Return 16-bit result
    return RDMPYL;
}

// Software 8x8 -> 8 unsigned multiply
// Uses shift-and-add algorithm
// Returns: low byte and high byte
// Cycles: ~150-300 depending on operands
#[cfg(not(snes))]
far fn mul8(multA @ A: u8, multB @ B: u8) -> (u8, u8) {
    // Store multiplicand for shifting
    let mut _mul_temp : u8 = multA;

    // Clear 16-bit result
    let mut _mul_result_lo : u8 = 0;
    let mut _mul_result_hi : u8 = 0;

    // Process each bit of multiplier
    loop {
        // If multiplier is zero, we're done
        if multB == 0 {
            break;
        }

        // Test lowest bit of multiplier
        multA = multB;
        multA = multA & 0x01;
        if multA != 0 {
            // Add multiplicand to result (with carry to high byte)
            asm!("CLC");
            multA = _mul_result_lo;
            multA = multA + _mul_temp;
            _mul_result_lo = multA;
            multA = _mul_result_hi;
            asm!("ADC #$00");  // Add carry
            _mul_result_hi = multA;
        }

        // Shift multiplicand left (double it)
        multA = _mul_temp;
        multA = multA << 1;
        _mul_temp = multA;

        // Shift multiplier right (halve it)
        multA = multB;
        multA = multA >> 1;
        multB = multA;
    }

    // Return low byte
    return _mul_result_lo, _mul_result_hi;
}

// Software 8x8 -> 16 unsigned multiply (returns as u16)
// Same algorithm as mul_shift but returns result in 16-bit A register
// Uses mode switch to return 16-bit value
// Cycles: ~150-300 depending on operands
#[cfg(not(snes))]
far fn mul16(multA @ A: u8, multB: u16) -> u16 {
    // Store multiplicand for shifting
    let mut _mul_temp : u8 = multA;

    // Clear 16-bit result
    let mut _mul_result_lo : u8 = 0;
    let mut _mul_result_hi : u8 = 0;

    // Process each bit of multiplier
    loop {
        // If multiplier is zero, we're done
        if multB == 0 {
            break;
        }

        // Test lowest bit of multiplier
        multA = multB;
        multA = multA & 0x01;
        if multA != 0 {
            // Add multiplicand to result (with carry to high byte)
            asm!("CLC");
            multA = _mul_result_lo;
            multA = multA + _mul_temp;
            _mul_result_lo = multA;
            multA = _mul_result_hi;
            asm!("ADC #$00");  // Add carry
            _mul_result_hi = multA;
        }

        // Shift multiplicand left (double it)
        multA = _mul_temp;
        multA = multA << 1;
        _mul_temp = multA;

        // Shift multiplier right (halve it)
        multA = multB;
        multA = multA >> 1;
        multB = multA;
    }

    // Return 16-bit result
    return _mul_result_lo;
}


// Division and modulo functions
// Provides hardware and software implementations

// Hardware 16/8 -> 16 unsigned division
// Uses SNES $4204-$4206 division unit
// Returns: 16-bit quotient
// Cycles: ~30 (16 wait + overhead)
#[cfg(snes)]
far fn div16(dividend @ A: u16, divisor: u8) -> u16 {
    // Write 16-bit dividend
    WRDIVL = dividend;

    // Switch to 8-bit for hardware register writes
    STATUS.A16 = false;  // SEP #$20 - switch to 8-bit
    // Write divisor (starts division)
    WRDIVB = divisor;

    // Wait 16 machine cycles for division to complete
    // REP is 3 cycles, so we need 16 - 3 = 13 more cycles
    // 6 NOPs = 12 cycles, plus the LDA below starts immediately
    STATUS.A16 = true;  // REP #$20 - switch back to 16-bit
    NOP(6);

    return RDDIVL;
}

// Hardware 8/8 -> 8 unsigned division (simplified)
// Extends dividend to 16-bit with zero high byte
// Returns: 8-bit quotient
#[cfg(snes)]
far fn div8(dividend @ A: u8, divisor @ X: u16) -> u8 {
    // Write dividend with zero high byte
    WRDIVL = dividend;
    WRDIVH = 0;

    // Write divisor
    WRDIVB = divisor;

    // Wait 16 cycles
    NOP(8);

    // Read low byte of quotient only
    return RDDIVL;
}

// Hardware 8/8 -> 8 modulo
// Performs division and returns remainder
#[cfg(snes)]
far fn mod8(dividend @ A: u8, divisor @ X: u16) -> u8 {
    // Write dividend with zero high byte
    WRDIVL = dividend;
    WRDIVH = 0;

    // Write divisor
    WRDIVB = divisor;

    // Wait 16 cycles
    NOP(8);

    // Read remainder (low byte)
    return RDMPYL;
}

// Software 8/8 -> 8 unsigned division
// Uses restoring division algorithm
// Returns: quotient
// Cycles: ~200-400
#[cfg(not(snes))]
far fn div8(dividend @ A: u8, divisor @ X: u16) -> u8 {
    // Handle division by zero - return 0xFF (max value)
    if divisor == 0 {
        dividend = 0xFF;
        return dividend;
    }

    let mut _dividend: u8 = dividend;
    let mut _quotient: u8 = 0;
    let mut _remainder: u8 = 0;
    let mut _count: u8 = 8;

    loop {
        // Shift remainder left, bringing in high bit of dividend
        dividend = _remainder;
        dividend = dividend << 1;
        _remainder = dividend;

        // Get high bit of dividend into remainder
        dividend = _dividend;
        dividend = dividend & 0x80;
        if dividend != 0 {
            dividend = _remainder;
            dividend = dividend | 0x01;
            _remainder = dividend;
        }

        // Shift dividend left
        dividend = _dividend;
        dividend = dividend << 1;
        _dividend = dividend;

        // Shift quotient left
        dividend = _quotient;
        dividend = dividend << 1;
        _quotient = dividend;

        // Try to subtract divisor from remainder
        dividend = _remainder;
        if dividend >= divisor {
            dividend = dividend - divisor;
            _remainder = dividend;
            // Set low bit of quotient
            dividend = _quotient;
            dividend = dividend | 0x01;
            _quotient = dividend;
        }

        _count--;
        if _count == 0 {
            break;
        }
    }

    dividend = _quotient;
    return dividend;
}

// Software 8/8 -> 8 modulo
// Uses division algorithm, returns remainder
#[cfg(not(snes))]
far fn mod_shift(dividend @ A: u8, divisor: u8) -> u8 {
    // Handle division by zero - return original dividend
    if divisor == 0 {
        return dividend;
    }

    let mut _dividend: u8 = dividend;
    let mut _remainder: u8 = 0;
    let mut _count: u8 = 8;

    loop {
        // Shift remainder left, bringing in high bit of dividend
        dividend = _remainder;
        dividend = dividend << 1;
        _remainder = dividend;

        // Get high bit of dividend into remainder
        dividend = _dividend;
        dividend = dividend & 0x80;
        if dividend != 0 {
            dividend = _remainder;
            dividend = dividend | 0x01;
            _remainder = dividend;
        }

        // Shift dividend left
        dividend = _dividend;
        dividend = dividend << 1;
        _dividend = dividend;

        // Try to subtract divisor from remainder
        dividend = _remainder;
        if dividend >= divisor {
            dividend = dividend - divisor;
            _remainder = dividend;
        }

        _count--;
        if _count == 0 {
            break;
        }
    }

    dividend = _remainder;
    return dividend;
}

// Variable shift functions
// Loop-based implementation for non-constant shift amounts

// Variable left shift: value << amount
// Cycles: ~10 + 4*amount
far fn shl8(value @ A: u8, amount @ X: u16) -> u8 {
    // Handle zero shift
    if amount == 0 {
        return value;
    }

    // Clamp to 8 (shifting by 8+ always gives 0)
    if amount >= 8 {
        value = 0;
        return value;
    }

    // Loop: shift left amount times
    loop {
        value = value << 1;
        amount--;
        if amount == 0 {
            break;
        }
    }

    return value;
}

// Variable right shift (logical): value >> amount
// Cycles: ~10 + 4*amount
far fn shr8(value @ A: u8, amount @ X: u16) -> u8 {
    // Handle zero shift
    if amount == 0 {
        return value;
    }

    // Clamp to 8
    if amount >= 8 {
        value = 0;
        return value;
    }

    // Loop: shift right amount times
    loop {
        value = value >> 1;
        amount--;
        if amount == 0 {
            break;
        }
    }

    return value;
}

// Variable arithmetic right shift (preserves sign): value >>> amount
// For signed values - shifts in sign bit instead of zero
// Cycles: ~10 + 6*amount
far fn shri8(value @ A: u8, amount @ X: u16) -> u8 {
    if amount == 0 {
        return value;
    }

    // For 8+ shifts, result is 0x00 (positive) or 0xFF (negative)
    if amount >= 8 {
        // Check sign bit
        if value & 0x80 != 0 {
            value = 0xFF;
        } else {
            value = 0;
        }
        return value;
    }

    // Loop: arithmetic shift right amount times
    loop {
        // Check sign bit before shift
        if value & 0x80 != 0 {
            // Negative: shift right, then set sign bit
            value = value >> 1;
            value = value | 0x80;
        } else {
            // Positive: normal logical shift
            value = value >> 1;
        }
        amount--;
        if amount == 0 {
            break;
        }
    }

    return value;
}

// 16-bit variable right shift (logical)
// Cycles: ~15 + 6*amount
far fn shr16(value @ A: u16, amount @ X: u16) -> u16 {
    if amount == 0 {
        return value;
    }

    if amount >= 16 {
        value = 0;
        return value;
    }

    loop {
        value = value >> 1;
        amount--;
        if amount == 0 {
            break;
        }
    }

    return value;
}
// 16-bit variable left shift
// Cycles: ~15 + 6*amount
far fn shl16(value @ A: u16, amount @ X: u16) -> u16 {
    if amount == 0 {
        return value;
    }

    if amount >= 16 {
        value = 0;
        return value;
    }

    loop {
        value = value << 1;
        amount--;
        if amount == 0 {
            break;
        }
    }

    return value;
}

