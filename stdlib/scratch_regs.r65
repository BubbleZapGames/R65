// Scratch registers for FixedStack ABI parameter promotion.
// 6x u8 + 6x u16 = 12 registers, 18 bytes at $30-$41.

#[zeropage(0x30, register)] static mut __FS_S0: u8;
#[zeropage(0x31, register)] static mut __FS_S1: u8;
#[zeropage(0x32, register)] static mut __FS_S2: u8;
#[zeropage(0x33, register)] static mut __FS_S3: u8;
#[zeropage(0x34, register)] static mut __FS_S4: u8;
#[zeropage(0x35, register)] static mut __FS_S5: u8;
#[zeropage(0x36, register)] static mut __FS_S6: u16;
#[zeropage(0x38, register)] static mut __FS_S7: u16;
#[zeropage(0x3A, register)] static mut __FS_S8: u16;
#[zeropage(0x3C, register)] static mut __FS_S9: u16;
#[zeropage(0x3E, register)] static mut __FS_SA: u16;
#[zeropage(0x40, register)] static mut __FS_SB: u16;
