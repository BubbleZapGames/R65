// Multiplication functions
// Provides hardware and software implementations

// Scratch registers for software multiply
#[zeropage(0x00, register)]
static mut _mul_temp: u8;

#[zeropage(0x01, register)]
static mut _mul_result_lo: u8;

#[zeropage(0x02, register)]
static mut _mul_result_hi: u8;

// Hardware 8x8 -> 16 unsigned multiply
// Uses SNES $4202-$4203 multiplication unit
// Result: 16-bit widening product
// Cycles: ~20 (8 wait + overhead)
#[mode(m8, x8)]
fn mul_hw(a @ A: u8, b @ X: u8) -> u16 {
    // Write multiplicand
    WRMPYA = A;

    // Write multiplier (starts multiplication)
    A = X;
    WRMPYB = A;

    // Wait 8 machine cycles for multiplication to complete
    // NOP is 2 cycles, so 4 NOPs = 8 cycles
    NOP(4);

    // Read 16-bit result
    // In m8 mode, read low byte first, then high
    A = RDMPYL;
    _mul_result_lo = A;
    A = RDMPYH;
    _mul_result_hi = A;

    // Return as 16-bit value
    // Caller needs to handle the 16-bit result
    REP(0x20);
    asm!("LDA _mul_result_lo");
    SEP(0x20);
    return A;
}

// Software 8x8 -> 16 unsigned multiply (widening, returns hi/lo separately)
// Uses shift-and-add algorithm
// Returns: A = low byte, X = high byte
// Cycles: ~150-300 depending on operands
#[mode(m8, x8)]
fn mul_shift(a @ A: u8, b @ X: u8) -> u8 {
    // Store multiplicand for shifting
    _mul_temp = A;

    // Clear 16-bit result
    _mul_result_lo = 0;
    _mul_result_hi = 0;

    // Process each bit of multiplier (in X)
    loop {
        // If multiplier is zero, we're done
        if X == 0 {
            break;
        }

        // Test lowest bit of multiplier
        A = X;
        A = A & 0x01;
        if A != 0 {
            // Add multiplicand to result (with carry to high byte)
            asm!("CLC");
            A = _mul_result_lo;
            A = A + _mul_temp;
            _mul_result_lo = A;
            A = _mul_result_hi;
            asm!("ADC #$00");  // Add carry
            _mul_result_hi = A;
        }

        // Shift multiplicand left (double it)
        A = _mul_temp;
        A = A << 1;
        _mul_temp = A;

        // Shift multiplier right (halve it)
        A = X;
        A = A >> 1;
        X = A;
    }

    // Return low in A, high in X
    A = _mul_result_lo;
    X = _mul_result_hi;
    return A, X;
}

// Software 8x8 -> 16 unsigned multiply (returns as u16)
// Same algorithm as mul_shift but returns result in 16-bit A register
// Uses mode switch to return 16-bit value
// Cycles: ~150-300 depending on operands
#[mode(m8, x8)]
fn mul_shift16(a @ A: u8, b @ X: u8) -> u16 {
    // Store multiplicand for shifting
    _mul_temp = A;

    // Clear 16-bit result
    _mul_result_lo = 0;
    _mul_result_hi = 0;

    // Process each bit of multiplier (in X)
    loop {
        // If multiplier is zero, we're done
        if X == 0 {
            break;
        }

        // Test lowest bit of multiplier
        A = X;
        A = A & 0x01;
        if A != 0 {
            // Add multiplicand to result (with carry to high byte)
            asm!("CLC");
            A = _mul_result_lo;
            A = A + _mul_temp;
            _mul_result_lo = A;
            A = _mul_result_hi;
            asm!("ADC #$00");  // Add carry
            _mul_result_hi = A;
        }

        // Shift multiplicand left (double it)
        A = _mul_temp;
        A = A << 1;
        _mul_temp = A;

        // Shift multiplier right (halve it)
        A = X;
        A = A >> 1;
        X = A;
    }

    // Return as 16-bit value via mode switch
    REP(0x20);
    asm!("LDA _mul_result_lo");
    SEP(0x20);
    return A;
}
