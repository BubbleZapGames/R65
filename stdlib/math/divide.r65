// Division and modulo functions
// Provides hardware and software implementations

// Hardware 16/8 -> 16 unsigned division
// Uses SNES $4204-$4206 division unit
// Returns: 16-bit quotient
// Cycles: ~30 (16 wait + overhead)
#[mode(m16)]
fn div_hw(dividend_lo @ A: u8, dividend_hi: u8, divisor @ X: u8) -> u16 {
    // Switch to 8-bit for hardware register writes
    SEP(0x20);

    // Write 16-bit dividend
    WRDIVL = A;
    A = dividend_hi;
    WRDIVH = A;

    // Write divisor (starts division)
    A = X;
    WRDIVB = A;

    // Wait 16 machine cycles for division to complete
    // REP is 3 cycles, so we need 16 - 3 = 13 more cycles
    // 6 NOPs = 12 cycles, plus the LDA below starts immediately
    REP(0x20);
    NOP(6);

    // Read 16-bit quotient directly in m16 mode
    asm!("LDA RDDIVL");
    return A;
}

// Hardware 8/8 -> 8 unsigned division (simplified)
// Extends dividend to 16-bit with zero high byte
// Returns: 8-bit quotient
#[mode(m8)]
fn div_hw_8(dividend @ A: u8, divisor @ X: u8) -> u8 {
    // Write dividend with zero high byte
    WRDIVL = A;
    A = 0;
    WRDIVH = A;

    // Write divisor
    A = X;
    WRDIVB = A;

    // Wait 16 cycles
    NOP(8);

    // Read low byte of quotient only
    A = RDDIVL;
    return A;
}

// Hardware modulo (remainder from division)
// Must be called after div_hw or div_hw_8
// Returns: remainder from last division
#[mode(m8)]
fn mod_hw_result() -> u8 {
    A = RDMPYL;
    return A;
}

// Hardware 8/8 -> 8 modulo
// Performs division and returns remainder
#[mode(m8)]
fn mod_hw(dividend @ A: u8, divisor @ X: u8) -> u8 {
    // Write dividend with zero high byte
    WRDIVL = A;
    A = 0;
    WRDIVH = A;

    // Write divisor
    A = X;
    WRDIVB = A;

    // Wait 16 cycles
    NOP(8);

    // Read remainder (low byte)
    A = RDMPYL;
    return A;
}

// Software 8/8 -> 8 unsigned division
// Uses restoring division algorithm
// Returns: quotient
// Cycles: ~200-400
#[mode(m8)]
fn div_shift(dividend @ A: u8, divisor @ X: u8) -> u8 {
    // Handle division by zero - return 0xFF (max value)
    if X == 0 {
        A = 0xFF;
        return A;
    }

    let mut _dividend: u8 = A;
    let mut _divisor: u8 = X;
    let mut _quotient: u8 = 0;
    let mut _remainder: u8 = 0;
    let mut _count: u8 = 8;

    loop {
        // Shift remainder left, bringing in high bit of dividend
        A = _remainder;
        A = A << 1;
        _remainder = A;

        // Get high bit of dividend into remainder
        A = _dividend;
        A = A & 0x80;
        if A != 0 {
            A = _remainder;
            A = A | 0x01;
            _remainder = A;
        }

        // Shift dividend left
        A = _dividend;
        A = A << 1;
        _dividend = A;

        // Shift quotient left
        A = _quotient;
        A = A << 1;
        _quotient = A;

        // Try to subtract divisor from remainder
        A = _remainder;
        if A >= _divisor {
            A = A - _divisor;
            _remainder = A;
            // Set low bit of quotient
            A = _quotient;
            A = A | 0x01;
            _quotient = A;
        }

        _count--;
        if _count == 0 {
            break;
        }
    }

    A = _quotient;
    return A;
}

// Software 8/8 -> 8 modulo
// Uses division algorithm, returns remainder
#[mode(m8)]
fn mod_shift(dividend @ A: u8, divisor @ X: u8) -> u8 {
    // Handle division by zero - return original dividend
    if X == 0 {
        return A;
    }

    let mut _dividend: u8 = A;
    let mut _divisor: u8 = X;
    let mut _remainder: u8 = 0;
    let mut _count: u8 = 8;

    loop {
        // Shift remainder left, bringing in high bit of dividend
        A = _remainder;
        A = A << 1;
        _remainder = A;

        // Get high bit of dividend into remainder
        A = _dividend;
        A = A & 0x80;
        if A != 0 {
            A = _remainder;
            A = A | 0x01;
            _remainder = A;
        }

        // Shift dividend left
        A = _dividend;
        A = A << 1;
        _dividend = A;

        // Try to subtract divisor from remainder
        A = _remainder;
        if A >= _divisor {
            A = A - _divisor;
            _remainder = A;
        }

        _count--;
        if _count == 0 {
            break;
        }
    }

    A = _remainder;
    return A;
}
